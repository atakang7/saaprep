  "level_1": {
    "title": "The Exam Decision Lenses",
    "domains": [
      {
        "name": "Security",
        "weight": "30%",
        "focus": "Protect access, encrypt data, isolate networks, and ensure compliance."
      },
      {
        "name": "Resilience",
        "weight": "26%",
        "focus": "Survive failure, ensure high availability, design DR, and scale dynamically."
      },
      {
        "name": "Performance",
        "weight": "24%",
        "focus": "Optimize speed, reduce latency, and match compute to workload."
      },
      {
        "name": "Cost",
        "weight": "20%",
        "focus": "Minimize spend without compromising required security or performance."
      }
    ]
  },
