---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllServices, getPracticeQuestions, questionMatchesService, getCanonicalServiceId, normalizeServiceId, getTopicSlug } from '../../lib/data';
import { absoluteUrl, breadcrumbJsonLd, normalizeSiteUrl, serviceDescription, sitePath } from '../../lib/seo';

export async function getStaticPaths() {
  const services = getAllServices();
  return services.map(svc => ({
    params: { service_id: svc.id },
    props: { svc }
  }));
}

const { svc } = Astro.props;
const siteUrl = normalizeSiteUrl(Astro.site);
const canonicalServiceId = svc.canonicalId || getCanonicalServiceId(svc.name);
const canonicalPath = `/services/${canonicalServiceId}`;
const description = serviceDescription(svc);
const allQuestions = getPracticeQuestions();
const verifiedClaims = Array.isArray(svc.verified_claims) ? svc.verified_claims : [];
const serviceTakeaways = [
  { label: 'Role', text: svc.job },
  { label: 'Choose', text: svc.choose_when },
  { label: 'Avoid', text: svc.avoid_when },
  { label: 'Trap', text: svc.trap_words ? `Watch for exam signals like ${svc.trap_words}.` : '' },
  ...verifiedClaims.slice(0, 3).map((claim: string) => ({ label: 'Fact', text: claim }))
].filter((item) => item.text);

// Match questions related to this service. Uses the same matcher as the
// practice arena so the CTA count and the filtered deck always agree.
const matchedQuestions = allQuestions.filter(q => questionMatchesService(q, svc.name));
const totalRelated = matchedQuestions.length;
const relatedQuestions = matchedQuestions.slice(0, 3);

// Concept themes
const conceptThemes: Record<string, { color: string; label: string }> = {
  "c1": { color: "var(--color-security)", label: "SECURITY & GUARD" },
  "c2": { color: "var(--color-network)", label: "NETWORK & TRAFFIC" },
  "c3": { color: "var(--color-compute)", label: "COMPUTE & RUN" },
  "c4": { color: "var(--color-storage)", label: "STORAGE & DATA" },
  "c5": { color: "var(--color-database)", label: "DATABASES & QUERY" },
  "c6": { color: "var(--color-decouple)", label: "DECOUPLE & OPERATE" }
};

const theme = conceptThemes[svc.concept_id] || { color: "var(--color-network)", label: svc.concept_id.toUpperCase() };

// Service specs mapping
const serviceSpecs: Record<string, { scope: string; ha: string; resilience: string }> = {
  'iam': { scope: 'Global', ha: 'Global Fault Tolerance', resilience: '99.999% SLA' },
  'vpc': { scope: 'Regional', ha: 'Multi-AZ Subnets', resilience: 'High Availability' },
  's3': { scope: 'Regional', ha: 'Min 3 AZs', resilience: '11 9s Durability' },
  'ec2': { scope: 'Single AZ / Regional', ha: 'Auto Scaling Groups', resilience: '99.99% SLA' },
  'rds': { scope: 'Regional', ha: 'Multi-AZ Replication', resilience: 'Auto Failover' },
  'dynamodb': { scope: 'Regional', ha: 'Built-in 3 AZ Replication', resilience: '99.999% SLA' },
  'lambda': { scope: 'Regional Serverless', ha: 'Multi-AZ Execution', resilience: 'Fault Tolerant' },
  'kms': { scope: 'Regional', ha: 'Multi-AZ HSMs', resilience: '99.999% SLA' }
};

const spec = serviceSpecs[canonicalServiceId] || serviceSpecs[svc.id] || { scope: 'Regional', ha: 'Multi-AZ Compatible', resilience: 'Production Grade' };
const structuredData = [
  breadcrumbJsonLd(
    [
      { name: 'AWS Services', url: '/services' },
      { name: svc.cluster_title, url: `/topics/${getTopicSlug(svc.cluster_title)}` },
      { name: svc.name, url: canonicalPath }
    ],
    siteUrl
  ),
  {
    '@context': 'https://schema.org',
    '@type': ['TechArticle', 'LearningResource'],
    headline: `${svc.name} SAA-C03 Exam Guide`,
    name: `${svc.name} SAA-C03 Exam Guide`,
    url: absoluteUrl(canonicalPath, siteUrl),
    description,
    educationalUse: 'Certification exam preparation',
    learningResourceType: 'AWS service study guide',
    proficiencyLevel: 'Intermediate',
    articleSection: svc.cluster_title,
    about: [
      {
        '@type': 'DefinedTerm',
        name: svc.name
      },
      {
        '@type': 'DefinedTerm',
        name: 'AWS Certified Solutions Architect - Associate SAA-C03'
      }
    ],
    teaches: [svc.job, svc.choose_when, svc.avoid_when, svc.trap_words],
    citation: svc.aws_reference_url
  }
];
---

<BaseLayout
  title={`${svc.name} SAA-C03 Exam Guide | SAA Prep`}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  structuredData={structuredData}
>
  <div class="clean-page">
    
    <!-- BREADCRUMB -->
    <nav class="clean-breadcrumb">
      <a href={sitePath('/services')}>Services</a>
      <span class="sep">/</span>
      <a href={sitePath(`/topics/${getTopicSlug(svc.cluster_title)}`)}>{svc.cluster_title}</a>
      <span class="sep">/</span>
      <span class="current">{svc.name}</span>
    </nav>

    <!-- HEADER -->
    <header class="clean-hero">
      <div class="hero-tags">
        <span class="pill-badge" style={`color: ${theme.color}; background: rgba(255,255,255,0.04);`}>
          {theme.label}
        </span>
        <span class="cluster-label">{svc.cluster_title}</span>
      </div>

      <h1 class="hero-title">{svc.name}</h1>
      <p class="hero-lead">{svc.job}</p>

      {svc.aws_reference_url && (
        <a href={svc.aws_reference_url} target="_blank" rel="noopener noreferrer" class="hero-reference-link">
          <span class="hero-reference-label">Official AWS Reference</span>
          <span class="hero-reference-url">{svc.aws_reference_url}</span>
          <span class="link-arrow">↗</span>
        </a>
      )}

      <!-- SPECIFICATION INLINE ROW -->
      <div class="spec-row">
        <div class="spec-col">
          <span class="spec-lbl">SCOPE</span>
          <span class="spec-val">{spec.scope}</span>
        </div>
        <div class="spec-col">
          <span class="spec-lbl">HIGH AVAILABILITY</span>
          <span class="spec-val">{spec.ha}</span>
        </div>
        <div class="spec-col">
          <span class="spec-lbl">RESILIENCE</span>
          <span class="spec-val" style={`color: ${theme.color};`}>{spec.resilience}</span>
        </div>
      </div>
    </header>

    <!-- DECISION MATRIX -->
    <section class="content-block">
      <h2 class="block-heading">// DECISION LOGIC MATRIX</h2>

      <div class="decision-dual">
        <div class="decision-column choose-col">
          <div class="column-header">
            <span class="col-icon">✓</span>
            <h3>When to Choose</h3>
          </div>
          <p>{svc.choose_when}</p>
        </div>

        <div class="decision-column avoid-col">
          <div class="column-header">
            <span class="col-icon">✕</span>
            <h3>When to Avoid</h3>
          </div>
          <p>{svc.avoid_when}</p>
        </div>
      </div>
    </section>

    <!-- EXAM TRAPS & MISDIRECTIONS -->
    <section class="content-block">
      <h2 class="block-heading">// EXAM TRAPS & SIGNAL KEYWORDS</h2>
      
      <div class="trap-panel">
        <div class="code-keywords">{svc.trap_words}</div>
      </div>
    </section>

    <!-- OFFICIAL AWS REFERENCE -->
    <section class="content-block">
      <h2 class="block-heading">// OFFICIAL AWS REFERENCE</h2>
      <div class="aws-reference-box">
        {svc.aws_reference_url && (
          <a href={svc.aws_reference_url} target="_blank" rel="noopener noreferrer" class="aws-link">
            <span class="aws-icon">AWS</span>
            <span class="aws-url">{svc.aws_reference_url}</span>
            <span class="link-arrow">↗</span>
          </a>
        )}
        {svc.aws_official_description && (
          <p class="aws-desc">"{svc.aws_official_description}"</p>
        )}

        {svc.verified_claims && svc.verified_claims.length > 0 && (
          <ul class="verified-facts">
            {svc.verified_claims.map((claim: string) => (
              <li>{claim}</li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <!-- SERVICE-SCOPED TAKEAWAYS -->
    {serviceTakeaways.length > 0 && (
      <section class="content-block">
        <h2 class="block-heading">// {svc.name.toUpperCase()} TAKEAWAYS</h2>

        <div class="facts-list">
          {serviceTakeaways.map((takeaway, idx: number) => (
            <div class="fact-row">
              <span class="num">0{idx + 1}</span>
              <p><strong>{takeaway.label}:</strong> {takeaway.text}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- RELATED PRACTICE QUESTIONS -->
    {relatedQuestions.length > 0 && (
      <section class="content-block">
        <h2 class="block-heading">// PRACTICE QUESTIONS</h2>
        <div class="questions-stack">
          {relatedQuestions.map(q => (
            <a href={sitePath(`/practice?q=${q.id}`)} class="q-link">
              <div class="q-num">QUESTION #{q.id}</div>
              <div class="q-body">{q.question}</div>
              <div class="q-action">Solve Question →</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- CTA -->
    {relatedQuestions.length > 0 && (
      <div class="bottom-action">
        <div>
          <h3>Ready to test your {svc.name} knowledge?</h3>
          <p>
            {totalRelated} practice {totalRelated === 1 ? 'question covers' : 'questions cover'} {svc.name}.
          </p>
        </div>
        <a href={sitePath(`/practice?service=${svc.id}`)} class="btn-action" style={`background: ${theme.color};`}>Start Practice →</a>
      </div>
    )}

  </div>
</BaseLayout>

<style>
  .clean-page {
    max-width: 920px;
    margin: 0 auto;
    padding: 1rem 0 4rem;
  }

  .clean-breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }

  .clean-breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
  }

  .clean-breadcrumb .sep {
    color: var(--text-muted);
  }

  .clean-breadcrumb .current {
    color: var(--text-primary);
    font-weight: 700;
  }

  /* HERO */
  .clean-hero {
    margin-bottom: 3.5rem;
  }

  .hero-tags {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .pill-badge {
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
  }

  .cluster-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .hero-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .hero-reference-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 100%;
    margin-bottom: 2rem;
    padding: 0.55rem 0.75rem;
    background: rgba(255, 153, 0, 0.08);
    border: 1px solid rgba(255, 153, 0, 0.55);
    border-left: 3px solid #ff9900;
    color: var(--text-primary);
    text-decoration: none;
  }

  .hero-reference-label {
    flex-shrink: 0;
    color: #ff9900;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  .hero-reference-url {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .hero-reference-link:hover {
    border-color: #ff9900;
    background: rgba(255, 153, 0, 0.12);
  }

  @media (max-width: 768px) {
    .hero-reference-link {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .hero-reference-url {
      white-space: normal;
      word-break: break-all;
    }
  }

  .spec-row {
    display: flex;
    gap: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .spec-col {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .spec-lbl {
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--text-muted);
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
  }

  .spec-val {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  /* CONTENT BLOCKS */
  .content-block {
    margin-bottom: 3.5rem;
  }

  .block-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .block-heading {
    font-size: 1.25rem;
    font-weight: 900;
    font-family: var(--font-mono);
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .mono-badge {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  /* DECISION DUAL */
  .decision-dual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .decision-dual {
      grid-template-columns: 1fr;
    }
  }

  .decision-column {
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
  }

  .column-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .col-icon {
    font-size: 1.1rem;
    font-weight: 900;
  }

  .choose-col .col-icon, .choose-col h3 { color: var(--color-database); }
  .avoid-col .col-icon, .avoid-col h3 { color: var(--color-security); }

  .column-header h3 {
    font-size: 1.15rem;
    font-weight: 800;
  }

  .decision-column p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* TRAP PANEL */
  .trap-panel {
    background: rgba(255, 255, 255, 0.02);
    padding: 1.5rem;
    border: 1px solid var(--border-subtle);
  }

  .code-keywords {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-storage);
    margin-bottom: 1.25rem;
    background: rgba(0, 0, 0, 0.4);
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-subtle);
  }

  .clean-list {
    list-style: none;
    padding-left: 0;
  }

  .clean-list li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .clean-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--text-muted);
    font-weight: bold;
  }

  /* FACTS */
  .facts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .fact-row {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .fact-row .num {
    font-size: 1rem;
    font-weight: 900;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .fact-row p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .fact-row strong {
    color: var(--text-primary);
  }

  /* QUESTIONS STACK */
  .questions-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .q-link {
    display: block;
    background: rgba(255, 255, 255, 0.02);
    padding: 1.25rem;
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    color: inherit;
  }

  .q-num {
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--color-compute);
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
  }

  .q-body {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }

  .q-action {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-compute);
    font-family: var(--font-mono);
  }

  /* BOTTOM ACTION */
  .bottom-action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .bottom-action {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .bottom-action h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .bottom-action p {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .btn-action {
    padding: 0.75rem 1.5rem;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    font-family: var(--font-mono);
  }

  /* AWS REFERENCE */
  .aws-reference-box {
    background: rgba(255, 153, 0, 0.05); /* AWS Orange tint */
    border: 1px solid #ff9900;
    border-left: 4px solid #ff9900;
    padding: 1.5rem;
  }
  
  .aws-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    margin-bottom: 0.75rem;
    width: fit-content;
  }
  
  .aws-icon {
    background: #ff9900;
    color: #232f3e; /* AWS dark blue */
    font-size: 0.7rem;
    font-weight: 900;
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
  }
  
  .aws-url {
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.2);
    text-underline-offset: 4px;
  }
  
  .aws-link:hover .aws-url {
    text-decoration-color: #ff9900;
  }
  
  .aws-desc {
    font-style: italic;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .verified-facts {
    list-style: none;
    margin: 1rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .verified-facts li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .verified-facts li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-database);
  }

</style>
