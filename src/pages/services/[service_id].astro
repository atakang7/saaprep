---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllServices, getPracticeQuestions } from '../../lib/data';

export async function getStaticPaths() {
  const services = getAllServices();
  return services.map(svc => ({
    params: { service_id: svc.id },
    props: { svc }
  }));
}

const { svc } = Astro.props;
const allQuestions = getPracticeQuestions();

// Match questions related to this service
const relatedQuestions = allQuestions.filter(q => 
  q.question.toLowerCase().includes(svc.name.toLowerCase()) || 
  q.explanation.some(e => e.toLowerCase().includes(svc.name.toLowerCase()))
).slice(0, 3);

// Concept themes
const conceptThemes: Record<string, { color: string; label: string; icon: string }> = {
  "c1": { color: "var(--color-security)", label: "SECURITY & GUARD", icon: "🛡️" },
  "c2": { color: "var(--color-network)", label: "NETWORK & TRAFFIC", icon: "🌐" },
  "c3": { color: "var(--color-compute)", label: "COMPUTE & RUN", icon: "⚡" },
  "c4": { color: "var(--color-storage)", label: "STORAGE & DATA", icon: "📦" },
  "c5": { color: "var(--color-database)", label: "DATABASES & QUERY", icon: "🗄️" },
  "c6": { color: "var(--color-decouple)", label: "DECOUPLE & OPERATE", icon: "🔄" }
};

const theme = conceptThemes[svc.concept_id] || { color: "var(--color-network)", label: svc.concept_id.toUpperCase(), icon: "✦" };

// Service specs mapping
const serviceSpecs: Record<string, { scope: string; ha: string; resilience: string }> = {
  'iam': { scope: 'Global', ha: 'Built-in Global Fault Tolerance', resilience: '99.999% SLA' },
  'vpc': { scope: 'Regional', ha: 'Multi-AZ Subnets', resilience: 'High Availability' },
  'amazon-s3': { scope: 'Regional Container (Global Namespace)', ha: 'Minimum 3 Availability Zones', resilience: '99.999999999% (11 9s) Durability' },
  'amazon-ec2': { scope: 'Regional / Single AZ Instance', ha: 'Multi-AZ Auto Scaling Groups', resilience: '99.99% SLA for ASG' },
  'amazon-rds': { scope: 'Regional', ha: 'Multi-AZ Synchronous Replication', resilience: 'Automatic Failover' },
  'amazon-dynamodb': { scope: 'Regional (Global Tables option)', ha: 'Built-in 3 AZ Replication', resilience: 'Serverless 99.999% SLA' },
  'aws-lambda': { scope: 'Regional Serverless', ha: 'Multi-AZ Automatic Execution', resilience: 'Fault-tolerant by default' },
  'aws-kms': { scope: 'Regional', ha: 'Multi-AZ Hardware Security Modules', resilience: '99.999% Availability' }
};

const spec = serviceSpecs[svc.id] || { scope: 'Regional Service', ha: 'Multi-AZ Compatible', resilience: 'Production Grade SLA' };
---

<BaseLayout title={`${svc.name} - Deep Dive & SAA-C03 Blueprint`}>
  <div class="svc-page-wrapper">
    
    <!-- TOP BREADCRUMB NAV -->
    <nav class="svc-breadcrumb">
      <a href="/services">← All Services</a>
      <span class="sep">/</span>
      <a href={`/topics/${svc.cluster_id}`}>{svc.cluster_title}</a>
      <span class="sep">/</span>
      <span class="current">{svc.name}</span>
    </nav>

    <!-- HERO SECTION -->
    <header class="svc-hero glass-card" style={`border-top: 4px solid ${theme.color};`}>
      <div class="hero-top">
        <span class="svc-icon-badge" style={`color: ${theme.color}; background: rgba(255,255,255,0.04); border-color: ${theme.color};`}>
          {theme.icon}
        </span>
        <div class="hero-meta">
          <span class="category-chip" style={`border-color: ${theme.color}; color: ${theme.color};`}>
            {theme.label}
          </span>
          <span class="cluster-chip">{svc.cluster_title}</span>
        </div>
      </div>

      <h1 class="svc-title">{svc.name}</h1>
      <p class="svc-job-lead">{svc.job}</p>

      <!-- SPECIFICATION BADGES -->
      <div class="spec-grid">
        <div class="spec-item">
          <span class="spec-label">AWS SCOPE</span>
          <span class="spec-val">{spec.scope}</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">HIGH AVAILABILITY</span>
          <span class="spec-val">{spec.ha}</span>
        </div>
        <div class="spec-item">
          <span class="spec-label">DURABILITY / SLA</span>
          <span class="spec-val" style={`color: ${theme.color};`}>{spec.resilience}</span>
        </div>
      </div>
    </header>

    <!-- DECISION MATRIX (WHEN TO CHOOSE VS AVOID) -->
    <section class="svc-section">
      <h2 class="section-title">
        <span class="accent-bar" style={`background: ${theme.color};`}></span>
        Architectural Decision Matrix
      </h2>

      <div class="matrix-grid">
        <!-- CHOOSE CARD -->
        <div class="matrix-card choose-box glass-card">
          <div class="matrix-header">
            <span class="matrix-icon">✓</span>
            <div>
              <h3>When to Choose</h3>
              <span class="sub">Architectural Match Criteria</span>
            </div>
          </div>
          <p class="matrix-text">{svc.choose_when}</p>
        </div>

        <!-- AVOID CARD -->
        <div class="matrix-card avoid-box glass-card">
          <div class="matrix-header">
            <span class="matrix-icon">✕</span>
            <div>
              <h3>When to Avoid</h3>
              <span class="sub">Anti-Pattern & Alternatives</span>
            </div>
          </div>
          <p class="matrix-text">{svc.avoid_when}</p>
        </div>
      </div>
    </section>

    <!-- EXAM TRAPS & DISTRACTORS -->
    <section class="svc-section">
      <h2 class="section-title">
        <span class="accent-bar" style="background: var(--color-storage);"></span>
        SAA-C03 Exam Traps & Misdirections
      </h2>

      <div class="trap-banner glass-card">
        <div class="trap-badge">
          <span>⚠️ EXAM DISTRACTORS</span>
        </div>
        <div class="trap-content">
          <p class="trap-keywords">{svc.trap_words}</p>
          <ul class="trap-rules">
            <li>Beware of options mentioning long-term access keys when an <strong>IAM Role / Instance Profile</strong> is available.</li>
            <li>Look out for choices that require custom scripts when AWS provides a <strong>native managed feature</strong>.</li>
            <li>Always check for the phrase <em>"least operational overhead"</em> or <em>"most cost-effective"</em> to eliminate complex multi-component answers.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- RAPID FIRE CHEATSHEET -->
    <section class="svc-section">
      <h2 class="section-title">
        <span class="accent-bar" style={`background: ${theme.color};`}></span>
        Non-Negotiable Exam Facts
      </h2>

      <div class="facts-card glass-card">
        <div class="facts-grid">
          <div class="fact-item">
            <span class="fact-num">01</span>
            <div class="fact-text">
              <strong>Identity vs Resource Policies:</strong> Identity policies attach to IAM principles. Resource policies (like S3 Bucket Policies) attach directly to resources to allow cross-account access without role assumption.
            </div>
          </div>
          <div class="fact-item">
            <span class="fact-num">02</span>
            <div class="fact-text">
              <strong>High Availability Baseline:</strong> Deploy across at least 2 Availability Zones (Multi-AZ) to achieve fault tolerance for production workloads.
            </div>
          </div>
          <div class="fact-item">
            <span class="fact-num">03</span>
            <div class="fact-text">
              <strong>Encryption Standard:</strong> KMS Customer Managed Keys (CMK) provide key rotation and auditing, while AWS Managed Keys offer zero-overhead default encryption.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- RELATED PRACTICE QUESTIONS -->
    {relatedQuestions.length > 0 && (
      <section class="svc-section">
        <h2 class="section-title">
          <span class="accent-bar" style="background: var(--color-compute);"></span>
          Related SAA-C03 Exam Questions
        </h2>

        <div class="questions-list">
          {relatedQuestions.map(q => (
            <a href={`/practice?q=${q.id}`} class="question-preview-card glass-card">
              <div class="q-header">
                <span class="q-badge">QUESTION #{q.id}</span>
              </div>
              <p class="q-text">{q.question}</p>
              <div class="q-cta">Solve in Practice Arena →</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- BOTTOM CTA -->
    <div class="bottom-cta-banner glass-card" style={`border-color: ${theme.color};`}>
      <div>
        <h3>Ready to test your {svc.name} knowledge?</h3>
        <p>Jump directly into real SAA-C03 practice questions.</p>
      </div>
      <a href="/practice" class="btn-primary" style={`background: ${theme.color};`}>Launch Practice Arena →</a>
    </div>

  </div>
</BaseLayout>

<style>
  .svc-page-wrapper {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem 1rem 5rem;
  }

  .svc-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .svc-breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
  }

  .svc-breadcrumb a:hover {
    color: var(--text-primary);
  }

  .svc-breadcrumb .sep {
    color: var(--text-muted);
  }

  .svc-breadcrumb .current {
    color: var(--text-primary);
    font-weight: 700;
  }

  /* HERO */
  .svc-hero {
    padding: 2.5rem;
    margin-bottom: 3rem;
    border-radius: 16px;
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .svc-icon-badge {
    font-size: 1.75rem;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border: 1px solid;
  }

  .hero-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .category-chip {
    font-size: 0.7rem;
    font-weight: 900;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    border: 1px solid;
    letter-spacing: 0.05em;
  }

  .cluster-chip {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .svc-title {
    font-size: 3.25rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .svc-job-lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 800px;
  }

  /* SPEC GRID */
  .spec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .spec-label {
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .spec-val {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  /* SECTIONS */
  .svc-section {
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .accent-bar {
    width: 4px;
    height: 24px;
    border-radius: 2px;
  }

  /* MATRIX GRID */
  .matrix-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .matrix-grid {
      grid-template-columns: 1fr;
    }
  }

  .matrix-card {
    padding: 2rem;
    border-top-width: 4px;
  }

  .choose-box {
    border-top-color: var(--color-database);
    background: linear-gradient(180deg, rgba(52, 211, 153, 0.04) 0%, transparent 100%);
  }

  .avoid-box {
    border-top-color: var(--color-security);
    background: linear-gradient(180deg, rgba(244, 63, 94, 0.04) 0%, transparent 100%);
  }

  .matrix-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .matrix-icon {
    font-size: 1.5rem;
    font-weight: 900;
  }

  .choose-box .matrix-icon, .choose-box h3 { color: var(--color-database); }
  .avoid-box .matrix-icon, .avoid-box h3 { color: var(--color-security); }

  .matrix-header h3 {
    font-size: 1.35rem;
    font-weight: 800;
  }

  .matrix-header .sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: block;
  }

  .matrix-text {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* TRAP BANNER */
  .trap-banner {
    padding: 2rem;
    border-left: 4px solid var(--color-storage);
    background: linear-gradient(90deg, rgba(251, 191, 36, 0.05) 0%, transparent 100%);
  }

  .trap-badge {
    margin-bottom: 1rem;
  }

  .trap-badge span {
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--color-storage);
    letter-spacing: 0.05em;
  }

  .trap-keywords {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--text-primary);
    background: rgba(0, 0, 0, 0.4);
    padding: 0.85rem 1.25rem;
    border-radius: 8px;
    border: 1px solid rgba(251, 191, 36, 0.2);
    margin-bottom: 1.25rem;
  }

  .trap-rules {
    list-style: none;
    padding-left: 0;
  }

  .trap-rules li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .trap-rules li::before {
    content: '⚡';
    position: absolute;
    left: 0;
    font-size: 0.85rem;
  }

  /* FACTS CARD */
  .facts-card {
    padding: 2rem;
  }

  .facts-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .fact-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .fact-num {
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .fact-text {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .fact-text strong {
    color: var(--text-primary);
  }

  /* QUESTIONS PREVIEW */
  .questions-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .question-preview-card {
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, border-color 0.2s;
  }

  .question-preview-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-compute);
  }

  .q-header {
    margin-bottom: 0.5rem;
  }

  .q-badge {
    font-size: 0.7rem;
    font-weight: 900;
    color: var(--color-compute);
    letter-spacing: 0.05em;
  }

  .q-text {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .q-cta {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--color-compute);
  }

  /* BOTTOM CTA */
  .bottom-cta-banner {
    padding: 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-width: 2px;
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .bottom-cta-banner {
      flex-direction: column;
      text-align: center;
    }
  }

  .bottom-cta-banner h3 {
    font-size: 1.5rem;
    font-weight: 900;
    margin-bottom: 0.35rem;
  }

  .bottom-cta-banner p {
    color: var(--text-secondary);
  }

  .btn-primary {
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s, opacity 0.15s;
  }

  .btn-primary:hover {
    transform: scale(1.03);
    opacity: 0.95;
  }
</style>
