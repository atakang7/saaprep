---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllServices, getPracticeQuestions } from '../../lib/data';

export async function getStaticPaths() {
  const services = getAllServices();
  return services.map(svc => ({
    params: { service_id: svc.id },
    props: { svc }
  }));
}

const { svc } = Astro.props;
const allQuestions = getPracticeQuestions();

// Match questions related to this service
const relatedQuestions = allQuestions.filter(q => 
  q.question.toLowerCase().includes(svc.name.toLowerCase()) || 
  q.explanation.some(e => e.toLowerCase().includes(svc.name.toLowerCase()))
).slice(0, 3);

// Concept themes
const conceptThemes: Record<string, { color: string; label: string }> = {
  "c1": { color: "var(--color-security)", label: "SECURITY & GUARD" },
  "c2": { color: "var(--color-network)", label: "NETWORK & TRAFFIC" },
  "c3": { color: "var(--color-compute)", label: "COMPUTE & RUN" },
  "c4": { color: "var(--color-storage)", label: "STORAGE & DATA" },
  "c5": { color: "var(--color-database)", label: "DATABASES & QUERY" },
  "c6": { color: "var(--color-decouple)", label: "DECOUPLE & OPERATE" }
};

const theme = conceptThemes[svc.concept_id] || { color: "var(--color-network)", label: svc.concept_id.toUpperCase() };

// Service specs mapping
const serviceSpecs: Record<string, { scope: string; ha: string; resilience: string }> = {
  'iam': { scope: 'Global', ha: 'Global Fault Tolerance', resilience: '99.999% SLA' },
  'vpc': { scope: 'Regional', ha: 'Multi-AZ Subnets', resilience: 'High Availability' },
  'amazon-s3': { scope: 'Regional', ha: 'Min 3 AZs', resilience: '11 9s Durability' },
  'amazon-ec2': { scope: 'Single AZ / Regional', ha: 'Auto Scaling Groups', resilience: '99.99% SLA' },
  'amazon-rds': { scope: 'Regional', ha: 'Multi-AZ Replication', resilience: 'Auto Failover' },
  'amazon-dynamodb': { scope: 'Regional', ha: 'Built-in 3 AZ Replication', resilience: '99.999% SLA' },
  'aws-lambda': { scope: 'Regional Serverless', ha: 'Multi-AZ Execution', resilience: 'Fault Tolerant' },
  'aws-kms': { scope: 'Regional', ha: 'Multi-AZ HSMs', resilience: '99.999% SLA' }
};

const spec = serviceSpecs[svc.id] || { scope: 'Regional', ha: 'Multi-AZ Compatible', resilience: 'Production Grade' };
---

<BaseLayout title={`${svc.name} - Deep Dive & SAA-C03 Blueprint`}>
  <div class="clean-page">
    
    <!-- BREADCRUMB -->
    <nav class="clean-breadcrumb">
      <a href="/services">Services</a>
      <span class="sep">/</span>
      <a href={`/topics/${svc.cluster_id}`}>{svc.cluster_title}</a>
      <span class="sep">/</span>
      <span class="current">{svc.name}</span>
    </nav>

    <!-- HEADER -->
    <header class="clean-hero">
      <div class="hero-tags">
        <span class="pill-badge" style={`color: ${theme.color}; background: rgba(255,255,255,0.04);`}>
          {theme.label}
        </span>
        <span class="cluster-label">{svc.cluster_title}</span>
      </div>

      <h1 class="hero-title">{svc.name}</h1>
      <p class="hero-lead">{svc.job}</p>

      <!-- SPECIFICATION INLINE ROW -->
      <div class="spec-row">
        <div class="spec-col">
          <span class="spec-lbl">SCOPE</span>
          <span class="spec-val">{spec.scope}</span>
        </div>
        <div class="spec-col">
          <span class="spec-lbl">HIGH AVAILABILITY</span>
          <span class="spec-val">{spec.ha}</span>
        </div>
        <div class="spec-col">
          <span class="spec-lbl">RESILIENCE</span>
          <span class="spec-val" style={`color: ${theme.color};`}>{spec.resilience}</span>
        </div>
      </div>
    </header>

    <!-- DECISION MATRIX -->
    <section class="content-block">
      <h2 class="block-heading">Decision Logic</h2>

      <div class="decision-dual">
        <div class="decision-column choose-col">
          <div class="column-header">
            <span class="col-icon">✓</span>
            <h3>When to Choose</h3>
          </div>
          <p>{svc.choose_when}</p>
        </div>

        <div class="decision-column avoid-col">
          <div class="column-header">
            <span class="col-icon">✕</span>
            <h3>When to Avoid</h3>
          </div>
          <p>{svc.avoid_when}</p>
        </div>
      </div>
    </section>

    <!-- EXAM TRAPS & MISDIRECTIONS -->
    <section class="content-block">
      <h2 class="block-heading">Exam Traps & Signal Keywords</h2>
      
      <div class="trap-panel">
        <div class="code-keywords">{svc.trap_words}</div>
        <ul class="clean-list">
          <li>Watch out for choices specifying static access credentials when IAM Roles or STS temporary credentials apply.</li>
          <li>Eliminate complex custom-scripted solutions when AWS provides a managed zero-maintenance feature.</li>
          <li>Look for key indicators like <em>"least operational overhead"</em> or <em>"most cost-effective"</em> to narrow down options.</li>
        </ul>
      </div>
    </section>

    <!-- NON-NEGOTIABLE FACTS -->
    <section class="content-block">
      <h2 class="block-heading">Core SAA-C03 Takeaways</h2>

      <div class="facts-list">
        <div class="fact-row">
          <span class="num">01</span>
          <p><strong>Permissions & Policies:</strong> Resource-based policies allow cross-account access without assuming IAM roles directly.</p>
        </div>
        <div class="fact-row">
          <span class="num">02</span>
          <p><strong>High Availability:</strong> Deploy across minimum 2-3 Availability Zones to ensure zero single point of failure.</p>
        </div>
        <div class="fact-row">
          <span class="num">03</span>
          <p><strong>Security Defaults:</strong> KMS Customer Managed Keys allow rotation tracking, whereas AWS Managed Keys provide effortless default encryption.</p>
        </div>
      </div>
    </section>

    <!-- RELATED PRACTICE QUESTIONS -->
    {relatedQuestions.length > 0 && (
      <section class="content-block">
        <h2 class="block-heading">Practice Questions</h2>
        <div class="questions-stack">
          {relatedQuestions.map(q => (
            <a href={`/practice?q=${q.id}`} class="q-link">
              <div class="q-num">QUESTION #{q.id}</div>
              <div class="q-body">{q.question}</div>
              <div class="q-action">Solve Question →</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- CTA -->
    <div class="bottom-action">
      <div>
        <h3>Ready to test your {svc.name} knowledge?</h3>
        <p>Launch the interactive practice simulator now.</p>
      </div>
      <a href="/practice" class="btn-action" style={`background: ${theme.color};`}>Start Practice →</a>
    </div>

  </div>
</BaseLayout>

<style>
  .clean-page {
    max-width: 860px;
    margin: 0 auto;
    padding: 1rem 0 4rem;
  }

  .clean-breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }

  .clean-breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
  }

  .clean-breadcrumb a:hover {
    color: var(--text-primary);
  }

  .clean-breadcrumb .sep {
    color: var(--text-muted);
  }

  .clean-breadcrumb .current {
    color: var(--text-primary);
    font-weight: 700;
  }

  /* HERO */
  .clean-hero {
    margin-bottom: 3.5rem;
  }

  .hero-tags {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .pill-badge {
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .cluster-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .hero-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .spec-row {
    display: flex;
    gap: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .spec-col {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .spec-lbl {
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .spec-val {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  /* CONTENT BLOCKS */
  .content-block {
    margin-bottom: 3.5rem;
  }

  .block-heading {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  /* DECISION DUAL */
  .decision-dual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .decision-dual {
      grid-template-columns: 1fr;
    }
  }

  .decision-column {
    padding: 1.5rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
  }

  .column-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .col-icon {
    font-size: 1.1rem;
    font-weight: 900;
  }

  .choose-col .col-icon, .choose-col h3 { color: var(--color-database); }
  .avoid-col .col-icon, .avoid-col h3 { color: var(--color-security); }

  .column-header h3 {
    font-size: 1.15rem;
    font-weight: 800;
  }

  .decision-column p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* TRAP PANEL */
  .trap-panel {
    background: rgba(255, 255, 255, 0.02);
    padding: 1.5rem;
    border-radius: 12px;
  }

  .code-keywords {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-storage);
    margin-bottom: 1.25rem;
    background: rgba(0, 0, 0, 0.3);
    padding: 0.75rem 1rem;
    border-radius: 6px;
  }

  .clean-list {
    list-style: none;
    padding-left: 0;
  }

  .clean-list li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .clean-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--text-muted);
    font-weight: bold;
  }

  /* FACTS */
  .facts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .fact-row {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .fact-row .num {
    font-size: 1rem;
    font-weight: 900;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .fact-row p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .fact-row strong {
    color: var(--text-primary);
  }

  /* QUESTIONS STACK */
  .questions-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .q-link {
    display: block;
    background: rgba(255, 255, 255, 0.02);
    padding: 1.25rem;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }

  .q-link:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .q-num {
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--color-compute);
    margin-bottom: 0.35rem;
  }

  .q-body {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    line-height: 1.5;
  }

  .q-action {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-compute);
  }

  /* BOTTOM ACTION */
  .bottom-action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .bottom-action {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .bottom-action h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .bottom-action p {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .btn-action {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s;
  }

  .btn-action:hover {
    opacity: 0.9;
  }
</style>
