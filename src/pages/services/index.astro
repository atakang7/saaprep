---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTaxonomyTree, getAllServices } from '../../lib/data';

const services = getAllServices();
const taxonomy = getTaxonomyTree();
const concepts = taxonomy.level_2_and_3.concepts;

// Concept Themes
const conceptThemes: Record<string, { color: string; label: string; bg: string }> = {
  "c1": { color: "#ff2a70", label: "SECURITY, GUARD & IDENTITY PIPELINE", bg: "rgba(255, 42, 112, 0.05)" },
  "c2": { color: "#00e5ff", label: "NETWORK, TRAFFIC & INGRESS PIPELINE", bg: "rgba(0, 229, 255, 0.05)" },
  "c3": { color: "#a855f7", label: "COMPUTE & WORKLOAD EXECUTION PIPELINE", bg: "rgba(168, 85, 247, 0.05)" },
  "c4": { color: "#f59e0b", label: "STORAGE & PERSISTENCE PIPELINE", bg: "rgba(245, 158, 11, 0.05)" },
  "c5": { color: "#10b981", label: "DATABASE & ANALYTICS DATA PIPELINE", bg: "rgba(16, 185, 129, 0.05)" },
  "c6": { color: "#ec4899", label: "DECOUPLING & ASYNC EVENT PIPELINE", bg: "rgba(236, 72, 153, 0.05)" }
};
---

<BaseLayout title="AWS Service Architecture Directory | SAA-C03">
  <div class="services-diagram-container">
    
    <!-- HEADER -->
    <header class="index-header">
      <div class="header-tag">[GRAPHICAL ARCHITECTURE FLOW DIRECTORY]</div>
      <h1 class="index-title">// AWS SERVICE FLOW MAPS</h1>
      <p class="index-sub">Visual architectural pipelines & node flowcharts mapped to SAA-C03 exam taxonomy.</p>
    </header>

    <!-- DIAGRAM FLOW PIPELINES BY CONCEPT -->
    <div class="pipelines-stack">
      {concepts.map((concept: any, conceptIdx: number) => {
        const theme = conceptThemes[concept.id] || { color: "#00e5ff", label: concept.name.toUpperCase(), bg: "rgba(0,229,255,0.05)" };

        return (
          <section class="pipeline-card-box" style={`border-left: 4px solid ${theme.color};`}>
            
            <!-- PIPELINE HEADER -->
            <div class="pipeline-header-bar" style={`background: ${theme.bg};`}>
              <div class="ph-left">
                <span class="ph-badge-num">0{conceptIdx + 1}</span>
                <h2 class="ph-title-text" style={`color: ${theme.color};`}>{theme.label}</h2>
              </div>
              <span class="ph-tag-mono">[VISUAL PIPELINE MAP]</span>
            </div>

            <!-- GRAPHICAL CANVAS BODY -->
            <div class="pipeline-canvas-body">
              {concept.clusters.map((cluster: any, clusterIdx: number) => (
                <div class="cluster-stage-group">
                  <div class="stage-label-heading">
                    <span class="stage-pill" style={`background: ${theme.color}; color: #000;`}>STAGE 0{clusterIdx + 1}</span>
                    <span class="stage-name-text">{cluster.name}</span>
                  </div>

                  <!-- GRAPHICAL VISUAL NODES GRID -->
                  <div class="nodes-visual-grid">
                    {cluster.services.map((svcName: string, svcIdx: number) => {
                      const svcId = svcName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
                      return (
                        <div class="node-card-wrapper">
                          <a href={`/services/${svcId}`} class="visual-node-card">
                            <div class="vnc-top">
                              <span class="vnc-step">NODE 0{svcIdx + 1}</span>
                              <span class="vnc-aws" style={`color: ${theme.color};`}>AWS SERVICE</span>
                            </div>
                            <div class="vnc-title">{svcName}</div>
                            <div class="vnc-btn" style={`color: ${theme.color};`}>View Blueprint ➔</div>
                          </a>

                          {svcIdx < cluster.services.length - 1 && (
                            <div class="visual-arrow-connector">
                              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke={theme.color} stroke-width="2.5" stroke-linecap="square"/>
                              </svg>
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </div>

                  {clusterIdx < concept.clusters.length - 1 && (
                    <div class="stage-divider-arrow">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M12 5V19M12 19L6 13M12 19L18 13" stroke={theme.color} stroke-width="2.5" stroke-linecap="square"/>
                      </svg>
                    </div>
                  )}

                </div>
              ))}
            </div>

          </section>
        );
      })}
    </div>

  </div>
</BaseLayout>

<style>
  .services-diagram-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 0 5rem;
  }

  .index-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.5rem;
  }

  .header-tag {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    font-weight: 900;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .index-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .index-sub {
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .pipelines-stack {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* PIPELINE CARD BOX */
  .pipeline-card-box {
    background: #0b0d14;
    border: 1px solid #232736;
    display: flex;
    flex-direction: column;
  }

  .pipeline-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #232736;
  }

  .ph-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ph-badge-num {
    font-size: 0.9rem;
    font-family: var(--font-mono);
    font-weight: 900;
    color: var(--text-muted);
  }

  .ph-title-text {
    font-size: 1rem;
    font-family: var(--font-mono);
    font-weight: 900;
    margin: 0;
  }

  .ph-tag-mono {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .pipeline-canvas-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .cluster-stage-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stage-label-heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .stage-pill {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    font-weight: 900;
    padding: 0.2rem 0.5rem;
  }

  .stage-name-text {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  /* VISUAL NODES GRID */
  .nodes-visual-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .node-card-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .visual-node-card {
    background: #141722;
    border: 1px solid #2e3448;
    padding: 1.25rem;
    min-width: 200px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .vnc-top {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .vnc-step {
    color: var(--text-muted);
    font-weight: 900;
  }

  .vnc-aws {
    font-weight: 900;
  }

  .vnc-title {
    font-size: 1.2rem;
    font-weight: 900;
    color: #ffffff;
  }

  .vnc-btn {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    font-weight: 800;
    margin-top: 0.25rem;
  }

  .visual-arrow-connector {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stage-divider-arrow {
    display: flex;
    justify-content: center;
    padding: 0.5rem 0;
  }
</style>
