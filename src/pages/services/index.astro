---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTaxonomyTree, getAllServices, getCanonicalServiceId, getTaxonomyEntryHref, normalizeServiceId } from '../../lib/data';
import { absoluteUrl, normalizeSiteUrl, sitePath } from '../../lib/seo';

const services = getAllServices();
const taxonomy = getTaxonomyTree();
const concepts = taxonomy.level_2_and_3.concepts;
const siteUrl = normalizeSiteUrl(Astro.site);
const serviceCount = new Set(services.map((service: any) => normalizeServiceId(service.name))).size;
const description = `Explore ${serviceCount} AWS services for the SAA-C03 exam with decision rules, service comparisons, architecture roles, and exam trap signals.`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AWS Services for SAA-C03 Exam Prep',
  description,
  url: absoluteUrl('/services', siteUrl),
  itemListElement: services
    .filter((service: any, index: number, all: any[]) =>
      all.findIndex((candidate: any) => normalizeServiceId(candidate.name) === normalizeServiceId(service.name)) === index
    )
    .map((service: any, index: number) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: service.name,
      url: absoluteUrl(`/services/${getCanonicalServiceId(service.name)}/`, siteUrl)
    }))
};

// Concept Themes with visual boundary colors
const conceptThemes: Record<string, { color: string; label: string; tag: string; icon: string }> = {
  "c1": { color: "#ff2a70", label: "SECURITY, ACCESS & IDENTITY BOUNDARY", tag: "SECURITY TIER", icon: "🛡️" },
  "c2": { color: "#00e5ff", label: "NETWORK, TRAFFIC & INGRESS EDGE ZONE", tag: "NETWORKING TIER", icon: "⚡" },
  "c3": { color: "#a855f7", label: "COMPUTE & WORKLOAD EXECUTION REGION", tag: "COMPUTE TIER", icon: "⚙️" },
  "c4": { color: "#f59e0b", label: "STORAGE & DATA PERSISTENCE TIER", tag: "STORAGE TIER", icon: "📦" },
  "c5": { color: "#10b981", label: "DATABASE & ANALYTICS CLUSTER ZONE", tag: "DATABASE TIER", icon: "🗄️" },
  "c6": { color: "#ec4899", label: "DECOUPLING & ASYNC EVENT BUS", tag: "INTEGRATION TIER", icon: "🔄" }
};
---

<BaseLayout
  title="AWS Services for SAA-C03 Exam Prep | SAA Prep"
  description={description}
  canonicalPath="/services"
  pageType="CollectionPage"
  structuredData={structuredData}
>
  <div class="compact-services-container">
    
    <!-- COMPACT HEADER -->
    <header class="compact-header">
      <div>
        <span class="ch-tag">[HIGH-DENSITY CATEGORY BOUNDARIES]</span>
        <h1 class="ch-title">// AWS SERVICE ARCHITECTURE CATALOG</h1>
      </div>
      <div class="ch-right">
        <span class="ch-stat">{serviceCount} REQUIRED AWS SERVICES</span>
      </div>
    </header>

    <!-- COMPACT BOUNDARIES STACK -->
    <div class="compact-boundaries-stack">
      {concepts.map((concept: any, conceptIdx: number) => {
        const theme = conceptThemes[concept.id] || { color: "#00e5ff", label: concept.name.toUpperCase(), tag: "AWS DOMAIN", icon: "✦" };

        return (
          <div class="compact-boundary-box" style={`border-top: 2px solid ${theme.color};`}>
            
            <!-- BOUNDARY HEADER BAR -->
            <div class="cb-header-bar">
              <div class="cb-left">
                <span class="cb-icon">{theme.icon}</span>
                <span class="cb-num">0{conceptIdx + 1}</span>
                <h2 class="cb-title" style={`color: ${theme.color};`}>{theme.label}</h2>
              </div>
              <span class="cb-tag" style={`color: ${theme.color}; border-color: ${theme.color};`}>{theme.tag}</span>
            </div>

            <!-- COMPACT CLUSTER SUBCATEGORIES -->
            <div class="cb-body-grid">
              {concept.clusters.map((cluster: any, clusterIdx: number) => (
                <div class="compact-cluster-card">
                  
                  <div class="cluster-head">
                    <span class="cs-num">0{clusterIdx + 1}</span>
                    <h3 class="cs-title">{cluster.name}</h3>
                  </div>

                  <!-- INNER SERVICES CHIPS -->
                  <div class="compact-services-row">
                    {cluster.services.map((svcName: string) => {
                      const svcUrl = getTaxonomyEntryHref(svcName, cluster.id);
                      return (
                        <a href={sitePath(svcUrl)} class="compact-svc-chip">
                          <span class="chip-dot" style={`background: ${theme.color};`}></span>
                          <span class="chip-name">{svcName}</span>
                        </a>
                      );
                    })}
                  </div>

                </div>
              ))}
            </div>

          </div>
        );
      })}
    </div>

  </div>
</BaseLayout>

<style>
  .compact-services-container {
    width: 100%;
    padding: 0;
  }

  .compact-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.5rem;
    margin-bottom: 0.85rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ch-tag {
    font-size: 0.6rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-weight: 900;
    margin-bottom: 0.1rem;
    display: block;
  }

  .ch-title {
    font-size: 1.6rem;
    font-weight: 900;
    font-family: var(--font-mono);
    margin: 0;
  }

  .ch-right {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-weight: 800;
  }

  /* BOUNDARIES STACK */
  .compact-boundaries-stack {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .compact-boundary-box {
    background: #08090e;
    border: 1px solid #1e2230;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .cb-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.45rem 0.8rem;
    background: #0d0f17;
    border-bottom: 1px solid #1e2230;
    font-family: var(--font-mono);
  }

  .cb-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .cb-icon {
    font-size: 0.9rem;
  }

  .cb-num {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-weight: 900;
  }

  .cb-title {
    font-size: 0.85rem;
    font-weight: 900;
    margin: 0;
  }

  .cb-tag {
    font-size: 0.55rem;
    font-weight: 900;
    padding: 0.1rem 0.35rem;
    border: 1px solid;
  }

  .cb-body-grid {
    padding: 0.6rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
    gap: 0.6rem;
    align-items: start;
  }

  .compact-cluster-card {
    background: #10131d;
    border: 1px solid #232838;
    border-radius: 6px;
    padding: 0.55rem 0.6rem 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .compact-cluster-card:hover {
    background: #141824;
    border-color: #2f3648;
  }

  .cluster-head {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    border-bottom: 1px solid #1c202e;
    padding-bottom: 0.3rem;
    font-family: var(--font-mono);
  }

  .cs-num {
    font-size: 0.6rem;
    color: var(--text-muted);
    font-weight: 900;
  }

  .cs-title {
    font-size: 0.8rem;
    line-height: 1.25;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .compact-services-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
  }

  .compact-svc-chip {
    background: #161a28;
    border: 1px solid #2a3144;
    border-radius: 999px;
    padding: 0.22rem 0.55rem;
    text-decoration: none;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    font-family: var(--font-mono);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    line-height: 1.4;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  .compact-svc-chip:hover {
    background: #1e2434;
    border-color: #3b4459;
    transform: translateY(-1px);
  }

  .chip-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .chip-name {
    color: #ffffff;
  }
</style>
