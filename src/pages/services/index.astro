---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTaxonomyTree, getAllServices } from '../../lib/data';

const services = getAllServices();
const taxonomy = getTaxonomyTree();
const concepts = taxonomy.level_2_and_3.concepts;

// Concept Themes
const conceptThemes: Record<string, { color: string; label: string; icon: string }> = {
  "c1": { color: "var(--color-security)", label: "SECURITY, GUARD & IDENTITY PIPELINE", icon: "🛡️" },
  "c2": { color: "var(--color-network)", label: "NETWORK, TRAFFIC & INGRESS PIPELINE", icon: "⚡" },
  "c3": { color: "var(--color-compute)", label: "COMPUTE & WORKLOAD EXECUTION PIPELINE", icon: "⚙️" },
  "c4": { color: "var(--color-storage)", label: "STORAGE & PERSISTENCE PIPELINE", icon: "📦" },
  "c5": { color: "var(--color-database)", label: "DATABASE & ANALYTICS DATA PIPELINE", icon: "🗄️" },
  "c6": { color: "var(--color-decouple)", label: "DECOUPLING & ASYNC EVENT PIPELINE", icon: "🔄" }
};
---

<BaseLayout title="AWS Service Architecture Directory | SAA-C03">
  <div class="services-diagram-container">
    
    <!-- HEADER -->
    <header class="index-header">
      <div class="header-tag">[GRAPHICAL ARCHITECTURE FLOW DIRECTORY]</div>
      <h1 class="index-title">// AWS SERVICE FLOW MAPS</h1>
      <p class="index-sub">Visual architectural pipelines & node flowcharts mapped to SAA-C03 exam taxonomy.</p>
    </header>

    <!-- DIAGRAM FLOW PIPELINES BY CONCEPT -->
    <div class="pipelines-stack">
      {concepts.map((concept: any, conceptIdx: number) => {
        const theme = conceptThemes[concept.id] || { color: "var(--color-network)", label: concept.name.toUpperCase(), icon: "✦" };

        return (
          <section class="pipeline-section">
            
            <!-- PIPELINE HEADER -->
            <div class="pipeline-header">
              <div class="ph-title-group">
                <span class="ph-num">0{conceptIdx + 1}</span>
                <span class="ph-label" style={`color: ${theme.color};`}>{theme.label}</span>
              </div>
              <span class="ph-badge" style={`color: ${theme.color}; border-color: ${theme.color};`}>VISUAL PIPELINE</span>
            </div>

            <!-- GRAPHICAL ARCHITECTURE FLOWCHART CANVAS -->
            <div class="diagram-canvas-box">
              <div class="flow-pipeline-track">
                {concept.clusters.map((cluster: any, clusterIdx: number) => (
                  <div class="cluster-stage-item">
                    
                    <!-- STAGE TITLE HEADER -->
                    <div class="stage-tag-bar">
                      <span class="stage-num" style={`color: ${theme.color}; border-color: ${theme.color};`}>STAGE 0{clusterIdx + 1}</span>
                      <span class="stage-name">{cluster.name}</span>
                    </div>

                    <!-- VISUAL SERVICE NODES PIPELINE -->
                    <div class="nodes-horizontal-flow">
                      {cluster.services.map((svcName: string, svcIdx: number) => {
                        const svcId = svcName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
                        return (
                          <div class="node-unit">
                            <a href={`/services/${svcId}`} class="graphic-node-card" style={`border-left: 3px solid ${theme.color};`}>
                              <div class="gn-meta">
                                <span class="gn-id">N0{svcIdx + 1}</span>
                                <span class="gn-badge" style={`color: ${theme.color};`}>AWS</span>
                              </div>
                              <div class="gn-title">{svcName}</div>
                              <span class="gn-link">View Blueprint ➔</span>
                            </a>

                            <!-- SVG FLOW CONNECTOR ARROW -->
                            {svcIdx < cluster.services.length - 1 && (
                              <div class="flow-svg-connector">
                                <svg width="32" height="20" viewBox="0 0 32 20" fill="none">
                                  <line x1="0" y1="10" x2="24" y2="10" stroke={theme.color} stroke-width="2" stroke-dasharray="3 3"/>
                                  <polygon points="24,5 32,10 24,15" fill={theme.color} />
                                </svg>
                              </div>
                            )}
                          </div>
                        );
                      })}
                    </div>

                    <!-- STAGE-TO-STAGE SVG CONNECTOR ARROW -->
                    {clusterIdx < concept.clusters.length - 1 && (
                      <div class="stage-down-connector">
                        <svg width="24" height="28" viewBox="0 0 24 28" fill="none">
                          <line x1="12" y1="0" x2="12" y2="20" stroke={theme.color} stroke-width="2" stroke-dasharray="3 3"/>
                          <polygon points="6,20 12,28 18,20" fill={theme.color} />
                        </svg>
                      </div>
                    )}

                  </div>
                ))}
              </div>
            </div>

          </section>
        );
      })}
    </div>

  </div>
</BaseLayout>

<style>
  .services-diagram-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 0 5rem;
  }

  .index-header {
    margin-bottom: 3.5rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 2rem;
  }

  .header-tag {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    font-weight: 900;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .index-title {
    font-size: 2.75rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
    font-family: var(--font-mono);
  }

  .index-sub {
    color: var(--text-secondary);
    font-size: 1.05rem;
  }

  /* PIPELINES STACK */
  .pipelines-stack {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .pipeline-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pipeline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.75rem;
  }

  .ph-title-group {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .ph-num {
    font-size: 1rem;
    font-family: var(--font-mono);
    font-weight: 900;
    color: var(--text-muted);
  }

  .ph-label {
    font-size: 0.95rem;
    font-family: var(--font-mono);
    font-weight: 900;
    letter-spacing: 0.04em;
  }

  .ph-badge {
    font-size: 0.6rem;
    font-family: var(--font-mono);
    font-weight: 900;
    padding: 0.15rem 0.45rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid;
  }

  /* DIAGRAM CANVAS */
  .diagram-canvas-box {
    background: #040508;
    border: 1px solid var(--border-subtle);
    padding: 1.75rem;
  }

  .flow-pipeline-track {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cluster-stage-item {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .stage-tag-bar {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .stage-num {
    font-size: 0.6rem;
    font-family: var(--font-mono);
    font-weight: 900;
    padding: 0.1rem 0.4rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid;
  }

  .stage-name {
    font-size: 1rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .nodes-horizontal-flow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
  }

  .node-unit {
    display: flex;
    align-items: center;
  }

  .graphic-node-card {
    background: #0b0d13;
    border: 1px solid var(--border-subtle);
    padding: 1rem 1.25rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 170px;
  }

  .gn-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
  }

  .gn-id {
    font-size: 0.6rem;
    color: var(--text-muted);
    font-weight: 900;
  }

  .gn-badge {
    font-size: 0.6rem;
    font-weight: 900;
  }

  .gn-title {
    font-size: 1.05rem;
    font-weight: 900;
    color: var(--text-primary);
  }

  .gn-link {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    font-weight: 700;
  }

  .flow-svg-connector {
    padding: 0 0.5rem;
    display: flex;
    align-items: center;
  }

  .stage-down-connector {
    display: flex;
    justify-content: center;
    padding: 0.5rem 0;
  }
</style>
