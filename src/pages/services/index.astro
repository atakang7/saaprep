---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTaxonomyTree, getAllServices } from '../../lib/data';

const services = getAllServices();
const taxonomy = getTaxonomyTree();
const concepts = taxonomy.level_2_and_3.concepts;

// Concept Themes with visual boundary colors
const conceptThemes: Record<string, { color: string; label: string; tag: string; icon: string }> = {
  "c1": { color: "#ff2a70", label: "SECURITY, ACCESS & IDENTITY BOUNDARY", tag: "SECURITY TIER", icon: "🛡️" },
  "c2": { color: "#00e5ff", label: "NETWORK, TRAFFIC & INGRESS EDGE ZONE", tag: "NETWORKING TIER", icon: "⚡" },
  "c3": { color: "#a855f7", label: "COMPUTE & WORKLOAD EXECUTION REGION", tag: "COMPUTE TIER", icon: "⚙️" },
  "c4": { color: "#f59e0b", label: "STORAGE & DATA PERSISTENCE TIER", tag: "STORAGE TIER", icon: "📦" },
  "c5": { color: "#10b981", label: "DATABASE & ANALYTICS CLUSTER ZONE", tag: "DATABASE TIER", icon: "🗄️" },
  "c6": { color: "#ec4899", label: "DECOUPLING & ASYNC EVENT BUS", tag: "INTEGRATION TIER", icon: "🔄" }
};
---

<BaseLayout title="AWS Service Architecture Directory | SAA-C03">
  <div class="services-index-container">
    
    <!-- HEADER -->
    <header class="index-header">
      <div class="header-tag">[AWS DOMAIN CATEGORY GROUPINGS]</div>
      <h1 class="index-title">// AWS SERVICE ARCHITECTURE DIRECTORY</h1>
      <p class="index-sub">Categorized AWS service infrastructure boundaries for the SAA-C03 certification exam.</p>
    </header>

    <!-- CATEGORY GROUPINGS STACK -->
    <div class="category-groupings-stack">
      {concepts.map((concept: any, conceptIdx: number) => {
        const theme = conceptThemes[concept.id] || { color: "#00e5ff", label: concept.name.toUpperCase(), tag: "AWS DOMAIN", icon: "✦" };

        return (
          <div class="category-boundary-box" style={`border-top: 3px solid ${theme.color};`}>
            
            <!-- BOUNDARY HEADER TAB -->
            <div class="boundary-header-bar">
              <div class="bh-left">
                <span class="bh-icon">{theme.icon}</span>
                <h2 class="bh-title" style={`color: ${theme.color};`}>{theme.label}</h2>
              </div>
              <div class="bh-right">
                <span class="bh-tag" style={`color: ${theme.color}; border-color: ${theme.color};`}>{theme.tag}</span>
                <span class="bh-count">{concept.clusters.reduce((acc: number, c: any) => acc + c.services.length, 0)} SERVICES</span>
              </div>
            </div>

            <!-- CLUSTER SUBCATEGORIES INSIDE THIS BOUNDARY -->
            <div class="boundary-body-grid">
              {concept.clusters.map((cluster: any, clusterIdx: number) => (
                <div class="cluster-subcard">
                  
                  <div class="cluster-subcard-header">
                    <span class="cs-num">0{clusterIdx + 1}</span>
                    <h3 class="cs-title">{cluster.name}</h3>
                  </div>

                  <!-- INNER SERVICES GRID -->
                  <div class="cluster-services-grid">
                    {cluster.services.map((svcName: string) => {
                      const svcId = svcName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
                      return (
                        <a href={`/services/${svcId}`} class="service-chip-card">
                          <div class="scc-top">
                            <span class="scc-dot" style={`background: ${theme.color};`}></span>
                            <span class="scc-code">AWS</span>
                          </div>
                          <div class="scc-name">{svcName}</div>
                          <div class="scc-action">View Blueprint →</div>
                        </a>
                      );
                    })}
                  </div>

                </div>
              ))}
            </div>

          </div>
        );
      })}
    </div>

  </div>
</BaseLayout>

<style>
  .services-index-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 0 5rem;
  }

  .index-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.5rem;
  }

  .header-tag {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    font-weight: 900;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    margin-bottom: 0.4rem;
  }

  .index-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    letter-spacing: -0.02em;
  }

  .index-sub {
    color: var(--text-secondary);
    font-size: 1.05rem;
  }

  /* CATEGORY GROUPINGS STACK */
  .category-groupings-stack {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* BOUNDARY BOX */
  .category-boundary-box {
    background: #08090e;
    border: 1px solid #1e2230;
    display: flex;
    flex-direction: column;
  }

  .boundary-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.15rem 1.5rem;
    background: #0d0f17;
    border-bottom: 1px solid #1e2230;
  }

  .bh-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .bh-icon {
    font-size: 1.2rem;
  }

  .bh-title {
    font-size: 1.05rem;
    font-family: var(--font-mono);
    font-weight: 900;
    margin: 0;
    letter-spacing: 0.03em;
  }

  .bh-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
  }

  .bh-tag {
    font-size: 0.65rem;
    font-weight: 900;
    padding: 0.15rem 0.5rem;
    border: 1px solid;
    background: rgba(255, 255, 255, 0.02);
  }

  .bh-count {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-weight: 800;
  }

  /* BOUNDARY BODY GRID */
  .boundary-body-grid {
    padding: 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .cluster-subcard {
    background: #10131d;
    border: 1px solid #252a3b;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cluster-subcard-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border-bottom: 1px solid #1e2230;
    padding-bottom: 0.65rem;
  }

  .cs-num {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    font-weight: 900;
    color: var(--text-muted);
  }

  .cs-title {
    font-size: 1rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
  }

  .cluster-services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 0.75rem;
  }

  .service-chip-card {
    background: #161a28;
    border: 1px solid #2d3448;
    padding: 0.85rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .scc-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .scc-dot {
    width: 6px;
    height: 6px;
    display: inline-block;
  }

  .scc-code {
    font-size: 0.55rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-weight: 900;
  }

  .scc-name {
    font-size: 0.95rem;
    font-weight: 900;
    color: #ffffff;
  }

  .scc-action {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    font-weight: 700;
    margin-top: 0.2rem;
  }
</style>
