---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTaxonomyTree, getPracticeQuestions } from '../lib/data';

const taxonomy = getTaxonomyTree();
const questions = getPracticeQuestions();
const domains = taxonomy.level_1.domains;
const concepts = taxonomy.level_2_and_3.concepts;
---

<BaseLayout title="SAA-C03 | AWS Certification Engine">
  <section class="hero-section">
    <div class="hero-badge">SAA-C03</div>
    <h1 class="hero-title">
      AWS Solutions Architect <br />
      <span class="text-gradient">Practice Platform</span>
    </h1>

    <div class="hero-cta-group">
      <a href="/practice" class="btn btn-primary">Start Practice Arena →</a>
      <a href="/concepts" class="btn btn-secondary">View Taxonomy</a>
    </div>
  </section>

  <!-- Metric Cards -->
  <section class="metrics-grid">
    <div class="glass-card metric-card">
      <span class="metric-value">{questions.length}</span>
      <span class="metric-label">Practice Questions</span>
    </div>
    <div class="glass-card metric-card">
      <span class="metric-value">4</span>
      <span class="metric-label">Decision Lenses</span>
    </div>
    <div class="glass-card metric-card">
      <span class="metric-value">{concepts.length}</span>
      <span class="metric-label">Core Action Domains</span>
    </div>
  </section>

  <!-- Decision Lenses Grid -->
  <section class="section-container">
    <h2 class="section-title">Exam Decision Lenses</h2>
    <div class="domains-grid">
      {domains.map((domain: any) => (
        <div class="glass-card domain-card">
          <div class="domain-header">
            <h3>{domain.name}</h3>
            <span class="domain-weight">{domain.weight}</span>
          </div>
          <p>{domain.focus}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    text-align: center;
    padding: 3rem 1rem 3.5rem;
  }
  .hero-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    background: #0a0a0f;
    border: 1px solid #2d2b55;
    color: var(--unicorn-cyan);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }
  .hero-title {
    font-size: 2.75rem;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.75rem;
  }
  .hero-cta-group {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }
  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.9rem;
    transition: all 0.2s;
  }
  .btn-primary {
    background: var(--unicorn-pink);
    color: white;
    box-shadow: 0 0 15px rgba(255, 42, 133, 0.35);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 25px rgba(255, 42, 133, 0.55);
  }
  .btn-secondary {
    background: #06060a;
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }
  .btn-secondary:hover {
    background: #12121a;
    border-color: #2d2b55;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }
  .metric-card {
    padding: 1.5rem;
    text-align: center;
  }
  .metric-value {
    display: block;
    font-size: 2.25rem;
    font-weight: 900;
    color: var(--unicorn-cyan);
  }
  .metric-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .section-container {
    margin-bottom: 3rem;
  }
  .section-title {
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
  }
  .domains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .domain-card {
    padding: 1.25rem;
  }
  .domain-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .domain-header h3 {
    font-size: 1rem;
    font-weight: 700;
  }
  .domain-weight {
    background: rgba(0, 240, 255, 0.1);
    color: var(--unicorn-cyan);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.75rem;
  }
  .domain-card p {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
</style>
