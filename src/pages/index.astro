---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTaxonomyTree, getPracticeQuestions } from '../lib/data';

const taxonomy = getTaxonomyTree();
const questions = getPracticeQuestions();
const domains = taxonomy.level_1.domains;
const concepts = taxonomy.level_2_and_3.concepts;

// Semantic color mapping per domain/cluster
const domainColors: Record<string, string> = {
  "Security": "var(--color-security)",
  "Resilience": "var(--color-compute)",
  "Performance": "var(--color-network)",
  "Cost": "var(--color-storage)"
};
---

<BaseLayout title="SAA-C03 | AWS Certification Engine">
  <section class="hero-section">
    <div class="hero-badge">SAA-C03 EXAM PREP</div>
    <h1 class="hero-title">
      AWS Solutions Architect <br />
      <span class="text-gradient">Practice Platform</span>
    </h1>

    <div class="hero-cta-group">
      <a href="/practice" class="btn btn-primary">Start Practice Arena →</a>
      <a href="/concepts" class="btn btn-secondary">Explore Taxonomy</a>
    </div>
  </section>

  <!-- Metric Cards -->
  <section class="metrics-grid">
    <div class="glass-card metric-card">
      <span class="metric-value text-gradient">{questions.length}</span>
      <span class="metric-label">Practice Questions</span>
    </div>
    <div class="glass-card metric-card">
      <span class="metric-value" style="color: var(--color-security);">4</span>
      <span class="metric-label">Decision Lenses</span>
    </div>
    <div class="glass-card metric-card">
      <span class="metric-value" style="color: var(--color-network);">{concepts.length}</span>
      <span class="metric-label">Core Action Domains</span>
    </div>
  </section>

  <!-- Decision Lenses Grid -->
  <section class="section-container">
    <h2 class="section-title">Exam Decision Lenses</h2>
    <div class="domains-grid">
      {domains.map((domain: any) => {
        const color = domainColors[domain.name] || "var(--color-network)";
        return (
          <div class="glass-card domain-card" style={`--card-theme: ${color};`}>
            <div class="domain-header">
              <h3 style={`color: ${color};`}>{domain.name}</h3>
              <span class="domain-weight" style={`background: ${color}20; color: ${color}; border-color: ${color}40;`}>{domain.weight}</span>
            </div>
            <p>{domain.focus}</p>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    text-align: center;
    padding: 3rem 1rem 3.5rem;
  }
  .hero-badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    background: #08080e;
    border: 1px solid var(--color-security);
    color: var(--color-security);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
    box-shadow: 0 0 12px rgba(255, 42, 133, 0.25);
  }
  .hero-title {
    font-size: 2.75rem;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.75rem;
  }
  .hero-cta-group {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }
  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.9rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn-primary {
    background: var(--color-security);
    color: white;
    box-shadow: 0 0 15px rgba(255, 42, 133, 0.35);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 25px rgba(255, 42, 133, 0.6);
  }
  .btn-secondary {
    background: #06060a;
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }
  .btn-secondary:hover {
    background: #12121a;
    border-color: var(--color-network);
    color: var(--color-network);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }
  .metric-card {
    padding: 1.5rem;
    text-align: center;
  }
  .metric-value {
    display: block;
    font-size: 2.25rem;
    font-weight: 900;
  }
  .metric-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .section-container {
    margin-bottom: 3rem;
  }
  .section-title {
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
  }
  .domains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .domain-card {
    padding: 1.25rem;
  }
  .domain-card:hover {
    border-color: var(--card-theme);
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.05), 0 0 15px var(--card-theme);
  }
  .domain-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.65rem;
  }
  .domain-header h3 {
    font-size: 1.05rem;
    font-weight: 800;
  }
  .domain-weight {
    border: 1px solid;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-weight: 800;
    font-size: 0.75rem;
  }
  .domain-card p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
