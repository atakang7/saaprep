---
import { Search, Shield, Zap, Database, Server, Settings, Activity, ArrowRight } from "lucide-astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { clusterMeta, conceptStyles, totalQuestions, totalTopics } from "../lib/data";

const clusters = clusterMeta();

const concepts = [
  { id: "c1", icon: Shield, label: "Guard", desc: "Access, Identity & Security", color: "var(--teal)" },
  { id: "c2", icon: Activity, label: "Connect", desc: "Networking & Traffic", color: "var(--blue)" },
  { id: "c3", icon: Zap, label: "Run", desc: "Compute & Workloads", color: "var(--rose)" },
  { id: "c4", icon: Database, label: "Store", desc: "Data Storage & Archiving", color: "var(--green)" },
  { id: "c5", icon: Server, label: "Query", desc: "Databases & Analytics", color: "var(--violet)" },
  { id: "c6", icon: Settings, label: "Operate", desc: "Decoupling & Management", color: "var(--amber)" },
];

const counts = concepts.map(c => {
  const conceptClusters = clusters.filter(cl => cl.conceptId === c.id);
  const qCount = conceptClusters.reduce((acc, cl) => acc + cl.count, 0);
  return { ...c, topicCount: conceptClusters.length, qCount };
});
---

<BaseLayout title="AWS SAA-C03" bare={true}>
  <!-- ═══ Hero ═══ -->
  <section class="landing-hero">
    <div class="hero-grid-bg"></div>
    <div class="hero-glow" style="width:700px;height:700px;top:-20%;left:-15%;background:var(--teal);"></div>
    <div class="hero-glow" style="width:600px;height:600px;bottom:-30%;right:-15%;background:var(--blue);opacity:0.2;"></div>

    <div class="page-container landing-inner">
      <div class="animate-in">
        <span class="eyebrow">SAA-C03</span>
        <h1 class="landing-title">AWS Solutions Architect<br/><span class="gradient-text">Associate</span></h1>
      </div>

      <div class="landing-stats animate-in animate-in-delay-1">
        <div class="stat-item">
          <span class="stat-value">{totalQuestions.toLocaleString()}</span>
          <span class="stat-label">Questions</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-value">{totalTopics}</span>
          <span class="stat-label">Topics</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-value">6</span>
          <span class="stat-label">Concepts</span>
        </div>
      </div>

      <!-- Search inline in hero -->
      <div class="search-wrapper animate-in animate-in-delay-2">
        <div class="search-box glass">
          <Search size={20} />
          <input
            type="search"
            data-search
            placeholder="Search topics or questions…"
            autocomplete="off"
          />
          <kbd class="kbd-hint">/</kbd>
        </div>
        <div class="search-results glass" data-results hidden></div>
      </div>
    </div>
  </section>

  <!-- ═══ Concepts ═══ -->
  <section class="concepts-section" id="concepts">
    <div class="page-container">
      <div class="concept-grid">
        {counts.map((concept, i) => (
          <a class="concept-card" href={`/concepts/${concept.id}/`} style={`--accent:${concept.color}; --delay: ${i * 0.06}s;`}>
            <div class="concept-card-glow"></div>
            <div class="concept-card-inner">
              <div class="concept-icon-wrap">
                <concept.icon size={28} />
              </div>
              <div class="concept-card-body">
                <h3>{concept.label}</h3>
                <p class="muted">{concept.desc}</p>
                <div class="concept-card-stats">
                  <span class="chip chip-accent">{concept.topicCount} Topics</span>
                  {concept.qCount > 0 && <span class="small muted">{concept.qCount} Questions</span>}
                </div>
              </div>
              <div class="concept-card-arrow"><ArrowRight size={18} /></div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .landing-hero {
      position: relative;
      padding: 8rem 0 3rem;
      overflow: hidden;
    }

    .landing-inner {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .landing-title {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      font-weight: 900;
      line-height: 1.05;
      letter-spacing: -0.04em;
      margin-bottom: 2rem;
    }

    .landing-stats {
      display: flex;
      align-items: center;
      gap: 2rem;
      background: var(--glass-bg);
      backdrop-filter: blur(12px);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl);
      padding: 16px 32px;
      margin-bottom: 2.5rem;
    }

    .stat-item { text-align: center; }

    .stat-value {
      display: block;
      font-size: 1.4rem;
      font-weight: 800;
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .stat-label {
      display: block;
      font-size: 0.75rem;
      color: var(--muted);
      font-weight: 500;
      margin-top: 2px;
    }

    .stat-divider {
      width: 1px;
      height: 32px;
      background: var(--line);
    }

    /* Search */
    .search-wrapper {
      width: 100%;
      max-width: 600px;
      position: relative;
    }

    .search-box {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 22px;
      border-radius: 999px;
      transition: all 0.3s ease;
      color: var(--muted);
    }

    .search-box:focus-within {
      border-color: var(--teal);
      box-shadow: 0 0 0 3px var(--teal-dim), 0 16px 40px rgba(0,0,0,0.3);
      transform: translateY(-2px);
    }

    .search-box input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      font-size: 1rem;
      color: var(--ink);
    }

    .search-box input::placeholder { color: var(--muted); }

    .kbd-hint {
      background: var(--surface-soft);
      border: 1px solid var(--line-strong);
      border-radius: 6px;
      padding: 2px 10px;
      font-size: 0.82rem;
      color: var(--muted);
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    .search-results {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      border-radius: var(--radius-lg);
      z-index: 10;
    }

    /* Concepts */
    .concepts-section {
      padding: 2rem 0 6rem;
    }

    .concept-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1.25rem;
    }

    .concept-card {
      position: relative;
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--surface);
      overflow: hidden;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      text-decoration: none;
      animation: fade-in-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--delay, 0s);
    }

    .concept-card:hover {
      transform: translateY(-6px) scale(1.01);
      border-color: var(--accent);
      box-shadow: 0 20px 50px color-mix(in srgb, var(--accent) 20%, transparent);
    }

    .concept-card-glow {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at top right, color-mix(in srgb, var(--accent) 8%, transparent), transparent 60%);
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }

    .concept-card:hover .concept-card-glow { opacity: 1; }

    .concept-card-inner {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      padding: 1.75rem;
      position: relative;
      z-index: 1;
    }

    .concept-icon-wrap {
      width: 56px;
      height: 56px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      color: var(--accent);
      transition: transform 0.3s ease;
    }

    .concept-card:hover .concept-icon-wrap {
      transform: scale(1.1) rotate(-5deg);
    }

    .concept-card-body { flex: 1; min-width: 0; }

    .concept-card-body h3 {
      font-size: 1.2rem;
      margin-bottom: 0.25rem;
      color: var(--ink);
    }

    .concept-card-stats {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 0.75rem;
    }

    .concept-card-arrow {
      color: var(--muted);
      opacity: 0;
      transform: translateX(-8px);
      transition: all 0.3s ease;
    }

    .concept-card:hover .concept-card-arrow {
      opacity: 1;
      transform: translateX(0);
    }

    @media (max-width: 600px) {
      .landing-stats { gap: 1.25rem; padding: 14px 20px; }
      .stat-divider { display: none; }
      .concept-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    import { search, highlight, type Row } from "../lib/search";

    const input = document.querySelector<HTMLInputElement>("[data-search]");
    const results = document.querySelector<HTMLElement>("[data-results]");

    let rows: Row[] | null = null;
    let loading: Promise<void> | null = null;

    function ensureIndex() {
      if (rows) return Promise.resolve();
      if (!loading) {
        loading = fetch("/search-index.json")
          .then((r) => r.json())
          .then((data) => { rows = data; })
          .catch(() => { rows = []; });
      }
      return loading;
    }

    function render(query: string) {
      if (!results) return;
      const hits = search(rows ?? [], query, 30);

      if (!query.trim()) {
        results.hidden = true;
        return;
      }

      results.hidden = false;

      if (hits.length === 0) {
        results.innerHTML = `<p class="empty" style="margin:12px;">Nothing matches "${query}".</p>`;
        return;
      }

      results.innerHTML = `<div class="search-results-inner" style="padding:8px;max-height:400px;overflow-y:auto;">` + hits
        .map(({ row }) =>
          row.k === "t"
            ? `<a class="hit" href="/topics/${row.id}/">
                 <span class="chip chip-accent">Topic</span>
                 <span><b>${highlight(row.t, query)}</b></span>
               </a>`
            : `<a class="hit" href="/questions/${row.id}/">
                 <span class="chip">Q</span>
                 <span>
                   <span class="hit-text">${highlight(row.t, query)}</span>
                   <span class="small muted">${row.c ?? ""}${row.s ? ` · ${row.s}` : ""}</span>
                 </span>
               </a>`,
        )
        .join("") + `</div>`;
    }

    let timer: number | undefined;
    input?.addEventListener("input", () => {
      window.clearTimeout(timer);
      const query = input.value;
      timer = window.setTimeout(async () => {
        await ensureIndex();
        render(query);
      }, 90);
    });

    input?.addEventListener("focus", ensureIndex, { once: true });

    document.addEventListener("keydown", (event) => {
      if (event.key === "/" && document.activeElement !== input) {
        event.preventDefault();
        input?.focus();
      }
      if (event.key === "Escape" && input) {
        input.value = "";
        render("");
        input.blur();
      }
    });
  </script>
</BaseLayout>
