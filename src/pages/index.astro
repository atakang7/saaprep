---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTaxonomyTree, getPracticeQuestions } from '../lib/data';
import { absoluteUrl, DEFAULT_TITLE, normalizeSiteUrl, sitePath } from '../lib/seo';

const taxonomy = getTaxonomyTree();
const questions = getPracticeQuestions();
const domains = taxonomy.level_1.domains;
const concepts = taxonomy.level_2_and_3.concepts;
const siteUrl = normalizeSiteUrl(Astro.site);
const description = `Free AWS SAA-C03 exam prep with ${questions.length} scenario questions, service decision guides, and a searchable architecture taxonomy for Solutions Architect Associate study.`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': ['LearningResource', 'WebApplication'],
  name: 'AWS SAA-C03 Practice Platform',
  url: absoluteUrl('/', siteUrl),
  description,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  educationalUse: 'Certification exam preparation',
  learningResourceType: 'Practice questions and study guide',
  about: {
    '@type': 'DefinedTerm',
    name: 'AWS Certified Solutions Architect - Associate SAA-C03'
  },
  teaches: concepts.map((concept: any) => concept.name),
  hasPart: [
    {
      '@type': 'WebPage',
      name: 'AWS SAA-C03 Practice Questions',
      url: absoluteUrl('/practice', siteUrl)
    },
    {
      '@type': 'CollectionPage',
      name: 'AWS Service Directory',
      url: absoluteUrl('/services', siteUrl)
    },
    {
      '@type': 'CollectionPage',
      name: 'SAA-C03 Exam Taxonomy',
      url: absoluteUrl('/concepts', siteUrl)
    }
  ]
};

// High contrast accessible domain colors
const domainColors: Record<string, string> = {
  "Security": "var(--color-security)",
  "Resilience": "var(--color-compute)",
  "Performance": "var(--color-network)",
  "Cost": "var(--color-storage)"
};
const sampleQuestion = questions[0];
const sampleOptions = sampleQuestion?.options?.slice(0, 3) || [];
const sampleAnswerLetter = String(sampleQuestion?.answer || '').trim().charAt(0).toUpperCase();
const samplePracticeHref = `${sitePath('/practice')}?q=${encodeURIComponent(sampleQuestion?.id || '')}`;
---

<BaseLayout title={DEFAULT_TITLE} description={description} canonicalPath="/" structuredData={structuredData}>
  <section class="hero-section">
    <div class="hero-copy">
      <div class="hero-badge">SAA-C03 TACTICAL DRILL</div>
      <h1 class="hero-title">AWS Certified Solutions Architect – Associate (SAA-C03)</h1>

      <div class="hero-cta-group">
        <a href={sitePath('/practice')} class="btn btn-primary">Start Practice →</a>
        <a href={sitePath('/services')} class="btn btn-secondary">Open Service Map</a>
      </div>

      <div class="metrics-strip">
        <div>
          <strong>{questions.length}</strong>
          <span>questions</span>
        </div>
        <div>
          <strong>4</strong>
          <span>lenses</span>
        </div>
        <div>
          <strong>{concepts.length}</strong>
          <span>domains</span>
        </div>
      </div>

      <div class="flow-strip" aria-label="Recommended study flow">
        <span>1 Drill</span>
        <span>2 AI review</span>
        <span>3 Service page</span>
        <span>4 Taxonomy route</span>
      </div>
    </div>

    <div class="drill-preview" aria-label="Practice question preview">
      <div class="preview-topline">
        <span>LIVE DRILL</span>
        <span>{sampleQuestion?.id || 'SAA-C03'}</span>
      </div>
      <h2>{sampleQuestion?.question || 'Which AWS service best matches the stated requirement?'}</h2>
      <div class="preview-options">
        {sampleOptions.map((option: string) => (
          <div class={`preview-option ${option.trim().toUpperCase().startsWith(`${sampleAnswerLetter}.`) ? 'is-answer' : ''}`}>{option}</div>
        ))}
      
      <a href={samplePracticeHref} class="preview-action">Solve this question →</a>
    </div>
  </section>

  <section class="section-container">
    <div class="section-heading">
      <span>// DECISION LENSES</span>
      <h2>Read the scenario through the exam weights.</h2>
    </div>
    <div class="domains-grid">
      {domains.map((domain: any, index: number) => {
        const color = domainColors[domain.name] || "var(--color-network)";
        return (
          <div class="glass-card domain-card">
            <div class="domain-header">
              <span class="domain-index" style={`color: ${color};`}>0{index + 1}</span>
              <h3 style={`color: ${color};`}>{domain.name}</h3>
              <span class="domain-weight" style={`background: rgba(255,255,255,0.06); color: #ffffff; border: 1px solid ${color};`}>{domain.weight}</span>
            </div>
            <p>{domain.focus}</p>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  :global(.main-content) {
    justify-content: flex-start;
  }
  .hero-section {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(340px, 1.1fr);
    gap: 1.4rem;
    align-items: center;
    min-height: clamp(430px, calc(100vh - 230px), 560px);
    padding: 1.25rem 0 1.65rem;
    min-width: 0;
  }
  .hero-copy {
    max-width: 620px;
    min-width: 0;
  }
  .hero-badge {
    display: inline-block;
    padding: 0.34rem 0.62rem;
    border: 1px solid var(--color-security);
    color: var(--color-security);
    background: rgba(255, 43, 124, 0.08);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0;
    margin-bottom: 0.85rem;
  }
  .hero-title {
    max-width: 590px;
    font-size: 4.35rem;
    font-weight: 900;
    line-height: 0.98;
    margin-bottom: 0.85rem;
    overflow-wrap: break-word;
  }
  .hero-lede {
    max-width: 520px;
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.45;
    margin-bottom: 1.05rem;
  }
  .hero-cta-group {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.65rem;
    padding: 0.62rem 1.08rem;
    font-family: var(--font-mono);
    font-weight: 900;
    font-size: 0.9rem;
    transition: all 0.2s;
    text-decoration: none;
  }
  .btn-primary {
    background: var(--color-security);
    color: #ffffff;
  }
  .btn-primary:hover {
    background: #e11d48;
    transform: translateY(-2px);
  }
  .btn-secondary {
    background: #11131c;
    border: 1px solid var(--border-subtle);
    color: #ffffff;
  }
  .btn-secondary:hover {
    background: #23293a;
    border-color: var(--color-network);
  }

  .metrics-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 460px;
    min-width: 0;
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.025);
  }
  .metrics-strip div {
    padding: 0.72rem 0.85rem;
    border-right: 1px solid var(--border-subtle);
  }
  .metrics-strip div:last-child {
    border-right: 0;
  }
  .metrics-strip strong {
    display: block;
    color: var(--text-primary);
    font-size: 1.25rem;
    font-weight: 900;
    line-height: 1;
  }
  .metrics-strip span {
    display: block;
    margin-top: 0.28rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .flow-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    max-width: 540px;
    margin-top: 0.7rem;
  }
  .flow-strip span {
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.025);
    color: var(--text-secondary);
    padding: 0.36rem 0.52rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    white-space: nowrap;
  }
  .drill-preview {
    min-width: 0;
    max-width: 100%;
    border: 1px solid var(--border-subtle);
    background: #0d0f16;
    box-shadow: 0 18px 56px rgba(0, 0, 0, 0.24);
    padding: 0.95rem;
  }
  .preview-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.65rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px dashed var(--border-subtle);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 900;
  }
  .preview-topline span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .drill-preview h2 {
    margin: 0 0 0.75rem;
    color: var(--text-primary);
    font-size: 0.95rem;
    line-height: 1.38;
  }
  .preview-options {
    display: grid;
    gap: 0.55rem;
    margin-bottom: 0.75rem;
  }
  .preview-option {
    min-width: 0;
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.025);
    color: var(--text-secondary);
    padding: 0.62rem 0.75rem;
    font-size: 0.82rem;
    line-height: 1.32;
    overflow-wrap: anywhere;
  }
  .preview-option.is-answer {
    border-color: var(--color-network);
    color: #8ee7c2;
    background: rgba(0, 229, 255, 0.06);
  }
  .preview-coach {
    border-left: 3px solid var(--color-security);
    background: rgba(255, 43, 124, 0.055);
    padding: 0.7rem 0.85rem;
  }
  .preview-coach span {
    display: block;
    margin-bottom: 0.24rem;
    color: var(--color-security);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 900;
  }
  .preview-coach p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.38;
  }
  .preview-action {
    display: block;
    margin-top: 0.75rem;
    border: 1px solid rgba(142, 231, 194, 0.45);
    color: #8ee7c2;
    background: rgba(16, 185, 129, 0.08);
    padding: 0.62rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 900;
    text-align: center;
    text-decoration: none;
  }

  .section-container {
    margin-bottom: 2rem;
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .section-heading span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 900;
  }
  .section-heading h2 {
    max-width: 640px;
    margin: 0;
    text-align: right;
    font-size: 1.28rem;
    font-weight: 800;
  }
  .domains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
  }
  .domain-card {
    padding: 1.05rem;
    min-height: 132px;
  }
  .domain-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.55rem;
  }
  .domain-index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 900;
  }
  .domain-header h3 {
    flex: 1;
    font-size: 1rem;
    font-weight: 800;
  }
  .domain-weight {
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 800;
    font-size: 0.75rem;
  }
  .domain-card p {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.42;
  }
  @media (max-width: 1100px) {
    .hero-section {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-copy {
      max-width: none;
    }
    .drill-preview {
      max-width: 760px;
    }
    .hero-title {
      font-size: 3.45rem;
    }
  }
  @media (max-width: 760px) {
    .hero-section {
      padding-top: 1.2rem;
    }
    .metrics-strip {
      grid-template-columns: 1fr;
      max-width: none;
    }
    .metrics-strip div {
      border-right: 0;
      border-bottom: 1px solid var(--border-subtle);
    }
    .metrics-strip div:last-child {
      border-bottom: 0;
    }
    .section-heading {
      display: block;
    }
    .section-heading h2 {
      margin-top: 0.5rem;
      text-align: left;
      font-size: 1.25rem;
    }
    .hero-title {
      font-size: 2.25rem;
      line-height: 1.05;
    }
    .hero-lede {
      font-size: 0.9rem;
      overflow-wrap: anywhere;
    }
    .flow-strip {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .flow-strip span {
      white-space: normal;
      text-align: center;
    }
    .drill-preview h2 {
      overflow-wrap: anywhere;
    }
  }
</style>
