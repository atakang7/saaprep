---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTaxonomyTree, getPracticeQuestions } from '../lib/data';
import { absoluteUrl, DEFAULT_TITLE, normalizeSiteUrl, sitePath } from '../lib/seo';

const taxonomy = getTaxonomyTree();
const questions = getPracticeQuestions();
const domains = taxonomy.level_1.domains;
const concepts = taxonomy.level_2_and_3.concepts;
const siteUrl = normalizeSiteUrl(Astro.site);
const description = `Free AWS SAA-C03 exam prep with ${questions.length} scenario questions, service decision guides, and a searchable architecture taxonomy for Solutions Architect Associate study.`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': ['LearningResource', 'WebApplication'],
  name: 'AWS SAA-C03 Practice Platform',
  url: absoluteUrl('/', siteUrl),
  description,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  educationalUse: 'Certification exam preparation',
  learningResourceType: 'Practice questions and study guide',
  about: {
    '@type': 'DefinedTerm',
    name: 'AWS Certified Solutions Architect - Associate SAA-C03'
  },
  teaches: concepts.map((concept: any) => concept.name),
  hasPart: [
    {
      '@type': 'WebPage',
      name: 'AWS SAA-C03 Practice Questions',
      url: absoluteUrl('/practice', siteUrl)
    },
    {
      '@type': 'CollectionPage',
      name: 'AWS Service Directory',
      url: absoluteUrl('/services', siteUrl)
    },
    {
      '@type': 'CollectionPage',
      name: 'SAA-C03 Exam Taxonomy',
      url: absoluteUrl('/concepts', siteUrl)
    }
  ]
};

// High contrast accessible domain colors
const domainColors: Record<string, string> = {
  "Security": "var(--color-security)",
  "Resilience": "var(--color-compute)",
  "Performance": "var(--color-network)",
  "Cost": "var(--color-storage)"
};
const sampleQuestion = questions[0];
const sampleOptions = sampleQuestion?.options?.slice(0, 3) || [];
const sampleAnswerLetter = String(sampleQuestion?.answer || '').trim().charAt(0).toUpperCase();
const samplePracticeHref = `${sitePath('/practice')}?q=${encodeURIComponent(sampleQuestion?.id || '')}`;
---

<BaseLayout title={DEFAULT_TITLE} description={description} canonicalPath="/" structuredData={structuredData}>
  <section class="hero-section">
    <div class="hero-copy">
      <div class="hero-badge">SAA-C03 EXAM PREPARATION</div>
      <h1 class="hero-title">AWS Certified Solutions Architect – Associate (SAA-C03)</h1>
      <p class="hero-lede">
        A high-signal, distraction-free technical reference and tactical drill platform. Master the AWS decision reflex with verified exam scenarios and zero fluff.
      </p>

      <div class="hero-cta-group">
        <a href={sitePath('/practice')} class="btn btn-primary">Launch Practice Simulator →</a>
        <a href={sitePath('/services')} class="btn btn-secondary">Open Service Map</a>
        <a href={sitePath('/concepts')} class="btn btn-secondary">View Taxonomy</a>
      </div>
    </div>
  </section>

  <section class="section-container">
    <div class="section-heading">
      <span>// DECISION LENSES</span>
      <h2>Read the scenario through the exam weights.</h2>
    </div>
    <div class="domains-grid">
      {domains.map((domain: any, index: number) => {
        const color = domainColors[domain.name] || "var(--color-network)";
        return (
          <div class="glass-card domain-card">
            <div class="domain-header">
              <span class="domain-index" style={`color: ${color};`}>0{index + 1}</span>
              <h3 style={`color: ${color};`}>{domain.name}</h3>
              <span class="domain-weight" style={`background: rgba(255,255,255,0.06); color: #ffffff; border: 1px solid ${color};`}>{domain.weight}</span>
            </div>
            <p>{domain.focus}</p>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  :global(.main-content) {
    justify-content: flex-start;
  }
  .hero-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    min-height: clamp(350px, calc(100vh - 350px), 480px);
    padding: 2.5rem 0 3rem;
    max-width: 800px;
  }
  .hero-copy {
    width: 100%;
  }
  .hero-badge {
    display: inline-block;
    padding: 0.34rem 0.62rem;
    border: 1px solid var(--color-security);
    color: var(--color-security);
    background: rgba(255, 43, 124, 0.08);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0;
    margin-bottom: 0.85rem;
  }
  .hero-title {
    font-size: 3.85rem;
    font-weight: 900;
    line-height: 1.05;
    margin-bottom: 1.25rem;
    overflow-wrap: break-word;
  }
  .hero-lede {
    max-width: 680px;
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.5;
    margin-bottom: 2rem;
  }
  .hero-cta-group {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.65rem;
    padding: 0.62rem 1.08rem;
    font-family: var(--font-mono);
    font-weight: 900;
    font-size: 0.9rem;
    transition: all 0.2s;
    text-decoration: none;
  }
  .btn-primary {
    background: var(--color-security);
    color: #ffffff;
  }
  .btn-primary:hover {
    background: #e11d48;
    transform: translateY(-2px);
  }
  .btn-secondary {
    background: #11131c;
    border: 1px solid var(--border-subtle);
    color: #ffffff;
  }
  .btn-secondary:hover {
    background: #23293a;
    border-color: var(--color-network);
  }


  .section-container {
    margin-bottom: 2rem;
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .section-heading span {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 900;
  }
  .section-heading h2 {
    max-width: 640px;
    margin: 0;
    text-align: right;
    font-size: 1.28rem;
    font-weight: 800;
  }
  .domains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
  }
  .domain-card {
    padding: 1.05rem;
    min-height: 132px;
  }
  .domain-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.55rem;
  }
  .domain-index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 900;
  }
  .domain-header h3 {
    flex: 1;
    font-size: 1rem;
    font-weight: 800;
  }
  .domain-weight {
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 800;
    font-size: 0.75rem;
  }
  .domain-card p {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.42;
  }
  @media (max-width: 1100px) {
    .hero-title {
      font-size: 3.25rem;
    }
  }
  @media (max-width: 760px) {
    .hero-section {
      padding-top: 1.2rem;
    }
    .section-heading {
      display: block;
    }
    .section-heading h2 {
      margin-top: 0.5rem;
      text-align: left;
      font-size: 1.25rem;
    }
    .hero-title {
      font-size: 2.25rem;
      line-height: 1.1;
    }
    .hero-lede {
      font-size: 1rem;
      overflow-wrap: anywhere;
    }
  }
</style>
