---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTaxonomyTree, getPracticeQuestions } from '../lib/data';
import { absoluteUrl, DEFAULT_TITLE, normalizeSiteUrl, sitePath } from '../lib/seo';

const taxonomy = getTaxonomyTree();
const questions = getPracticeQuestions();
const domains = taxonomy.level_1.domains;
const concepts = taxonomy.level_2_and_3.concepts;
const siteUrl = normalizeSiteUrl(Astro.site);
const description = `Free AWS SAA-C03 exam prep with ${questions.length} scenario questions, service decision guides, and a searchable architecture taxonomy for Solutions Architect Associate study.`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': ['LearningResource', 'WebApplication'],
  name: 'AWS SAA-C03 Practice Platform',
  url: absoluteUrl('/', siteUrl),
  description,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  educationalUse: 'Certification exam preparation',
  learningResourceType: 'Practice questions and study guide',
  about: {
    '@type': 'DefinedTerm',
    name: 'AWS Certified Solutions Architect - Associate SAA-C03'
  },
  teaches: concepts.map((concept: any) => concept.name),
  hasPart: [
    {
      '@type': 'WebPage',
      name: 'AWS SAA-C03 Practice Questions',
      url: absoluteUrl('/practice', siteUrl)
    },
    {
      '@type': 'CollectionPage',
      name: 'AWS Service Directory',
      url: absoluteUrl('/services', siteUrl)
    },
    {
      '@type': 'CollectionPage',
      name: 'SAA-C03 Exam Taxonomy',
      url: absoluteUrl('/concepts', siteUrl)
    }
  ]
};

// High contrast accessible domain colors
const domainColors: Record<string, string> = {
  "Security": "var(--color-security)",
  "Resilience": "var(--color-compute)",
  "Performance": "var(--color-network)",
  "Cost": "var(--color-storage)"
};
---

<BaseLayout title={DEFAULT_TITLE} description={description} canonicalPath="/" structuredData={structuredData}>
  <section class="hero-section">
    <div class="hero-badge">AWS SAA-C03 PREP</div>
    <h1 class="hero-title">
      AWS Solutions Architect <br />
      <span class="text-gradient">Practice Platform</span>
    </h1>

    <div class="hero-cta-group">
      <a href={sitePath('/practice')} class="btn btn-primary">Start Practice Arena →</a>
      <a href={sitePath('/concepts')} class="btn btn-secondary">Explore Taxonomy</a>
    </div>
  </section>

  <!-- Metric Cards -->
  <section class="metrics-grid">
    <div class="glass-card metric-card">
      <span class="metric-value text-gradient">{questions.length}</span>
      <span class="metric-label">Practice Questions</span>
    </div>
    <div class="glass-card metric-card">
      <span class="metric-value" style="color: var(--color-security);">4</span>
      <span class="metric-label">Decision Lenses</span>
    </div>
    <div class="glass-card metric-card">
      <span class="metric-value" style="color: var(--color-network);">{concepts.length}</span>
      <span class="metric-label">Core Action Domains</span>
    </div>
  </section>

  <!-- Decision Lenses Grid -->
  <section class="section-container">
    <h2 class="section-title">Exam Decision Lenses</h2>
    <div class="domains-grid">
      {domains.map((domain: any) => {
        const color = domainColors[domain.name] || "var(--color-network)";
        return (
          <div class="glass-card domain-card">
            <div class="domain-header">
              <h3 style={`color: ${color};`}>{domain.name}</h3>
              <span class="domain-weight" style={`background: rgba(255,255,255,0.06); color: #ffffff; border: 1px solid ${color};`}>{domain.weight}</span>
            </div>
            <p>{domain.focus}</p>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    text-align: center;
    padding: 2.5rem 1rem 3rem;
  }
  .hero-badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    background: #181d2a;
    border: 1px solid var(--color-security);
    color: var(--color-security);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }
  .hero-title {
    font-size: 2.75rem;
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 1.75rem;
  }
  .hero-cta-group {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }
  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    transition: all 0.2s;
  }
  .btn-primary {
    background: var(--color-security);
    color: #ffffff;
  }
  .btn-primary:hover {
    background: #e11d48;
    transform: translateY(-2px);
  }
  .btn-secondary {
    background: #181d2a;
    border: 1px solid var(--border-subtle);
    color: #ffffff;
  }
  .btn-secondary:hover {
    background: #23293a;
    border-color: var(--color-network);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }
  .metric-card {
    padding: 1.5rem;
    text-align: center;
  }
  .metric-value {
    display: block;
    font-size: 2.25rem;
    font-weight: 900;
  }
  .metric-label {
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .section-container {
    margin-bottom: 3rem;
  }
  .section-title {
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
  }
  .domains-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .domain-card {
    padding: 1.5rem;
  }
  .domain-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .domain-header h3 {
    font-size: 1.1rem;
    font-weight: 800;
  }
  .domain-weight {
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 800;
    font-size: 0.8rem;
  }
  .domain-card p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
