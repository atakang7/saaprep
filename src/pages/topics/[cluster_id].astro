---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const filePath = path.join(process.cwd(), 'topic-pages.json');
  const data = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
  
  return data.map((topic: any) => ({
    params: { cluster_id: topic.cluster_id },
    props: { topic }
  }));
}

const { topic } = Astro.props;

// Re-use theme mapping
const conceptThemes: Record<string, { color: string; label: string }> = {
  "c1": { color: "var(--color-security)", label: "SECURITY & GUARD" },
  "c2": { color: "var(--color-network)", label: "NETWORK & TRAFFIC" },
  "c3": { color: "var(--color-compute)", label: "COMPUTE & RUN" },
  "c4": { color: "var(--color-storage)", label: "STORAGE & DATA" },
  "c5": { color: "var(--color-database)", label: "DATABASES & QUERY" },
  "c6": { color: "var(--color-decouple)", label: "DECOUPLE & OPERATE" }
};

const theme = conceptThemes[topic.concept_id] || { color: "var(--color-network)", label: topic.concept_id.toUpperCase() };
---

<BaseLayout title={`${topic.cluster_title} - SAA-C03 Architectural Cluster`}>
  <div class="clean-page">
    
    <!-- BREADCRUMB -->
    <nav class="clean-breadcrumb">
      <a href="/concepts">Taxonomy Tree</a>
      <span class="sep">/</span>
      <span class="current">{topic.cluster_title}</span>
    </nav>

    <!-- HEADER -->
    <header class="clean-hero">
      <div class="hero-tags">
        <span class="pill-badge" style={`color: ${theme.color}; background: rgba(255,255,255,0.04);`}>
          {theme.label}
        </span>
        <span class="concept-label">{topic.concept_name}</span>
      </div>

      <h1 class="hero-title">{topic.cluster_title}</h1>
      
      <div class="domains-chips">
        {topic.exam_domains.map((d: string) => (
          <span class="domain-tag">{d} Domain</span>
        ))}
      </div>
    </header>

    <!-- WHAT THIS TESTS -->
    <section class="content-block">
      <h2 class="block-heading">What The SAA-C03 Tests</h2>

      <div class="blueprint-list">
        {topic.what_this_tests.map((point: string, idx: number) => (
          <div class="blueprint-row">
            <span class="num">0{idx + 1}</span>
            <p>{point}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CORE SERVICES DEEP DIVE DIRECTORY -->
    <section class="content-block">
      <h2 class="block-heading">Services in this Cluster</h2>

      <div class="services-list">
        {topic.core_services.map((svc: any) => {
          const serviceId = svc.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
          return (
            <a href={`/services/${serviceId}`} class="svc-row-link">
              <div class="svc-row-header">
                <h3>{svc.name}</h3>
                <span class="link-arrow" style={`color: ${theme.color};`}>View Blueprint →</span>
              </div>
              <p class="svc-job">{svc.job}</p>
              <div class="rules-row">
                <div class="rule-chip choose">
                  <strong>✓ Choose:</strong> {svc.choose_when}
                </div>
                <div class="rule-chip avoid">
                  <strong>✕ Avoid:</strong> {svc.avoid_when}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- KEYWORD SIGNALS -->
    <section class="content-block">
      <h2 class="block-heading">Exam Keyword Mapping</h2>

      <div class="signals-list">
        {topic.signal_words.map((sw: any) => (
          <div class="signal-row">
            <span class="phrase">"{sw.phrase}"</span>
            <span class="arrow" style={`color: ${theme.color};`}>→</span>
            <span class="target">{sw.points_to}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- SERVICE COMPARISONS & EXAM MOVES -->
    <div class="dual-block">
      <section class="content-block">
        <h2 class="block-heading">Service vs Service</h2>
        <div class="comp-stack">
          {topic.comparisons.map((comp: string) => {
            const parts = comp.split(': ');
            return (
              <div class="comp-item">
                <strong style={`color: ${theme.color};`}>{parts[0]}</strong>
                <p>{parts[1] || comp}</p>
              </div>
            );
          })}
        </div>
      </section>

      <section class="content-block">
        <h2 class="block-heading">High-Yield Exam Moves</h2>
        <div class="moves-stack">
          {topic.exam_moves.map((move: string) => (
            <div class="move-item">
              <span class="icon">⚡</span>
              <p>{move}</p>
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- BOTTOM ACTION -->
    <div class="bottom-action">
      <div>
        <h3>Mastered {topic.cluster_title}?</h3>
        <p>Test your knowledge in the interactive practice simulator.</p>
      </div>
      <a href="/practice" class="btn-action" style={`background: ${theme.color};`}>Start Practice →</a>
    </div>

  </div>
</BaseLayout>

<style>
  .clean-page {
    max-width: 860px;
    margin: 0 auto;
    padding: 1rem 0 4rem;
  }

  .clean-breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }

  .clean-breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
  }

  .clean-breadcrumb a:hover {
    color: var(--text-primary);
  }

  .clean-breadcrumb .sep {
    color: var(--text-muted);
  }

  .clean-breadcrumb .current {
    color: var(--text-primary);
    font-weight: 700;
  }

  /* HERO */
  .clean-hero {
    margin-bottom: 3.5rem;
  }

  .hero-tags {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .pill-badge {
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .concept-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .domains-chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .domain-tag {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
  }

  /* CONTENT BLOCKS */
  .content-block {
    margin-bottom: 3.5rem;
  }

  .block-heading {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  /* BLUEPRINT */
  .blueprint-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .blueprint-row {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .blueprint-row .num {
    font-size: 1rem;
    font-weight: 900;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .blueprint-row p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* SERVICES LIST */
  .services-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .svc-row-link {
    display: block;
    background: rgba(255, 255, 255, 0.02);
    padding: 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }

  .svc-row-link:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .svc-row-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .svc-row-header h3 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .link-arrow {
    font-size: 0.85rem;
    font-weight: 800;
  }

  .svc-job {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .rules-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .rules-row {
      grid-template-columns: 1fr;
    }
  }

  .rule-chip {
    padding: 0.65rem 0.85rem;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.25);
    color: var(--text-secondary);
  }

  .rule-chip.choose strong { color: var(--color-database); }
  .rule-chip.avoid strong { color: var(--color-security); }

  /* SIGNALS */
  .signals-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .signal-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.02);
    padding: 0.85rem 1.25rem;
    border-radius: 8px;
    font-size: 0.95rem;
  }

  .signal-row .phrase {
    font-style: italic;
    color: var(--text-secondary);
    flex: 1;
  }

  .signal-row .arrow {
    font-weight: 900;
  }

  .signal-row .target {
    font-weight: 800;
    color: var(--text-primary);
    flex: 1;
  }

  /* DUAL BLOCK */
  .dual-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .dual-block {
      grid-template-columns: 1fr;
    }
  }

  .comp-stack, .moves-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .comp-item strong {
    display: block;
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .comp-item p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .move-item {
    display: flex;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .move-item .icon {
    color: var(--color-database);
  }

  /* BOTTOM ACTION */
  .bottom-action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .bottom-action {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .bottom-action h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .bottom-action p {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .btn-action {
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s;
  }

  .btn-action:hover {
    opacity: 0.9;
  }
</style>
