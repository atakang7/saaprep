---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const filePath = path.join(process.cwd(), 'topic-pages.json');
  const data = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
  
  return data.map((topic: any) => ({
    params: { cluster_id: topic.cluster_id },
    props: { topic }
  }));
}

const { topic } = Astro.props;

// Re-use theme mapping
const conceptThemes: Record<string, { color: string; label: string }> = {
  "c1": { color: "var(--color-security)", label: "SECURITY & GUARD" },
  "c2": { color: "var(--color-network)", label: "NETWORK & TRAFFIC" },
  "c3": { color: "var(--color-compute)", label: "COMPUTE & RUN" },
  "c4": { color: "var(--color-storage)", label: "STORAGE & DATA" },
  "c5": { color: "var(--color-database)", label: "DATABASES & QUERY" },
  "c6": { color: "var(--color-decouple)", label: "DECOUPLE & OPERATE" }
};

const theme = conceptThemes[topic.concept_id] || { color: "var(--color-network)", label: topic.concept_id.toUpperCase() };
---

<BaseLayout title={`${topic.cluster_title} | AWS Services`}>
  <div class="topic-container">
    <div class="nav-bar-mini">
      <a href="/concepts" class="back-link">← Taxonomy</a>
      <span class="topic-tag" style={`border-color: ${theme.color}; color: ${theme.color};`}>
        {theme.label}
      </span>
    </div>

    <header class="topic-hero">
      <h1 class="topic-header-title">{topic.cluster_title}</h1>
      <p class="topic-description">
        Master these services individually to conquer the {topic.exam_domains.join(', ')} domains.
      </p>
    </header>

    <!-- SERVICE BY SERVICE DRILL -->
    <section class="services-drill">
      <h2 class="section-heading">Service Deep-Dive</h2>
      <div class="service-cards-stack">
        {topic.core_services.map((svc: any) => {
          const serviceId = svc.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
          return (
            <a href={`/services/${serviceId}`} class="service-card-link" style={`--card-theme: ${theme.color};`}>
              <div class="service-card">
                <div class="service-header">
                  <h3 class="service-name">{svc.name}</h3>
                  <span class="view-details">View Deep Dive →</span>
                </div>
                <p class="service-job">{svc.job}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- EXAM TACTICS -->
    <section class="tactics-section">
      <h2 class="section-heading">Exam Tactics & Signals</h2>
      
      <div class="tactics-grid">
        <!-- Signal Words -->
        <div class="tactic-card glass-card">
          <h3>Keyword Mapping</h3>
          <ul class="signal-list">
            {topic.signal_words.map((sw: any) => (
              <li>
                <span class="signal-phrase">"{sw.phrase}"</span>
                <span class="signal-arrow" style={`color: ${theme.color};`}>→</span>
                <span class="signal-target">{sw.points_to}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Comparisons -->
        <div class="tactic-card glass-card">
          <h3>Service vs Service</h3>
          <ul class="comparison-list">
            {topic.comparisons.map((comp: string) => {
              const [services, explanation] = comp.split(': ');
              return (
                <li>
                  <strong class="comp-title" style={`color: ${theme.color};`}>{services}</strong>
                  <p class="comp-desc">{explanation || comp}</p>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </section>

    <!-- EXAM MOVES (Summary) -->
    <section class="moves-section glass-card" style={`border-top: 4px solid ${theme.color};`}>
      <h2>Final Exam Moves</h2>
      <ul class="moves-list">
        {topic.exam_moves.map((move: string) => (
          <li>{move}</li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .topic-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1rem 5rem;
  }
  
  .nav-bar-mini {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3rem;
  }
  
  .back-link {
    color: var(--text-secondary);
    font-weight: 700;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  
  .back-link:hover {
    color: var(--text-primary);
  }
  
  .topic-tag {
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.35rem 0.85rem;
    border: 1px solid;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    letter-spacing: 0.05em;
  }

  .topic-hero {
    text-align: center;
    margin-bottom: 4rem;
  }
  
  .topic-header-title {
    font-size: 3rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 1rem;
    line-height: 1.1;
  }
  
  .topic-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .section-heading {
    font-size: 1.75rem;
    font-weight: 900;
    margin-bottom: 2rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  /* SERVICE CARDS */
  .service-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 4rem;
  }
  
  .service-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  
  .service-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-left: 4px solid var(--card-theme);
    border-radius: 8px;
    padding: 1.5rem 2rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .service-card-link:hover .service-card {
    transform: translateX(4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
    border-color: var(--card-theme);
  }
  
  .service-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  
  .service-name {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--text-primary);
  }

  .view-details {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--card-theme);
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.2s;
  }

  .service-card-link:hover .view-details {
    opacity: 1;
    transform: translateX(0);
  }
  
  .service-job {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* TACTICS SECTION */
  .tactics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }
  
  @media (max-width: 768px) {
    .tactics-grid {
      grid-template-columns: 1fr;
    }
  }
  
  .tactic-card {
    padding: 2rem;
  }
  
  .tactic-card h3 {
    font-size: 1.35rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .signal-list, .comparison-list, .moves-list {
    list-style: none;
  }
  
  .signal-list li {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  
  .signal-list li:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  
  .signal-phrase {
    font-weight: 600;
    color: var(--text-secondary);
    font-style: italic;
    margin-bottom: 0.25rem;
  }
  
  .signal-arrow {
    font-weight: 900;
    margin: 0.15rem 0;
  }
  
  .signal-target {
    font-weight: 800;
    color: var(--text-primary);
  }

  .comparison-list li {
    margin-bottom: 1.5rem;
  }
  
  .comp-title {
    display: block;
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }
  
  .comp-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* MOVES SECTION */
  .moves-section {
    padding: 2.5rem;
  }
  
  .moves-section h2 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
  }
  
  .moves-list li {
    position: relative;
    padding-left: 1.75rem;
    margin-bottom: 1rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  
  .moves-list li::before {
    content: '⚡';
    position: absolute;
    left: 0;
    top: 0.1rem;
  }
</style>
