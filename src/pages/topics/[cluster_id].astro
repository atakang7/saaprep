---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const filePath = path.join(process.cwd(), 'topic-pages.json');
  const data = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
  
  return data.map((topic: any) => ({
    params: { cluster_id: topic.cluster_id },
    props: { topic }
  }));
}

const { topic } = Astro.props;

// Re-use theme mapping
const conceptThemes: Record<string, { color: string; label: string; icon: string }> = {
  "c1": { color: "var(--color-security)", label: "SECURITY & GUARD", icon: "🛡️" },
  "c2": { color: "var(--color-network)", label: "NETWORK & TRAFFIC", icon: "🌐" },
  "c3": { color: "var(--color-compute)", label: "COMPUTE & RUN", icon: "⚡" },
  "c4": { color: "var(--color-storage)", label: "STORAGE & DATA", icon: "📦" },
  "c5": { color: "var(--color-database)", label: "DATABASES & QUERY", icon: "🗄️" },
  "c6": { color: "var(--color-decouple)", label: "DECOUPLE & OPERATE", icon: "🔄" }
};

const theme = conceptThemes[topic.concept_id] || { color: "var(--color-network)", label: topic.concept_id.toUpperCase(), icon: "✦" };
---

<BaseLayout title={`${topic.cluster_title} - SAA-C03 Architectural Cluster`}>
  <div class="topic-page-wrapper">
    
    <!-- BREADCRUMB NAV -->
    <nav class="topic-breadcrumb">
      <a href="/concepts">← Taxonomy Tree</a>
      <span class="sep">/</span>
      <span class="current">{topic.cluster_title}</span>
    </nav>

    <!-- HERO SECTION -->
    <header class="topic-hero glass-card" style={`border-top: 4px solid ${theme.color};`}>
      <div class="hero-top">
        <span class="hero-icon" style={`color: ${theme.color}; border-color: ${theme.color};`}>
          {theme.icon}
        </span>
        <div class="hero-meta">
          <span class="category-chip" style={`border-color: ${theme.color}; color: ${theme.color};`}>
            {theme.label}
          </span>
          <span class="concept-name">{topic.concept_name}</span>
        </div>
      </div>

      <h1 class="topic-title">{topic.cluster_title}</h1>
      
      <div class="domains-chips">
        {topic.exam_domains.map((d: string) => (
          <span class="domain-pill">{d} Domain</span>
        ))}
      </div>
    </header>

    <!-- WHAT THIS TESTS (EXAM BLUEPRINT) -->
    <section class="topic-section">
      <h2 class="section-title">
        <span class="accent-bar" style={`background: ${theme.color};`}></span>
        What The SAA-C03 Tests On This Topic
      </h2>

      <div class="blueprint-card glass-card">
        <ul class="blueprint-list">
          {topic.what_this_tests.map((point: string, idx: number) => (
            <li>
              <span class="bp-num">0{idx + 1}</span>
              <span class="bp-text">{point}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CORE SERVICES DEEP DIVE DIRECTORY -->
    <section class="topic-section">
      <h2 class="section-title">
        <span class="accent-bar" style="background: var(--color-compute);"></span>
        Core AWS Services In This Cluster
      </h2>

      <div class="services-stack">
        {topic.core_services.map((svc: any) => {
          const serviceId = svc.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
          return (
            <a href={`/services/${serviceId}`} class="svc-card-link">
              <div class="svc-card glass-card" style={`border-left: 4px solid ${theme.color};`}>
                <div class="svc-card-header">
                  <h3>{svc.name}</h3>
                  <span class="deep-dive-btn" style={`color: ${theme.color};`}>View Service Blueprint →</span>
                </div>
                <p class="svc-card-job">{svc.job}</p>
                <div class="svc-rules-preview">
                  <div class="preview-rule choose">
                    <strong>✓ Choose:</strong> {svc.choose_when}
                  </div>
                  <div class="preview-rule avoid">
                    <strong>✕ Avoid:</strong> {svc.avoid_when}
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- KEYWORD SIGNALS & TRAPS TABLE -->
    <section class="topic-section">
      <h2 class="section-title">
        <span class="accent-bar" style="background: var(--color-storage);"></span>
        Exam Keyword Mapping & Signals
      </h2>

      <div class="signals-card glass-card">
        <div class="signals-grid">
          {topic.signal_words.map((sw: any) => (
            <div class="signal-item">
              <div class="signal-phrase">"{sw.phrase}"</div>
              <div class="signal-arrow" style={`color: ${theme.color};`}>↓ Points directly to</div>
              <div class="signal-target">{sw.points_to}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- COMPARISONS & EXAM MOVES -->
    <div class="tactics-dual-grid">
      <!-- COMPARISONS -->
      <section class="topic-section">
        <h2 class="section-title">
          <span class="accent-bar" style={`background: ${theme.color};`}></span>
          Service vs Service
        </h2>
        <div class="tactics-card glass-card">
          <ul class="comp-list">
            {topic.comparisons.map((comp: string) => {
              const parts = comp.split(': ');
              return (
                <li>
                  <strong style={`color: ${theme.color};`}>{parts[0]}</strong>
                  <p>{parts[1] || comp}</p>
                </li>
              );
            })}
          </ul>
        </div>
      </section>

      <!-- EXAM MOVES -->
      <section class="topic-section">
        <h2 class="section-title">
          <span class="accent-bar" style="background: var(--color-database);"></span>
          High-Yield Exam Moves
        </h2>
        <div class="tactics-card glass-card">
          <ul class="moves-list">
            {topic.exam_moves.map((move: string) => (
              <li>
                <span class="move-icon">⚡</span>
                <span>{move}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>

    <!-- BOTTOM PRACTICE CTA -->
    <div class="bottom-cta-banner glass-card" style={`border-color: ${theme.color};`}>
      <div>
        <h3>Mastered {topic.cluster_title}?</h3>
        <p>Put your knowledge to the test in the interactive practice simulator.</p>
      </div>
      <a href="/practice" class="btn-primary" style={`background: ${theme.color};`}>Start Practice Arena →</a>
    </div>

  </div>
</BaseLayout>

<style>
  .topic-page-wrapper {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem 1rem 5rem;
  }

  .topic-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .topic-breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
  }

  .topic-breadcrumb a:hover {
    color: var(--text-primary);
  }

  .topic-breadcrumb .sep {
    color: var(--text-muted);
  }

  .topic-breadcrumb .current {
    color: var(--text-primary);
    font-weight: 700;
  }

  /* HERO */
  .topic-hero {
    padding: 2.5rem;
    margin-bottom: 3rem;
    border-radius: 16px;
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .hero-icon {
    font-size: 1.5rem;
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    border: 1px solid;
    background: rgba(255, 255, 255, 0.04);
  }

  .hero-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .category-chip {
    font-size: 0.7rem;
    font-weight: 900;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    border: 1px solid;
    letter-spacing: 0.05em;
  }

  .concept-name {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .topic-title {
    font-size: 3rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .domains-chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .domain-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-secondary);
  }

  /* SECTIONS */
  .topic-section {
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .accent-bar {
    width: 4px;
    height: 24px;
    border-radius: 2px;
  }

  /* BLUEPRINT */
  .blueprint-card {
    padding: 2rem;
  }

  .blueprint-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .blueprint-list li {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .bp-num {
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .bp-text {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* SERVICES STACK */
  .services-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .svc-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .svc-card {
    padding: 1.75rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .svc-card-link:hover .svc-card {
    transform: translateX(4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
  }

  .svc-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .svc-card-header h3 {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--text-primary);
  }

  .deep-dive-btn {
    font-size: 0.85rem;
    font-weight: 800;
  }

  .svc-card-job {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .svc-rules-preview {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .svc-rules-preview {
      grid-template-columns: 1fr;
    }
  }

  .preview-rule {
    padding: 0.75rem;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.3);
  }

  .preview-rule.choose {
    border-left: 3px solid var(--color-database);
    color: var(--text-secondary);
  }

  .preview-rule.choose strong {
    color: var(--color-database);
  }

  .preview-rule.avoid {
    border-left: 3px solid var(--color-security);
    color: var(--text-secondary);
  }

  .preview-rule.avoid strong {
    color: var(--color-security);
  }

  /* SIGNALS GRID */
  .signals-card {
    padding: 2rem;
  }

  .signals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .signal-item {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--border-subtle);
    padding: 1.25rem;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .signal-phrase {
    font-style: italic;
    font-weight: 600;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .signal-arrow {
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.05em;
  }

  .signal-target {
    font-weight: 900;
    color: var(--text-primary);
    font-size: 1.05rem;
  }

  /* DUAL TACTICS GRID */
  .tactics-dual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .tactics-dual-grid {
      grid-template-columns: 1fr;
    }
  }

  .tactics-card {
    padding: 1.75rem;
  }

  .comp-list, .moves-list {
    list-style: none;
  }

  .comp-list li {
    margin-bottom: 1.25rem;
  }

  .comp-list strong {
    display: block;
    font-size: 1.05rem;
    margin-bottom: 0.25rem;
  }

  .comp-list p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .moves-list li {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .move-icon {
    color: var(--color-database);
  }

  /* BOTTOM CTA */
  .bottom-cta-banner {
    padding: 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-width: 2px;
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .bottom-cta-banner {
      flex-direction: column;
      text-align: center;
    }
  }

  .bottom-cta-banner h3 {
    font-size: 1.5rem;
    font-weight: 900;
    margin-bottom: 0.35rem;
  }

  .bottom-cta-banner p {
    color: var(--text-secondary);
  }

  .btn-primary {
    padding: 0.85rem 1.75rem;
    border-radius: 8px;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s, opacity 0.15s;
  }

  .btn-primary:hover {
    transform: scale(1.03);
    opacity: 0.95;
  }
</style>
