---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTopics, getCanonicalServiceId } from '../../lib/data';
import { absoluteUrl, breadcrumbJsonLd, normalizeSiteUrl, sitePath, topicDescription } from '../../lib/seo';
import { getTopicSlug } from '../../lib/data';

export async function getStaticPaths() {
  const data = getAllTopics();
  const paths: any[] = [];
  
  data.forEach((topic: any) => {
    paths.push({
      params: { cluster_id: topic.cluster_id },
      props: { topic, isCanonical: false }
    });
    
    paths.push({
      params: { cluster_id: getTopicSlug(topic.cluster_title) },
      props: { topic, isCanonical: true }
    });
  });
  
  return paths;
}

const { topic, isCanonical } = Astro.props;
const siteUrl = normalizeSiteUrl(Astro.site);
const canonicalPath = `/topics/${getTopicSlug(topic.cluster_title)}`;
const description = topicDescription(topic);

// Re-use theme mapping
const conceptThemes: Record<string, { color: string; label: string }> = {
  "c1": { color: "var(--color-security)", label: "SECURITY & GUARD" },
  "c2": { color: "var(--color-network)", label: "NETWORK & TRAFFIC" },
  "c3": { color: "var(--color-compute)", label: "COMPUTE & RUN" },
  "c4": { color: "var(--color-storage)", label: "STORAGE & DATA" },
  "c5": { color: "var(--color-database)", label: "DATABASES & QUERY" },
  "c6": { color: "var(--color-decouple)", label: "DECOUPLE & OPERATE" }
};

const theme = conceptThemes[topic.concept_id] || { color: "var(--color-network)", label: topic.concept_id.toUpperCase() };

const structuredData = [
  breadcrumbJsonLd(
    [
      { name: 'SAA-C03 Exam Taxonomy', url: '/concepts' },
      { name: topic.cluster_title, url: canonicalPath }
    ],
    siteUrl
  ),
  {
    '@context': 'https://schema.org',
    '@type': ['LearningResource', 'CollectionPage'],
    name: `${topic.cluster_title} SAA-C03 Study Guide`,
    url: absoluteUrl(canonicalPath, siteUrl),
    description,
    educationalUse: 'Certification exam preparation',
    learningResourceType: 'Topic study guide',
    about: [
      {
        '@type': 'DefinedTerm',
        name: topic.concept_name
      },
      {
        '@type': 'DefinedTerm',
        name: 'AWS Certified Solutions Architect - Associate SAA-C03'
      }
    ],
    teaches: topic.what_this_tests,
    hasPart: topic.core_services.map((service: any) => ({
      '@type': 'TechArticle',
      name: service.name,
      url: absoluteUrl(`/services/${getCanonicalServiceId(service.name)}/`, siteUrl)
    }))
  }
];
---

<BaseLayout
  title={`${topic.cluster_title} for AWS SAA-C03 | SAA Prep`}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  pageType="CollectionPage"
  structuredData={structuredData}
>
  <div class="clean-page">
    
    <!-- BREADCRUMB -->
    <nav class="clean-breadcrumb">
      <a href={sitePath('/concepts')}>Taxonomy Tree</a>
      <span class="sep">/</span>
      <span class="current">{topic.cluster_title}</span>
    </nav>

    <!-- HEADER -->
    <header class="clean-hero">
      <div class="hero-tags">
        <span class="pill-badge" style={`color: ${theme.color}; background: rgba(255,255,255,0.04);`}>
          {theme.label}
        </span>
        <span class="concept-label">{topic.concept_name}</span>
      </div>

      <h1 class="hero-title">{topic.cluster_title}</h1>
      
      <div class="domains-chips">
        {topic.exam_domains.map((d: string) => (
          <span class="domain-tag">{d} Domain</span>
        ))}
      </div>
    </header>

    <!-- CORE SERVICES ROUTING DIRECTORY -->
    <section class="content-block">
      <h2 class="block-heading">// ROUTE TO THE RIGHT SERVICE</h2>

      <div class="compact-service-grid">
        {topic.core_services.map((svc: any) => {
          const serviceId = getCanonicalServiceId(svc.name);
          return (
            <a href={sitePath(`/services/${serviceId}`)} class="compact-service-link">
              <span class="svc-name">{svc.name}</span>
              <span class="svc-role">{svc.job}</span>
              <span class="svc-action" style={`color: ${theme.color};`}>Open →</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- KEYWORD SIGNALS -->
    <section class="content-block compact-block">
      <h2 class="block-heading">// FAST ROUTING SIGNALS</h2>

      <div class="signals-list">
        {topic.signal_words.slice(0, 6).map((sw: any) => (
          <div class="signal-row">
            <span class="phrase">"{sw.phrase}"</span>
            <span class="arrow" style={`color: ${theme.color};`}>→</span>
            <span class="target">{sw.points_to}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- BOTTOM ACTION -->
    <div class="bottom-action">
      <div>
        <h3>Mastered {topic.cluster_title}?</h3>
        <p>Test your knowledge in the interactive practice simulator.</p>
      </div>
      <a href={sitePath('/practice')} class="btn-action" style={`background: ${theme.color};`}>Start Practice →</a>
    </div>

  </div>
</BaseLayout>

<style>
  .clean-page {
    max-width: 920px;
    margin: 0 auto;
    padding: 1rem 0 4rem;
  }

  .clean-breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }

  .clean-breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
  }

  .clean-breadcrumb .sep {
    color: var(--text-muted);
  }

  .clean-breadcrumb .current {
    color: var(--text-primary);
    font-weight: 700;
  }

  /* HERO */
  .clean-hero {
    margin-bottom: 3.5rem;
  }

  .hero-tags {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .pill-badge {
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
  }

  .concept-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 900;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .domains-chips {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .domain-tag {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.25rem 0.65rem;
    font-family: var(--font-mono);
  }

  /* CONTENT BLOCKS */
  .content-block {
    margin-bottom: 3.5rem;
  }

  .block-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .block-heading {
    font-size: 1.25rem;
    font-weight: 900;
    font-family: var(--font-mono);
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .mono-badge {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .compact-service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.02);
  }

  .compact-service-link {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "name action"
      "role action";
    gap: 0.25rem 1rem;
    min-height: 92px;
    padding: 1rem;
    border-right: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    color: inherit;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .compact-service-link:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.22);
  }

  .svc-name {
    grid-area: name;
    color: var(--text-primary);
    font-size: 0.98rem;
    font-weight: 850;
    line-height: 1.25;
  }

  .svc-role {
    grid-area: role;
    color: var(--text-secondary);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .svc-action {
    grid-area: action;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 900;
    white-space: nowrap;
  }

  .compact-block {
    margin-bottom: 2.25rem;
  }

  /* CLUSTER DIAGRAM PANEL */
  .cluster-diagram-panel {
    background: #090a0d;
    border: 1px solid var(--border-subtle);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cluster-flow-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .cluster-node-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    padding: 1rem;
  }

  .node-badge {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    font-weight: 900;
    color: var(--color-network);
    margin-bottom: 0.4rem;
  }

  .node-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .node-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .ascii-pipeline-box {
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
  }

  .ascii-lbl {
    font-size: 0.6rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-weight: 900;
    margin-bottom: 0.5rem;
  }

  .ascii-code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    background: #040507;
    padding: 1rem;
    border: 1px solid var(--border-subtle);
    overflow-x: auto;
    line-height: 1.5;
  }

  /* BLUEPRINT */
  .blueprint-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .blueprint-row {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .blueprint-row .num {
    font-size: 1rem;
    font-weight: 900;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .blueprint-row p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* SERVICES LIST */
  .services-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .svc-row-link {
    display: block;
    background: rgba(255, 255, 255, 0.02);
    padding: 1.5rem;
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    color: inherit;
  }

  .svc-row-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .svc-row-header h3 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .link-arrow {
    font-size: 0.85rem;
    font-weight: 800;
    font-family: var(--font-mono);
  }

  .svc-job {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .rules-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .rules-row {
      grid-template-columns: 1fr;
    }
  }

  .rule-chip {
    padding: 0.65rem 0.85rem;
    background: rgba(0, 0, 0, 0.3);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }

  .rule-chip.choose strong { color: var(--color-database); }
  .rule-chip.avoid strong { color: var(--color-security); }

  /* VERIFIED AWS FACTS */
  .verified-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .verified-list li {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-secondary);
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .verified-badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    border: 1px solid currentColor;
    padding: 0.1rem 0.3rem;
    flex-shrink: 0;
  }

  /* OFFICIAL SOURCES */
  .sources-note {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .sources-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sources-list a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.85rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--border-subtle);
    border-left-width: 3px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .sources-list a:hover {
    background: rgba(0, 0, 0, 0.5);
  }

  .src-title {
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .src-url {
    font-size: 0.72rem;
    color: var(--text-secondary);
    word-break: break-all;
  }

  /* SIGNALS */
  .signals-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .signal-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.02);
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--border-subtle);
    font-size: 0.95rem;
  }

  .signal-row .phrase {
    font-style: italic;
    color: var(--text-secondary);
    flex: 1;
  }

  .signal-row .arrow {
    font-weight: 900;
    font-family: var(--font-mono);
  }

  .signal-row .target {
    font-weight: 800;
    color: var(--text-primary);
    flex: 1;
    font-family: var(--font-mono);
  }

  /* DUAL BLOCK */
  .dual-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .dual-block {
      grid-template-columns: 1fr;
    }
  }

  .comp-stack, .moves-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .comp-item strong {
    display: block;
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .comp-item p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .move-item {
    display: flex;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .move-item .icon {
    color: var(--color-database);
  }

  /* BOTTOM ACTION */
  .bottom-action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .bottom-action {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .bottom-action h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .bottom-action p {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .btn-action {
    padding: 0.75rem 1.5rem;
    color: #ffffff;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    font-family: var(--font-mono);
  }
</style>
