---
import { ArrowLeft, BookOpen, Target } from "lucide-astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  accentFor,
  conceptStyles,
  contentFor,
  explanationFor,
  getQuestionsForTopic,
  inlineMarkdown,
  summaryFor,
  topics,
} from "../../lib/data";

export function getStaticPaths() {
  return topics.map((topic) => ({
    params: { cluster_id: topic.cluster_id },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const accent = accentFor(topic.concept_id);
const concept = conceptStyles[topic.concept_id] ?? conceptStyles.c1;
const practice = getQuestionsForTopic(topic);
const content = contentFor(topic.cluster_id);
---

<BaseLayout title={topic.cluster_title}>
  <div style={`--accent: ${accent};`}>
    <!-- ═══ Hero ═══ -->
    <section class="topic-hero page-hero">
      <div class="hero-grid-bg"></div>
      <div class="hero-glow" style={`width:500px;height:500px;top:-25%;right:10%;background:${accent};`}></div>

      <div class="page-narrow topic-hero-inner">
        <a class="back-btn" href={`/concepts/${topic.concept_id}/`}>
          <ArrowLeft size={16} /> {concept.label}
        </a>

        <div class="animate-in">
          <span class="eyebrow" style={`color: ${accent};`}>{concept.label}</span>
          <h1 class="topic-hero-title">{topic.cluster_title}</h1>
          <p class="topic-hero-lead">{summaryFor(topic)}</p>
        </div>

        <div class="topic-hero-meta animate-in animate-in-delay-1">
          <span class="chip chip-accent">
            <BookOpen size={14} /> Topic
          </span>
          {practice.length > 0 && (
            <a href="#practice" class="chip chip-accent" style="cursor:pointer;">
              <Target size={14} /> {practice.length} Questions ↓
            </a>
          )}
        </div>
      </div>
    </section>

    <!-- ═══ Content ═══ -->
    <article class="topic-content">
      <div class="page-narrow">
        {content ? (
          <div class="markdown-body">
            <h2 id="core-concept">1. Core Concept</h2>
            <ul>
              {content.core_concept.map((paragraph) => (
                <li><span set:html={inlineMarkdown(paragraph)} /></li>
              ))}
            </ul>

            <h2 id="key-services">2. Key Services & Features</h2>
            <ul>
              {content.hard_facts.map((item) => (
                <li>
                  <strong>{item.name}:</strong>
                  <ul>
                    {item.facts.map((point) => (
                      <li set:html={inlineMarkdown(point)} />
                    ))}
                  </ul>
                </li>
              ))}
            </ul>

            <h2 id="architecture-rules">3. Architecture Rules</h2>
            <ul>
              {content.architecture_rules.map((rule) => (
                <li set:html={inlineMarkdown(rule)} />
              ))}
            </ul>

            <h2 id="scenarios">4. Scenarios & Use Cases</h2>
            <ul>
              {content.when_to_choose.map((item) => (
                <li>
                  <strong>{item.scenario}</strong>
                  <ul>
                    <li><strong>Choose:</strong> <code class="highlight">{item.choice}</code></li>
                    <li><strong>Why:</strong> <span class="muted">{item.why}</span></li>
                  </ul>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <div class="markdown-body">
            <div class="empty">
              <p>This topic hasn't been migrated to the new content format yet.</p>
            </div>
          </div>
        )}

        <!-- ═══ Practice Questions ═══ -->
        {practice.length > 0 && (
          <section id="practice" class="practice-section">
            <div class="practice-header">
              <div>
                <h2>Practice Questions</h2>
                <p class="muted">Test your knowledge with {practice.length} exam-pattern questions on this topic.</p>
              </div>
              <span class="chip chip-accent">{practice.length}</span>
            </div>

            <div class="stack">
              {practice.map((question, position) => {
                const explanation = explanationFor(question);
                const correct = new Set(question.answer?.labels ?? []);
                return (
                  <details class="qa-block">
                    <summary class="qa-summary">
                      <span class="qa-num">Q{position + 1}</span>
                      <span class="qa-text">{question.question}</span>
                    </summary>
                    <div class="qa-details">
                      <ul class="qa-options">
                        {question.options.map((option) => (
                          <li class={correct.has(option.label) ? "is-correct" : ""}>
                            <strong>{option.label}</strong> {option.text}
                          </li>
                        ))}
                      </ul>
                      <div class="qa-answer">
                        <strong>Answer: {question.answer?.labels.join(", ")}</strong>
                        {explanation && <p class="qa-explain">{explanation}</p>}
                      </div>
                      <a class="qa-link" href={`/questions/${question.id}/`}>Open isolated question ↗</a>
                    </div>
                  </details>
                );
              })}
            </div>
          </section>
        )}
      </div>
    </article>
  </div>

  <style>
    .topic-hero {
      padding-top: 10rem;
      padding-bottom: 4rem;
    }

    .topic-hero-inner {
      position: relative;
      z-index: 2;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--muted);
      font-size: 0.88rem;
      font-weight: 500;
      margin-bottom: 2rem;
      transition: color 0.2s;
    }
    .back-btn:hover { color: var(--accent); }

    .topic-hero-title {
      font-size: clamp(2rem, 5vw, 3rem);
      margin-bottom: 1rem;
    }

    .topic-hero-lead {
      font-size: 1.2rem;
      line-height: 1.6;
      color: var(--muted);
      max-width: 700px;
    }

    .topic-hero-meta {
      display: flex;
      gap: 10px;
      margin-top: 2rem;
    }

    .topic-content {
      padding: 3rem 0 6rem;
    }

    .practice-section {
      margin-top: 4rem;
      padding-top: 3rem;
      border-top: 1px solid var(--line);
    }

    .practice-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 2rem;
    }

    .practice-header h2 {
      margin-bottom: 0.5rem;
    }
  </style>
</BaseLayout>
