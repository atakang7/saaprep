---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTaxonomyTree, getTaxonomyEntryHref, normalizeServiceId } from '../lib/data';
import { absoluteUrl, normalizeSiteUrl, sitePath } from '../lib/seo';

const taxonomy = getTaxonomyTree();
const concepts = taxonomy.level_2_and_3.concepts;
const siteUrl = normalizeSiteUrl(Astro.site);
const clusterCount = concepts.reduce((sum: number, concept: any) => sum + concept.clusters.length, 0);
const serviceCount = new Set(
  concepts.flatMap((concept: any) =>
    concept.clusters.flatMap((cluster: any) => cluster.services.map((serviceName: string) => normalizeServiceId(serviceName)))
  )
).size;
const description = `Browse the AWS SAA-C03 exam taxonomy across ${concepts.length} architecture domains, ${clusterCount} topic clusters, and ${serviceCount} core AWS services.`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AWS SAA-C03 Architecture Taxonomy',
  description,
  url: absoluteUrl('/concepts', siteUrl),
  itemListElement: concepts.map((concept: any, index: number) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: concept.name,
    item: {
      '@type': 'DefinedTermSet',
      name: concept.name,
      hasDefinedTerm: concept.clusters.map((cluster: any) => ({
        '@type': 'DefinedTerm',
        name: cluster.name,
        url: absoluteUrl(`/topics/${cluster.id}`, siteUrl)
      }))
    }
  }))
};

// Concept theme colors
const conceptThemes: Record<string, { color: string; label: string; icon: string }> = {
  "c1": { color: "#ff2a70", label: "SECURITY, GUARD & IDENTITY", icon: "🛡️" },
  "c2": { color: "#00e5ff", label: "NETWORK, TRAFFIC & INGRESS", icon: "⚡" },
  "c3": { color: "#a855f7", label: "COMPUTE & WORKLOAD EXECUTION", icon: "⚙️" },
  "c4": { color: "#f59e0b", label: "STORAGE & DATA PERSISTENCE", icon: "📦" },
  "c5": { color: "#10b981", label: "DATABASE & ANALYTICS CLUSTER", icon: "🗄️" },
  "c6": { color: "#ec4899", label: "DECOUPLING & ASYNC EVENT BUS", icon: "🔄" }
};
---

<BaseLayout
  title="AWS SAA-C03 Exam Taxonomy by Architecture Domain | SAA Prep"
  description={description}
  canonicalPath="/concepts"
  pageType="CollectionPage"
  structuredData={structuredData}
>
  <div class="pure-tree-container">
    
    <!-- PURE TREE CANVAS (NO PAGE HEADER/TITLES) -->
    <div class="compact-canvas">
      
      <!-- ROOT NODE -->
      <div class="tree-root-bar">
        <span class="tb-badge">ROOT</span>
        <h1 class="tb-title">🌲 SAA-C03 ARCHITECTURAL EXAM TAXONOMY</h1>
      </div>

      <!-- COMPACT BRANCHES LIST -->
      <div class="tree-branches-list">
        {concepts.map((concept: any, cIdx: number) => {
          const theme = conceptThemes[concept.id] || { color: "#00e5ff", label: concept.id.toUpperCase(), icon: "✦" };
          const isLastConcept = cIdx === concepts.length - 1;

          return (
            <div class="compact-branch-block">
              
              <!-- CONCEPT LEVEL 1 BRANCH HEADER -->
              <div class="c-head-row">
                <span class="c-symbol">{isLastConcept ? '└──' : '├──'}</span>
                <div class="c-pill" style={`border-left: 3px solid ${theme.color};`}>
                  <span class="cp-icon">{theme.icon}</span>
                  <span class="cp-num">D0{cIdx + 1}</span>
                  <span class="cp-label" style={`color: ${theme.color};`}>{theme.label}</span>
                </div>
              </div>

              <!-- LEVEL 2 CLUSTERS & LEVEL 3 SERVICES -->
              <div class="c-children-list">
                {concept.clusters.map((cluster: any, clIdx: number) => {
                  const isLastCluster = clIdx === concept.clusters.length - 1;

                  return (
                    <div class="cluster-row-block">
                      <div class="cl-head">
                        <span class="indent-code">│  </span>
                        <span class="cl-symbol">{isLastCluster ? '└──' : '├──'}</span>
                        <a href={sitePath(`/topics/${cluster.id}`)} class="cl-box">
                          <span class="cl-name">{cluster.name}</span>
                          <span class="cl-tag">TOPIC →</span>
                        </a>
                      </div>

                      <div class="leaves-inline-wrap">
                        <span class="indent-code">│  </span>
                        <span class="indent-code">{isLastCluster ? '   ' : '│  '}</span>
                        <span class="leaf-symbol">└──</span>
                        <div class="leaves-row">
                          {cluster.services.map((svcName: string) => {
                            const svcUrl = getTaxonomyEntryHref(svcName, cluster.id);
                            return (
                              <a href={sitePath(svcUrl)} class="leaf-chip">
                                <span class="leaf-dot" style={`background: ${theme.color};`}></span>
                                <span>{svcName}</span>
                              </a>
                            );
                          })}
                        </div>
                      </div>

                    </div>
                  );
                })}
              </div>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</BaseLayout>

<style>
  .pure-tree-container {
    width: 100%;
    padding: 0;
  }

  /* CANVAS */
  .compact-canvas {
    background: #06070a;
    border: 1px solid #1c1f2c;
    border-radius: 8px;
    padding: 0.7rem;
    font-family: var(--font-mono);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .tree-root-bar {
    background: #0d0f17;
    border: 1px solid var(--color-network);
    border-radius: 6px;
    padding: 0.4rem 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .tb-badge {
    font-size: 0.55rem;
    font-weight: 900;
    background: var(--color-network);
    color: #000;
    padding: 0.1rem 0.35rem;
  }

  .tb-title {
    font-size: 0.9rem;
    font-weight: 900;
    color: #ffffff;
    margin: 0;
  }

  .tree-branches-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(430px, 1fr));
    gap: 0.6rem;
    align-items: start;
  }

  @media (max-width: 720px) {
    .tree-branches-list {
      grid-template-columns: 1fr;
    }
  }

  .compact-branch-block {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: #090b11;
    border: 1px solid #191d29;
    border-radius: 6px;
    padding: 0.5rem 0.55rem 0.6rem;
  }

  /* Branches sit side by side now, so the top-level connector
     glyph no longer joins anything vertically. */
  .c-symbol {
    display: none;
  }

  .c-head-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .c-symbol {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 900;
  }

  .c-pill {
    background: #0f121d;
    border: 1px solid #252a3b;
    border-radius: 4px;
    padding: 0.32rem 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  .cp-icon {
    font-size: 0.85rem;
  }

  .cp-num {
    font-size: 0.6rem;
    color: var(--text-muted);
    font-weight: 900;
  }

  .cp-label {
    font-size: 0.78rem;
    font-weight: 900;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .c-children-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cluster-row-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cl-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .indent-code {
    color: #2a3040;
    font-size: 0.78rem;
    white-space: pre;
    font-weight: 900;
    flex-shrink: 0;
  }

  .cl-symbol {
    color: #2a3040;
    font-size: 0.78rem;
    font-weight: 900;
    flex-shrink: 0;
  }

  .cl-box {
    background: #141824;
    border: 1px solid #283044;
    border-radius: 4px;
    padding: 0.28rem 0.55rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .cl-box:hover {
    background: #1a2030;
    border-color: #37415a;
  }

  .cl-name {
    font-size: 0.76rem;
    font-weight: 800;
    color: #ffffff;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cl-tag {
    font-size: 0.55rem;
    color: var(--text-secondary);
    font-weight: 800;
    flex-shrink: 0;
  }

  .leaves-inline-wrap {
    display: flex;
    align-items: flex-start;
    gap: 0.3rem;
  }

  .leaf-symbol {
    color: #2a3040;
    font-size: 0.75rem;
    font-weight: 900;
    flex-shrink: 0;
  }

  .leaves-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    min-width: 0;
  }

  .leaf-chip {
    background: #181d2c;
    border: 1px solid #283046;
    border-radius: 999px;
    padding: 0.18rem 0.5rem;
    text-decoration: none;
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    line-height: 1.4;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  .leaf-chip:hover {
    background: #212838;
    border-color: #3b4661;
    transform: translateY(-1px);
  }

  .leaf-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }
</style>
