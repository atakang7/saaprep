---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTaxonomyTree } from '../lib/data';

const taxonomy = getTaxonomyTree();
const concepts = taxonomy.level_2_and_3.concepts;

// Semantic theme color assignment for concept groups
const conceptThemes: Record<string, { color: string; label: string }> = {
  "c1": { color: "var(--color-security)", label: "SECURITY & GUARD" },
  "c2": { color: "var(--color-network)", label: "NETWORK & TRAFFIC" },
  "c3": { color: "var(--color-compute)", label: "COMPUTE & RUN" },
  "c4": { color: "var(--color-storage)", label: "STORAGE & DATA" },
  "c5": { color: "var(--color-database)", label: "DATABASES & QUERY" },
  "c6": { color: "var(--color-decouple)", label: "DECOUPLE & OPERATE" }
};
---

<BaseLayout title="Taxonomy Tree | SAA-C03 UNICORN">
  <div class="taxonomy-header">
    <div class="header-badge">DECISION TAXONOMY</div>
    <h1 class="header-title">
      Architectural <span class="text-gradient">Service Clusters</span>
    </h1>
    <p class="header-sub">
      Categorized AWS services mapped to specific architectural decision domains.
    </p>
  </div>

  <div class="taxonomy-grid">
    {concepts.map((concept: any) => {
      const theme = conceptThemes[concept.id] || { color: "var(--color-network)", label: concept.id.toUpperCase() };
      return (
        <div class="glass-card concept-section" style={`--theme-color: ${theme.color};`}>
          <div class="concept-header">
            <span class="concept-badge" style={`background: ${theme.color}15; color: ${theme.color}; border-color: ${theme.color}40;`}>
              {theme.label}
            </span>
            <h2 class="concept-title">{concept.name}</h2>
          </div>

          <div class="clusters-grid">
            {concept.clusters.map((cluster: any) => (
              <div class="cluster-card">
                <div class="cluster-title-wrap">
                  <span class="cluster-icon" style={`color: ${theme.color};`}>✦</span>
                  <h3 class="cluster-title">{cluster.name}</h3>
                </div>
                <div class="services-pills">
                  {cluster.services.map((svc: string) => (
                    <span 
                      class="service-pill" 
                      style={`--pill-theme: ${theme.color};`}
                    >
                      {svc}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</BaseLayout>

<style>
  .taxonomy-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .header-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    background: #08080d;
    border: 1px solid var(--color-security);
    color: var(--color-security);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
    box-shadow: 0 0 10px rgba(255, 42, 133, 0.2);
  }
  .header-title {
    font-size: 2.75rem;
    font-weight: 900;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }
  .header-sub {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 580px;
    margin: 0 auto;
  }
  .taxonomy-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .concept-section {
    padding: 2rem;
  }
  .concept-section:hover {
    border-color: var(--theme-color);
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.5), 0 0 20px var(--theme-color);
  }
  .concept-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1rem;
  }
  .concept-badge {
    border: 1px solid;
    font-weight: 800;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }
  .concept-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
  }
  .clusters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .cluster-card {
    background: #040407;
    border: 1px solid var(--border-subtle);
    padding: 1.25rem;
    border-radius: 10px;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cluster-card:hover {
    background: #0d0d16;
    border-color: var(--theme-color);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
  }
  .cluster-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .cluster-icon {
    font-size: 0.9rem;
  }
  .cluster-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .services-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .service-pill {
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    transition: all 0.15s ease;
  }
  .service-pill:hover {
    background: var(--pill-theme);
    color: #000;
    border-color: var(--pill-theme);
    box-shadow: 0 0 12px var(--pill-theme);
  }
</style>
