---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTaxonomyTree } from '../lib/data';

const taxonomy = getTaxonomyTree();
const concepts = taxonomy.level_2_and_3.concepts;

// High contrast accessible theme colors
const conceptThemes: Record<string, { color: string; label: string }> = {
  "c1": { color: "var(--color-security)", label: "SECURITY & GUARD" },
  "c2": { color: "var(--color-network)", label: "NETWORK & TRAFFIC" },
  "c3": { color: "var(--color-compute)", label: "COMPUTE & RUN" },
  "c4": { color: "var(--color-storage)", label: "STORAGE & DATA" },
  "c5": { color: "var(--color-database)", label: "DATABASES & QUERY" },
  "c6": { color: "var(--color-decouple)", label: "DECOUPLE & OPERATE" }
};
---

<BaseLayout title="Taxonomy Tree | SAA-C03">
  <div class="taxonomy-header">
    <div class="header-badge">DECISION TAXONOMY</div>
    <h1 class="header-title">
      Architectural <span class="text-gradient">Service Clusters</span>
    </h1>
    <p class="header-sub">
      Categorized AWS services mapped to specific architectural decision domains.
    </p>
  </div>

  <div class="taxonomy-grid">
    {concepts.map((concept: any) => {
      const theme = conceptThemes[concept.id] || { color: "var(--color-network)", label: concept.id.toUpperCase() };
      return (
        <div class="glass-card concept-section">
          <div class="concept-header">
            <span class="concept-badge" style={`background: rgba(255,255,255,0.06); color: #ffffff; border: 1px solid ${theme.color};`}>
              {theme.label}
            </span>
            <h2 class="concept-title">{concept.name}</h2>
          </div>

          <div class="clusters-grid">
            {concept.clusters.map((cluster: any) => (
              <div class="cluster-card">
                <div class="cluster-title-wrap">
                  <span class="cluster-icon" style={`color: ${theme.color};`}>✦</span>
                  <a href={`/topics/${cluster.id}`} class="cluster-link" style={`--hover-color: ${theme.color};`}>
                    <h3 class="cluster-title">{cluster.name}</h3>
                  </a>
                </div>
                <div class="services-pills">
                  {cluster.services.map((svc: string) => (
                    <span 
                      class="service-pill" 
                      style={`border-color: ${theme.color}; color: #ffffff;`}
                    >
                      {svc}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</BaseLayout>

<style>
  .taxonomy-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .header-badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    background: #181d2a;
    border: 1px solid var(--color-security);
    color: var(--color-security);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }
  .header-title {
    font-size: 2.75rem;
    font-weight: 900;
    margin-bottom: 0.75rem;
  }
  .header-sub {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 580px;
    margin: 0 auto;
    font-weight: 500;
  }
  .taxonomy-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .concept-section {
    padding: 2rem;
  }
  .concept-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1rem;
  }
  .concept-badge {
    font-weight: 800;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }
  .concept-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
  }
  .clusters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .cluster-card {
    background: #181d2a;
    border: 1px solid var(--border-subtle);
    padding: 1.25rem;
    border-radius: 10px;
  }
  .cluster-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .cluster-icon {
    font-size: 0.95rem;
  }
  .cluster-link {
    text-decoration: none;
    outline: none;
  }
  .cluster-link:hover .cluster-title {
    color: var(--hover-color);
    text-decoration: underline;
  }
  .cluster-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    transition: color 0.2s ease;
  }
  .services-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .service-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid;
    padding: 0.3rem 0.7rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
  }
</style>
