---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTaxonomyTree } from '../lib/data';

const taxonomy = getTaxonomyTree();
const concepts = taxonomy.level_2_and_3.concepts;
---

<BaseLayout title="Taxonomy Tree | SAA-C03 PRO">
  <div class="concepts-header">
    <h1>SAA-C03 Decision Taxonomy</h1>
    <p>Comprehensive architectural cluster taxonomy and AWS service categorization.</p>
  </div>

  <div class="taxonomy-grid">
    {concepts.map((concept: any) => (
      <div class="glass-card concept-section">
        <div class="concept-badge">{concept.id.toUpperCase()}</div>
        <h2 class="concept-title">{concept.name}</h2>

        <div class="clusters-container">
          {concept.clusters.map((cluster: any) => (
            <div class="cluster-card">
              <h3 class="cluster-title">{cluster.name}</h3>
              <div class="services-pills">
                {cluster.services.map((svc: string) => (
                  <span class="service-pill">{svc}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .concepts-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  .concepts-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  .concepts-header p {
    color: var(--text-secondary);
  }
  .taxonomy-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .concept-section {
    padding: 2rem;
  }
  .concept-badge {
    display: inline-block;
    background: rgba(99, 102, 241, 0.15);
    color: var(--accent-cyan);
    font-weight: 800;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
  }
  .concept-title {
    font-size: 1.5rem;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
  }
  .clusters-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .cluster-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    padding: 1.25rem;
    border-radius: 12px;
  }
  .cluster-title {
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
    color: var(--accent-indigo);
  }
  .services-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .service-pill {
    background: rgba(56, 189, 248, 0.1);
    color: var(--accent-cyan);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
  }
</style>
