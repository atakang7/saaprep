---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTaxonomyTree } from '../lib/data';

const taxonomy = getTaxonomyTree();
const concepts = taxonomy.level_2_and_3.concepts;

// Concept theme colors
const conceptThemes: Record<string, { color: string; label: string; icon: string }> = {
  "c1": { color: "#ff2a70", label: "SECURITY, GUARD & IDENTITY", icon: "🛡️" },
  "c2": { color: "#00e5ff", label: "NETWORK, TRAFFIC & INGRESS", icon: "⚡" },
  "c3": { color: "#a855f7", label: "COMPUTE & WORKLOAD EXECUTION", icon: "⚙️" },
  "c4": { color: "#f59e0b", label: "STORAGE & DATA PERSISTENCE", icon: "📦" },
  "c5": { color: "#10b981", label: "DATABASE & ANALYTICS CLUSTER", icon: "🗄️" },
  "c6": { color: "#ec4899", label: "DECOUPLING & ASYNC EVENT BUS", icon: "🔄" }
};
---

<BaseLayout title="Taxonomy Tree | SAA-C03">
  <div class="pure-tree-container">
    
    <!-- PURE TREE CANVAS (NO PAGE HEADER/TITLES) -->
    <div class="compact-canvas">
      
      <!-- ROOT NODE -->
      <div class="tree-root-bar">
        <span class="tb-badge">ROOT</span>
        <span class="tb-title">🌲 SAA-C03 ARCHITECTURAL EXAM TAXONOMY</span>
      </div>

      <!-- COMPACT BRANCHES LIST -->
      <div class="tree-branches-list">
        {concepts.map((concept: any, cIdx: number) => {
          const theme = conceptThemes[concept.id] || { color: "#00e5ff", label: concept.id.toUpperCase(), icon: "✦" };
          const isLastConcept = cIdx === concepts.length - 1;

          return (
            <div class="compact-branch-block">
              
              <!-- CONCEPT LEVEL 1 BRANCH HEADER -->
              <div class="c-head-row">
                <span class="c-symbol">{isLastConcept ? '└──' : '├──'}</span>
                <div class="c-pill" style={`border-left: 3px solid ${theme.color};`}>
                  <span class="cp-icon">{theme.icon}</span>
                  <span class="cp-num">D0{cIdx + 1}</span>
                  <span class="cp-label" style={`color: ${theme.color};`}>{theme.label}</span>
                </div>
              </div>

              <!-- LEVEL 2 CLUSTERS & LEVEL 3 SERVICES -->
              <div class="c-children-list">
                {concept.clusters.map((cluster: any, clIdx: number) => {
                  const isLastCluster = clIdx === concept.clusters.length - 1;

                  return (
                    <div class="cluster-row-block">
                      <div class="cl-head">
                        <span class="indent-code">│  </span>
                        <span class="cl-symbol">{isLastCluster ? '└──' : '├──'}</span>
                        <a href={`/topics/${cluster.id}`} class="cl-box">
                          <span class="cl-name">{cluster.name}</span>
                          <span class="cl-tag">TOPIC →</span>
                        </a>
                      </div>

                      <div class="leaves-inline-wrap">
                        <span class="indent-code">│  </span>
                        <span class="indent-code">{isLastCluster ? '   ' : '│  '}</span>
                        <span class="leaf-symbol">└──</span>
                        <div class="leaves-row">
                          {cluster.services.map((svcName: string) => {
                            const svcId = svcName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
                            return (
                              <a href={`/services/${svcId}`} class="leaf-chip">
                                <span class="leaf-dot" style={`background: ${theme.color};`}></span>
                                <span>{svcName}</span>
                              </a>
                            );
                          })}
                        </div>
                      </div>

                    </div>
                  );
                })}
              </div>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</BaseLayout>

<style>
  .pure-tree-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 0 3rem;
  }

  /* CANVAS */
  .compact-canvas {
    background: #06070a;
    border: 1px solid #1c1f2c;
    padding: 1rem;
    font-family: var(--font-mono);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tree-root-bar {
    background: #0d0f17;
    border: 1px solid var(--color-network);
    padding: 0.5rem 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tb-badge {
    font-size: 0.55rem;
    font-weight: 900;
    background: var(--color-network);
    color: #000;
    padding: 0.1rem 0.35rem;
  }

  .tb-title {
    font-size: 0.9rem;
    font-weight: 900;
    color: #ffffff;
  }

  .tree-branches-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .compact-branch-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .c-head-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .c-symbol {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 900;
  }

  .c-pill {
    background: #0f121d;
    border: 1px solid #252a3b;
    padding: 0.4rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1;
  }

  .cp-icon {
    font-size: 0.85rem;
  }

  .cp-num {
    font-size: 0.6rem;
    color: var(--text-muted);
    font-weight: 900;
  }

  .cp-label {
    font-size: 0.85rem;
    font-weight: 900;
  }

  .c-children-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cluster-row-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cl-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .indent-code {
    color: var(--text-muted);
    font-size: 0.85rem;
    white-space: pre;
    font-weight: 900;
  }

  .cl-symbol {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 900;
  }

  .cl-box {
    background: #141824;
    border: 1px solid #283044;
    padding: 0.35rem 0.75rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
  }

  .cl-name {
    font-size: 0.85rem;
    font-weight: 900;
    color: #ffffff;
  }

  .cl-tag {
    font-size: 0.6rem;
    color: var(--text-secondary);
    font-weight: 800;
  }

  .leaves-inline-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .leaf-symbol {
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 900;
  }

  .leaves-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .leaf-chip {
    background: #181d2c;
    border: 1px solid #283046;
    padding: 0.25rem 0.6rem;
    text-decoration: none;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .leaf-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }
</style>
