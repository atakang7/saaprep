---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPracticeQuestions, getQuestionServiceMap, getAllServices } from '../lib/data';
import { absoluteUrl, normalizeSiteUrl, sitePath } from '../lib/seo';

const questions = getPracticeQuestions();
const questionServices = getQuestionServiceMap();
const siteUrl = normalizeSiteUrl(Astro.site);
const description = `Practice ${questions.length} AWS SAA-C03 scenario questions with instant answer reveal, explanations, references, and service-specific filters.`;
const aiExplainEndpoint = import.meta.env.PUBLIC_AI_EXPLAIN_ENDPOINT || '';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': ['Quiz', 'LearningResource'],
  name: 'AWS SAA-C03 Practice Questions',
  url: absoluteUrl('/practice', siteUrl),
  description,
  educationalUse: 'Practice',
  learningResourceType: 'Practice exam',
  about: {
    '@type': 'DefinedTerm',
    name: 'AWS Certified Solutions Architect - Associate SAA-C03'
  },
  numberOfItems: questions.length
};

// service id -> display name, for the "filtered by" banner
const serviceNames: Record<string, string> = {};
getAllServices().forEach((s: any) => { serviceNames[s.id] = s.name; });
---

<BaseLayout
  title="AWS SAA-C03 Practice Questions with Answers | SAA Prep"
  description={description}
  canonicalPath="/practice"
  structuredData={structuredData}
>
  <div id="filter-banner" class="filter-banner" style="display: none;">
    <span>Showing questions for <strong id="filter-name"></strong> — <span id="filter-count"></span></span>
    <a href={sitePath('/practice')} class="filter-clear">Show all questions ✕</a>
  </div>

  <div id="filter-empty" class="filter-banner empty" style="display: none;">
    <span>No practice questions in the bank mention <strong id="empty-name"></strong> yet.</span>
    <a href={sitePath('/practice')} class="filter-clear">Browse all questions →</a>
  </div>

  <script type="application/json" id="service-names" set:html={JSON.stringify(serviceNames)}></script>
  <script type="application/json" id="ai-config" set:html={JSON.stringify({ endpoint: aiExplainEndpoint })}></script>

  <div class="practice-workspace">
    <div class="simulator-container glass-card">
      {questions.map((q, idx) => (
        <div
          class="question-block"
          id={`q-${q.id}`}
          data-question-id={q.id}
          data-answer={q.answer}
          data-services={(questionServices[String(q.id)] || []).join(' ')}
          style={idx === 0 ? "" : "display: none;"}
        >
          <div class="question-meta">
            <span class="question-number">QUESTION {q.id} OF {questions.length}</span>
            <span class="question-tag">SAA-C03</span>
          </div>

          <h2 class="question-text">{q.question}</h2>

          <div class="options-group">
            {q.options.map((opt) => (
              <button class="option-btn" data-answer={q.answer} data-opt={opt.charAt(0)} data-option-text={opt.replace(/^[A-E]\.\s*/, '')}>
                {opt}
              </button>
            ))}
          </div>

          <div class="answer-section" style="display: none;">
            <div class="answer-badge">CORRECT ANSWER: {q.answer}</div>
            <div class="explanation-box">
              <h4>Explanation</h4>
              <ul>
                {(Array.isArray(q.explanation) ? q.explanation : (q.explanation ? [q.explanation] : [])).map((exp) => (
                  <li>{exp}</li>
                ))}
              </ul>
              {Array.isArray(q.references) && q.references.length > 0 && (
                <div class="references">
                  <strong>References: </strong> {q.references.join(', ')}
                </div>
              )}
            </div>
          </div>

          <div class="controls-bar">
            <button class="btn-ctrl btn-prev" disabled={idx === 0}>← Prev</button>
            <button class="btn-ctrl btn-reveal">Toggle Answer</button>
            <button class="btn-ctrl btn-next" disabled={idx === questions.length - 1}>Next →</button>
          </div>
        </div>
      ))}
    </div>

    <aside id="ai-coach" class="ai-coach-rail">
      <div class="ai-explanation-header">
        <div>
          <strong>AI Coach</strong>
          <span data-ai-status>Ready</span>
        </div>
        <button class="btn-ai-explain" type="button">Explain</button>
      </div>
      <div class="ai-coach-context">
        <span data-ai-question>QUESTION</span>
        <span data-ai-selection>No answer selected</span>
      </div>
      <div class="ai-explanation-output is-empty" data-ai-output>
        Focused reasoning will appear here.
      </div>
      <p class="ai-disclaimer">AI-generated. Check important details against the listed AWS reference.</p>
    </aside>
  </div>
</BaseLayout>

<script>
  let currentIndex = 0;
  const allBlocks = Array.from(document.querySelectorAll('.question-block')) as HTMLElement[];

  const urlParams = new URLSearchParams(window.location.search);
  const qParam = urlParams.get('q');
  const serviceParam = urlParams.get('service');
  const aiConfigEl = document.getElementById('ai-config');
  const aiConfig = aiConfigEl ? JSON.parse(aiConfigEl.textContent || '{}') : {};
  const aiExplainEndpoint = aiConfig.endpoint || '';
  const aiButton = document.querySelector('.btn-ai-explain') as HTMLButtonElement | null;
  const aiOutput = document.querySelector('[data-ai-output]') as HTMLElement | null;
  const aiStatus = document.querySelector('[data-ai-status]') as HTMLElement | null;
  const aiQuestion = document.querySelector('[data-ai-question]') as HTMLElement | null;
  const aiSelection = document.querySelector('[data-ai-selection]') as HTMLElement | null;
  let aiController: AbortController | null = null;
  let aiRunId = 0;
  const aiRowLabels = ['Verdict', 'Giveaway', 'Why', 'Trap', 'Check'];

  function stripOptionLabel(value: string) {
    return value.replace(/^[A-E][.)]\s*/i, '').trim();
  }

  function normalizeAnswerText(value: string) {
    return stripOptionLabel(value)
      .toLowerCase()
      .replace(/[“”]/g, '"')
      .replace(/[’]/g, "'")
      .replace(/\s+/g, ' ')
      .replace(/[.。]\s*$/g, '')
      .trim();
  }

  function answerLetters(answer: string) {
    const compact = answer.trim().toUpperCase().replace(/\s+/g, '');
    if (!/^[A-E](?:[,/][A-E])*$/.test(compact)) return [];
    return compact.split(/[,/]/).filter(Boolean);
  }

  function optionIsCorrect(option: HTMLElement) {
    const answer = option.getAttribute('data-answer') || '';
    const letter = (option.getAttribute('data-opt') || '').toUpperCase();
    const letters = answerLetters(answer);
    if (letters.length > 0) return letters.includes(letter);

    const optionText = option.getAttribute('data-option-text') || option.textContent || '';
    return normalizeAnswerText(optionText) === normalizeAnswerText(answer);
  }

  function showAnswerSection(parent: Element | null) {
    const answerSection = parent?.querySelector('.answer-section') as HTMLElement | null;
    if (answerSection) answerSection.style.display = 'block';
  }

  function currentBlock() {
    return blocks[currentIndex] as HTMLElement | undefined;
  }

  function selectedOption(parent: Element) {
    return Array.from(parent.querySelectorAll('.option-btn')).find((btn): btn is HTMLElement =>
      btn instanceof HTMLElement && btn.classList.contains('selected')
    );
  }

  function getQuestionPayload(parent: Element) {
    const question = (parent.querySelector('.question-text')?.textContent || '').trim();
    const optionButtons = Array.from(parent.querySelectorAll('.option-btn')).filter((btn): btn is HTMLElement => btn instanceof HTMLElement);
    const options = optionButtons.map((btn) => (btn.textContent || '').trim());
    const selected = optionButtons.find((btn) => btn.classList.contains('selected'));
    const correctOptions = optionButtons
      .filter((btn) => optionIsCorrect(btn))
      .map((btn) => (btn.textContent || '').trim());
    const explanation = Array.from(parent.querySelectorAll('.explanation-box li')).map((li) => (li.textContent || '').trim()).filter(Boolean);
    const referencesText = (parent.querySelector('.references')?.textContent || '').replace(/^References:\s*/i, '').trim();
    const parentEl = parent as HTMLElement;

    return {
      id: parentEl.dataset.questionId || '',
      question,
      options,
      selectedOption: selected ? (selected.textContent || '').trim() : '',
      selectedLetter: selected?.dataset.opt || '',
      selectionIsCorrect: selected ? optionIsCorrect(selected) : null,
      correctAnswer: parentEl.dataset.answer || '',
      correctOptions,
      explanation,
      references: referencesText ? referencesText.split(',').map((ref) => ref.trim()).filter(Boolean) : []
    };
  }

  function setAiStatus(status: string) {
    if (aiStatus) aiStatus.textContent = status;
  }

  function resetAiOutput() {
    if (!aiOutput) return;
    renderAiPlaceholder(aiOutput, 'Focused reasoning will appear here.');
    aiOutput.classList.add('is-empty');
    aiOutput.classList.remove('is-streaming');
  }

  function stopAiStream(silent = false) {
    if (silent) aiRunId += 1;
    if (aiController) aiController.abort();
    aiController = null;
    if (aiButton) aiButton.textContent = 'Explain';
  }

  function syncAiRail(resetOutput = false) {
    const block = currentBlock();
    if (!block) return;

    const selected = selectedOption(block);
    if (aiQuestion) aiQuestion.textContent = `QUESTION ${block.dataset.questionId || ''}`;

    if (selected) {
      const letter = selected.dataset.opt || '';
      const correct = optionIsCorrect(selected);
      if (aiSelection) aiSelection.textContent = `${letter} selected • ${correct ? 'correct' : 'incorrect'}`;
      setAiStatus('Selection ready');
    } else {
      if (aiSelection) aiSelection.textContent = 'No answer selected';
      setAiStatus('Ready');
    }

    if (aiButton && !aiController) aiButton.textContent = resetOutput ? 'Explain' : aiButton.textContent;
    if (resetOutput) resetAiOutput();
  }

  function appendSseEvent(rawEvent: string, output: HTMLElement, state: { text: string; error: string; hasRows: boolean }) {
    const lines = rawEvent.split(/\r?\n/);
    let eventName = 'message';
    const dataLines: string[] = [];

    lines.forEach((line) => {
      if (!line || line.startsWith(':')) return;
      if (line.startsWith('event:')) eventName = line.slice(6).trim();
      if (line.startsWith('data:')) dataLines.push(line.slice(5).trimStart());
    });

    const dataText = dataLines.join('\n').trim();
    if (!dataText || dataText === '[DONE]') return;

    let payload: any = {};
    try {
      payload = JSON.parse(dataText);
    } catch {
      return;
    }

    if (eventName === 'error' || payload.error) {
      state.error = payload.error || 'AI explanation failed.';
      return;
    }

    if ((eventName === 'rows' || payload.rows) && Array.isArray(payload.rows)) {
      state.hasRows = true;
      renderStructuredAiRows(output, payload.rows);
      return;
    }

    if (payload.text) {
      state.text += payload.text;
      renderAiOutput(output, state.text);
    }
  }

  function renderAiOutput(output: HTMLElement, text: string) {
    const normalized = text
      .replace(/\r\n/g, '\n')
      .replace(/^\s*[-*]\s+/gm, '\n- ')
      .trim();

    if (!normalized) {
      renderAiPlaceholder(output, 'Reading clues...');
      return;
    }

    const structuredRows = structuredAiRows(normalized);
    if (structuredRows.length > 0) {
      renderStructuredAiRows(output, structuredRows);
      return;
    }

    if (/^(v|ve|ver|verd|verdict|g|gi|giv|give|giveaway|w|wh|why|t|tr|tra|trap|c|ch|che|chec|check)$/i.test(normalized)) {
      renderStructuredAiRows(output, []);
      return;
    }

    renderStructuredAiRows(output, [{ label: 'Verdict', text: normalized }]);
  }

  function renderAiPlaceholder(output: HTMLElement, message: string) {
    const placeholder = document.createElement('p');
    placeholder.className = 'ai-output-placeholder';
    placeholder.textContent = message;
    output.replaceChildren(placeholder);
  }

  function renderStructuredAiRows(output: HTMLElement, rows: Array<{ label: string; text: string }>) {
    const rowMap = new Map(rows.map((row) => [row.label.toLowerCase(), row.text]));
    const wrapper = document.createElement('div');
    wrapper.className = 'ai-output-structured';

    aiRowLabels.forEach((rowLabel) => {
      const item = document.createElement('div');
      item.className = 'ai-output-row';

      const label = document.createElement('div');
      label.className = 'ai-output-label';
      label.textContent = `${rowLabel}:`;

      const copy = document.createElement('div');
      copy.className = 'ai-output-copy';
      copy.textContent = rowMap.get(rowLabel.toLowerCase()) || '...';

      if (!rowMap.has(rowLabel.toLowerCase())) item.classList.add('is-pending');
      item.append(label, copy);
      wrapper.appendChild(item);
    });

    output.replaceChildren(wrapper);
  }

  function aiLineText(text: string) {
    return text
      .replace(/\*\*/g, '')
      .replace(/`/g, '')
      .replace(/\s+/g, ' ')
      .replace(/\b(Verdict|Giveaway|Why|Trap|Check)\s*:?\s*/g, '\n\n$1:\n')
      .replace(/\n+/g, '\n')
      .trim();
  }

  function structuredAiRows(text: string) {
    const lineText = aiLineText(text);
    const rows: Array<{ label: string; text: string }> = [];
    let currentRow: { label: string; text: string } | null = null;

    lineText.split('\n').forEach((line) => {
      const match = line.match(/^(Verdict|Giveaway|Why|Trap|Check):\s*(.*)$/);
      if (!match) {
        if (currentRow && line.trim()) currentRow.text = `${currentRow.text} ${line.trim()}`.trim();
        return;
      }

      const label = match[1][0].toUpperCase() + match[1].slice(1).toLowerCase();
      const rowText = match[2].replace(/^[:\-–—\s]+/, '').trim();

      currentRow = { label, text: rowText };
      rows.push(currentRow);
    });

    return rows.filter((row) => row.text);
  }

  async function streamAiExplanation(res: Response, output: HTMLElement) {
    const contentType = res.headers.get('content-type') || '';

    if (!res.ok) {
      const data = await res.json().catch(async () => ({ error: await res.text().catch(() => '') }));
      throw new Error(data.error || `AI request failed (${res.status})`);
    }

    if (!res.body || !contentType.includes('text/event-stream')) {
      const data = await res.json().catch(() => ({}));
      renderAiOutput(output, data.explanation || 'No explanation returned.');
      return;
    }

    const reader = res.body.getReader();
    const decoder = new TextDecoder();
    const state = { text: '', error: '', hasRows: false };
    let buffer = '';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;

      buffer += decoder.decode(value, { stream: true });
      const events = buffer.split(/\r?\n\r?\n/);
      buffer = events.pop() || '';
      events.forEach((event) => appendSseEvent(event, output, state));

      if (state.error) throw new Error(state.error);
    }

    if (buffer.trim()) appendSseEvent(buffer, output, state);
    if (state.error) throw new Error(state.error);
    if (!state.text.trim() && !state.hasRows) renderAiOutput(output, 'No explanation returned.');
  }

  // Restrict the deck to one service when ?service= is present.
  let blocks = allBlocks;
  if (serviceParam) {
    const matching = allBlocks.filter(b =>
      (b.dataset.services || '').split(' ').includes(serviceParam)
    );

    const namesEl = document.getElementById('service-names');
    const names = namesEl ? JSON.parse(namesEl.textContent || '{}') : {};
    const label = names[serviceParam] || serviceParam;

    if (matching.length > 0) {
      blocks = matching;
      const banner = document.getElementById('filter-banner');
      const nameEl = document.getElementById('filter-name');
      const countEl = document.getElementById('filter-count');
      if (banner) banner.style.display = 'flex';
      if (nameEl) nameEl.textContent = label;
      if (countEl) countEl.textContent =
        `${matching.length} question${matching.length === 1 ? '' : 's'}`;
    } else {
      // Nothing matched — say so instead of silently showing the full bank.
      const empty = document.getElementById('filter-empty');
      const emptyName = document.getElementById('empty-name');
      if (empty) empty.style.display = 'flex';
      if (emptyName) emptyName.textContent = label;
    }
  }

  const totalQuestions = blocks.length;

  // Show only the active deck, starting at ?q= if it is part of that deck.
  allBlocks.forEach(b => (b.style.display = 'none'));
  if (qParam) {
    const target = document.getElementById(`q-${qParam}`) as HTMLElement | null;
    const idx = target ? blocks.indexOf(target) : -1;
    if (idx >= 0) currentIndex = idx;
  }
  if (blocks[currentIndex]) blocks[currentIndex].style.display = 'grid';

  // Prev/Next are rendered per-block from the full list; re-enable them
  // against the filtered deck so the ends are correct.
  blocks.forEach((b, i) => {
    const prev = b.querySelector('.btn-prev') as HTMLButtonElement | null;
    const next = b.querySelector('.btn-next') as HTMLButtonElement | null;
    if (prev) prev.disabled = i === 0;
    if (next) next.disabled = i === totalQuestions - 1;
  });
  syncAiRail(true);

  function updateQuestion(newIndex: number) {
    const currentBlock = blocks[currentIndex] as HTMLElement;
    const nextBlock = blocks[newIndex] as HTMLElement;
    if (currentBlock && nextBlock) {
      stopAiStream(true);
      currentBlock.style.display = 'none';
      nextBlock.style.display = 'grid';
      currentIndex = newIndex;
      
      const targetId = nextBlock.id.replace('q-', '');
      const newUrl = new URL(window.location.href);
      newUrl.searchParams.set('q', targetId);
      window.history.replaceState({}, '', newUrl);
      syncAiRail(true);
    }
  }

  document.querySelectorAll('.btn-next').forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentIndex < totalQuestions - 1) updateQuestion(currentIndex + 1);
    });
  });

  document.querySelectorAll('.btn-prev').forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentIndex > 0) updateQuestion(currentIndex - 1);
    });
  });

  document.querySelectorAll('.btn-reveal').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const parent = (e.target as HTMLElement).closest('.question-block');
      const answerSection = parent?.querySelector('.answer-section') as HTMLElement;
      if (answerSection) {
        answerSection.style.display = answerSection.style.display === 'none' ? 'block' : 'none';
      }
    });
  });

  document.querySelectorAll('.option-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const parent = target.closest('.question-block');

      parent?.querySelectorAll('.option-btn').forEach(b => {
        b.classList.remove('selected', 'correct', 'wrong');
      });

      const correctButtons = Array.from(parent?.querySelectorAll('.option-btn') || [])
        .filter((option): option is HTMLElement => option instanceof HTMLElement && optionIsCorrect(option));

      target.classList.add('selected');

      if (optionIsCorrect(target)) {
        target.classList.add('correct');
      } else {
        target.classList.add('wrong');
        correctButtons.forEach(option => option.classList.add('correct'));
      }

      showAnswerSection(parent);
      syncAiRail(true);
    });
  });

  if (aiButton && !aiExplainEndpoint) {
    aiButton.disabled = true;
    aiButton.textContent = 'Unavailable';
    aiButton.title = 'Set PUBLIC_AI_EXPLAIN_ENDPOINT to enable AI explanations.';
  }

  aiButton?.addEventListener('click', async () => {
    if (aiController) {
      aiController.abort();
      return;
    }

    const parent = currentBlock();
    if (!parent || !aiOutput || !aiButton) return;

    const controller = new AbortController();
    aiController = controller;
    const runId = ++aiRunId;
    const timeoutId = window.setTimeout(() => controller.abort(), 45000);
    const payload = getQuestionPayload(parent);

    aiButton.textContent = 'Stop';
    renderStructuredAiRows(aiOutput, []);
    aiOutput.classList.remove('is-empty');
    aiOutput.classList.add('is-streaming');
    setAiStatus(payload.selectedOption ? 'Focused on selection' : 'Preparing');

    try {
      const res = await fetch(aiExplainEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        signal: controller.signal
      });

      if (runId !== aiRunId) return;
      renderStructuredAiRows(aiOutput, []);
      await streamAiExplanation(res, aiOutput);
      if (runId === aiRunId) setAiStatus('Complete');
    } catch (error) {
      if (runId !== aiRunId) return;
      aiOutput.replaceChildren(error instanceof DOMException && error.name === 'AbortError'
        ? 'AI explanation stopped.'
        : (error instanceof Error ? error.message : 'AI explanation failed.'));
      setAiStatus(error instanceof DOMException && error.name === 'AbortError' ? 'Stopped' : 'Needs retry');
    } finally {
      window.clearTimeout(timeoutId);
      if (runId === aiRunId) {
        aiController = null;
        aiOutput.classList.remove('is-streaming');
        aiButton.textContent = 'Regenerate';
      }
    }
  });
</script>

<style>
  .filter-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.6rem 0.9rem;
    margin-bottom: 1rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--color-compute);
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .filter-banner.empty {
    border-left-color: var(--color-security);
  }

  .filter-banner strong {
    color: var(--text-primary);
  }

  .filter-clear {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .filter-clear:hover {
    color: var(--text-primary);
  }

  .practice-workspace {
    width: 100%;
    max-width: 1480px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    gap: 1rem;
    align-items: stretch;
    height: calc(100vh - 5.7rem);
    min-height: 600px;
    max-height: 840px;
  }
  .simulator-container {
    padding: 1.2rem;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    margin: 0;
    background: #06070a;
    border: 1px solid var(--border-subtle);
    overflow: hidden;
  }
  .question-block {
    height: 100%;
    min-height: 0;
    grid-template-rows: auto auto minmax(0, 1fr) auto auto;
    gap: 0.85rem;
  }
  .question-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed var(--border-subtle);
    padding-bottom: 0.55rem;
  }
  .question-number {
    font-weight: 900;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
  }
  .question-tag {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.2rem 0.6rem;
    font-size: 0.7rem;
    font-weight: 800;
    font-family: var(--font-mono);
  }
  .question-text {
    font-size: 1.05rem;
    line-height: 1.45;
    margin: 0;
    font-weight: 700;
    color: var(--text-primary);
    overflow-wrap: anywhere;
  }
  .options-group {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
    min-height: 0;
    align-content: start;
    overflow: auto;
    padding-right: 0.15rem;
  }
  .option-btn {
    background: #0a0b10;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.75rem 0.9rem;
    text-align: left;
    font-size: 0.84rem;
    cursor: pointer;
    line-height: 1.4;
    transition: all 0.15s ease;
    min-height: 4.75rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .option-btn:hover {
    background: #11131c;
    border-color: var(--text-muted);
    color: var(--text-primary);
