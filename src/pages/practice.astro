---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPracticeQuestions } from '../lib/data';

const questions = getPracticeQuestions();
---

<BaseLayout title="Exam Simulator | SAA-C03 PRO">
  <div class="simulator-header">
    <h1>SAA-C03 Practice Arena</h1>
    <p>Test your knowledge with authentic exam-style practice questions.</p>
  </div>

  <div class="simulator-container glass-card">
    {questions.map((q, idx) => (
      <div class="question-block" id={`q-${q.id}`} style={idx === 0 ? "" : "display: none;"}>
        <div class="question-meta">
          <span class="question-number">Question {q.id} of {questions.length}</span>
          <span class="question-tag">Exam Standard</span>
        </div>

        <h2 class="question-text">{q.question}</h2>

        <div class="options-group">
          {q.options.map((opt) => (
            <button class="option-btn" data-answer={q.answer} data-opt={opt.charAt(0)}>
              {opt}
            </button>
          ))}
        </div>

        <div class="answer-section" style="display: none;">
          <div class="answer-badge">Correct Answer: {q.answer}</div>
          <div class="explanation-box">
            <h4>Explanation & Key Concepts</h4>
            <ul>
              {q.explanation.map((exp) => (
                <li>{exp}</li>
              ))}
            </ul>
            {q.references.length > 0 && (
              <div class="references">
                <strong>References: </strong> {q.references.join(', ')}
              </div>
            )}
          </div>
        </div>

        <div class="controls-bar">
          <button class="btn-ctrl btn-prev" disabled={idx === 0}>← Previous</button>
          <button class="btn-ctrl btn-reveal">Show Answer</button>
          <button class="btn-ctrl btn-next" disabled={idx === questions.length - 1}>Next →</button>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>

<script>
  let currentIndex = 0;
  const totalQuestions = document.querySelectorAll('.question-block').length;

  function updateQuestion(newIndex: number) {
    const currentBlock = document.querySelectorAll('.question-block')[currentIndex] as HTMLElement;
    const nextBlock = document.querySelectorAll('.question-block')[newIndex] as HTMLElement;
    if (currentBlock && nextBlock) {
      currentBlock.style.display = 'none';
      nextBlock.style.display = 'block';
      currentIndex = newIndex;
    }
  }

  document.querySelectorAll('.btn-next').forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentIndex < totalQuestions - 1) updateQuestion(currentIndex + 1);
    });
  });

  document.querySelectorAll('.btn-prev').forEach(btn => {
    btn.addEventListener('click', () => {
      if (currentIndex > 0) updateQuestion(currentIndex - 1);
    });
  });

  document.querySelectorAll('.btn-reveal').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const parent = (e.target as HTMLElement).closest('.question-block');
      const answerSection = parent?.querySelector('.answer-section') as HTMLElement;
      if (answerSection) {
        answerSection.style.display = answerSection.style.display === 'none' ? 'block' : 'none';
      }
    });
  });

  document.querySelectorAll('.option-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const parent = target.closest('.question-block');
      const correctAns = target.getAttribute('data-answer');
      const chosen = target.getAttribute('data-opt');

      parent?.querySelectorAll('.option-btn').forEach(b => {
        b.classList.remove('selected', 'correct', 'wrong');
      });

      if (chosen === correctAns) {
        target.classList.add('correct');
      } else {
        target.classList.add('wrong');
      }
    });
  });
</script>

<style>
  .simulator-header {
    margin-bottom: 2rem;
    text-align: center;
  }
  .simulator-header h1 {
    font-size: 2.25rem;
    margin-bottom: 0.5rem;
  }
  .simulator-header p {
    color: var(--text-secondary);
  }
  .simulator-container {
    padding: 2.5rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .question-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .question-number {
    font-weight: 700;
    color: var(--accent-cyan);
    font-size: 0.9rem;
  }
  .question-tag {
    background: rgba(99, 102, 241, 0.15);
    color: var(--accent-indigo);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .question-text {
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    font-weight: 600;
  }
  .options-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .option-btn {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 1rem 1.25rem;
    border-radius: 12px;
    text-align: left;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .option-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--border-glow);
  }
  .option-btn.correct {
    background: rgba(16, 185, 129, 0.2);
    border-color: var(--accent-emerald);
    color: #6ee7b7;
  }
  .option-btn.wrong {
    background: rgba(239, 68, 68, 0.2);
    border-color: #ef4444;
    color: #fca5a5;
  }
  .answer-section {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: rgba(15, 23, 42, 0.9);
    border-radius: 12px;
    border-left: 4px solid var(--accent-indigo);
  }
  .answer-badge {
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--accent-emerald);
    margin-bottom: 1rem;
  }
  .explanation-box h4 {
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  .explanation-box ul {
    list-style-type: disc;
    padding-left: 1.25rem;
    color: var(--text-secondary);
  }
  .explanation-box li {
    margin-bottom: 0.5rem;
  }
  .references {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .controls-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.5rem;
  }
  .btn-ctrl {
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    font-weight: 600;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    cursor: pointer;
  }
  .btn-ctrl:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .btn-ctrl:not(:disabled):hover {
    border-color: var(--accent-indigo);
    background: var(--bg-card-hover);
  }
</style>
