---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  accentFor,
  explanationFor,
  getClassificationForQuestion,
  getTopicForQuestion,
  questions,
  sourceLabel,
} from "../../lib/data";

export function getStaticPaths() {
  return questions.map((question) => ({
    params: { id: question.id },
    props: { question },
  }));
}

const { question } = Astro.props;
const topic = getTopicForQuestion(question.id);
const classification = getClassificationForQuestion(question.id);
const explanation = explanationFor(question);
const correct = new Set(question.answer?.labels ?? []);
---

<BaseLayout title={`Review ${question.id}`}>
  <div style={`--accent: ${accentFor(topic?.concept_id ?? "c1")};`}>
    <div class="page-head">
      <span class="eyebrow">Review</span>
      <div class="row">
        {
          topic && (
            <a class="chip chip-accent" href={`/topics/${topic.cluster_id}/`}>
              {topic.cluster_title}
            </a>
          )
        }
        {
          classification?.primary_service_tested && (
            <span class="chip">{classification.primary_service_tested}</span>
          )
        }
        <span class="chip">{sourceLabel(question.source)}</span>
        <span class="chip mono">{question.id}</span>
      </div>
      <p class="question-text" style="color: var(--ink);">{question.question}</p>
    </div>

    <div class="options">
      {
        question.options.map((option) => (
          <div class="option" data-option data-correct={correct.has(option.label) ? "1" : "0"}>
            <span class="option-label">{option.label}</span>
            <span>{option.text}</span>
          </div>
        ))
      }
    </div>

    <div class="drill-actions">
      <button class="btn btn-primary" data-show type="button">
        Show answer
      </button>
      {
        topic && (
          <a class="btn" href={`/topics/${topic.cluster_id}/`}>
            Read the topic
          </a>
        )
      }
    </div>

    <div class="reveal" data-reveal hidden>
      <div class="verdict verdict-ok">Answer: {question.answer?.labels.join(", ")}</div>

      {
        explanation && (
          <div class="explain">
            <b>Why</b>
            {explanation}
          </div>
        )
      }
    </div>
  </div>

  <script>
    const reveal = document.querySelector<HTMLElement>("[data-reveal]");
    const button = document.querySelector<HTMLButtonElement>("[data-show]");

    button?.addEventListener("click", () => {
      if (reveal) reveal.hidden = false;
      for (const node of document.querySelectorAll<HTMLElement>("[data-option]")) {
        if (node.dataset.correct === "1") node.dataset.state = "correct";
      }
      button.disabled = true;
    });
  </script>
</BaseLayout>
