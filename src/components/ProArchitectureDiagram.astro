---
interface DiagramNode {
  step: string;
  node: string;
  protocol: string;
  role: string;
  details: string;
  haTag: string;
}

interface Props {
  title?: string;
  serviceName: string;
  nodes: DiagramNode[];
  color?: string;
}

const { title = "PRO-GRADE ARCHITECTURE DATA FLOW", serviceName, nodes, color = "#00e5ff" } = Astro.props;
---

<div class="pro-diagram-container">
  <!-- DIAGRAM HEADER BAR -->
  <div class="pd-header">
    <div class="pd-header-left">
      <span class="pd-title-icon">⚡</span>
      <span class="pd-title-text">{title}</span>
    </div>
    <div class="pd-header-right">
      <span class="pd-tag" style={`color: ${color}; border-color: ${color};`}>AWS ARCHITECTURE BLUEPRINT</span>
      <span class="pd-status">● LIVE SIMULATION</span>
    </div>
  </div>

  <!-- CANVAS CANVAS / GRAPHICAL FLOW -->
  <div class="pd-canvas">
    <div class="pd-diagram-grid">
      {nodes.map((node, idx) => (
        <div class="pd-node-column">
          
          <!-- NODE CARD BOX -->
          <div class="pd-node-box" style={`border-top: 3px solid ${color};`}>
            
            <!-- TOP META -->
            <div class="pd-box-top">
              <span class="pd-step-badge">STEP 0{idx + 1}</span>
              <span class="pd-role-badge" style={`color: ${color}; background: rgba(255,255,255,0.03);`}>{node.role}</span>
            </div>

            <!-- TITLE -->
            <h3 class="pd-node-title">{node.node}</h3>

            <!-- PROTOCOL BADGE -->
            <div class="pd-protocol-bar">
              <span class="pd-lbl">PROTOCOL:</span>
              <span class="pd-val">{node.protocol}</span>
            </div>

            <!-- DETAILS -->
            <p class="pd-node-details">{node.details}</p>

            <!-- HA METRIC TAG -->
            <div class="pd-ha-tag">
              <span class="pd-ha-icon">🛡️</span>
              <span>{node.haTag}</span>
            </div>

          </div>

          <!-- CONNECTOR SVG BETWEEN STAGES -->
          {idx < nodes.length - 1 && (
            <div class="pd-connector-unit">
              <svg width="48" height="32" viewBox="0 0 48 32" fill="none" class="pd-svg">
                <line x1="0" y1="16" x2="36" y2="16" stroke={color} stroke-width="2" stroke-dasharray="4 2"/>
                <polygon points="36,10 48,16 36,22" fill={color} />
              </svg>
              <span class="pd-conn-label">{node.protocol}</span>
            </div>
          )}

        </div>
      ))}
    </div>
  </div>

  <!-- TOPOLOGY FOOTER MATRIX -->
  <div class="pd-footer-matrix">
    <div class="pd-matrix-item">
      <span class="pd-m-lbl">PRIMARY SERVICE</span>
      <span class="pd-m-val" style={`color: ${color};`}>{serviceName}</span>
    </div>
    <div class="pd-matrix-item">
      <span class="pd-m-lbl">FAULT DOMAIN</span>
      <span class="pd-m-val">Multi-AZ Regional Isolation</span>
    </div>
    <div class="pd-matrix-item">
      <span class="pd-m-lbl">SECURITY BOUNDARY</span>
      <span class="pd-m-val">IAM SigV4 + TLS 1.3</span>
    </div>
    <div class="pd-matrix-item">
      <span class="pd-m-lbl">EXAM RECALL SIGNAL</span>
      <span class="pd-m-val">Zero Single Point of Failure</span>
    </div>
  </div>
</div>

<style>
  .pro-diagram-container {
    background: #06070a;
    border: 1px solid #232736;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  .pd-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    background: #0c0e14;
    border-bottom: 1px solid #232736;
    font-family: var(--font-mono);
  }

  .pd-header-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pd-title-icon {
    color: var(--color-storage);
  }

  .pd-title-text {
    font-size: 0.85rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: 0.05em;
  }

  .pd-header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pd-tag {
    font-size: 0.65rem;
    font-weight: 900;
    padding: 0.15rem 0.5rem;
    border: 1px solid;
    background: rgba(255, 255, 255, 0.02);
  }

  .pd-status {
    font-size: 0.6rem;
    color: var(--color-database);
    font-weight: 800;
  }

  /* CANVAS */
  .pd-canvas {
    padding: 2rem 1.25rem;
    overflow-x: auto;
    background: radial-gradient(circle at center, rgba(255,255,255,0.015) 0%, transparent 70%);
  }

  .pd-diagram-grid {
    display: flex;
    align-items: center;
    min-width: 850px;
    justify-content: space-between;
  }

  .pd-node-column {
    display: flex;
    align-items: center;
    flex: 1;
  }

  .pd-node-box {
    background: #10121a;
    border: 1px solid #282d3f;
    padding: 1.25rem;
    flex: 1;
    min-width: 190px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pd-box-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
  }

  .pd-step-badge {
    font-size: 0.65rem;
    font-weight: 900;
    color: var(--text-muted);
  }

  .pd-role-badge {
    font-size: 0.6rem;
    font-weight: 900;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--border-subtle);
  }

  .pd-node-title {
    font-size: 1.15rem;
    font-weight: 900;
    color: #ffffff;
    margin: 0;
  }

  .pd-protocol-bar {
    display: flex;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    background: #08090d;
    padding: 0.3rem 0.5rem;
    border: 1px solid #1c1f2b;
  }

  .pd-lbl {
    color: var(--text-muted);
    font-weight: 900;
  }

  .pd-val {
    color: var(--text-secondary);
    font-weight: 700;
  }

  .pd-node-details {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.4;
    margin: 0;
  }

  .pd-ha-tag {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-database);
    font-weight: 800;
    margin-top: 0.25rem;
  }

  /* CONNECTOR */
  .pd-connector-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 0.5rem;
    flex-shrink: 0;
  }

  .pd-svg {
    display: block;
  }

  .pd-conn-label {
    font-size: 0.55rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-weight: 800;
    margin-top: 0.2rem;
    white-space: nowrap;
  }

  /* FOOTER MATRIX */
  .pd-footer-matrix {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid #232736;
    background: #08090e;
  }

  @media (max-width: 768px) {
    .pd-footer-matrix {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .pd-matrix-item {
    padding: 0.85rem 1rem;
    border-right: 1px solid #1c1f2b;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .pd-matrix-item:last-child {
    border-right: none;
  }

  .pd-m-lbl {
    font-size: 0.6rem;
    font-family: var(--font-mono);
    font-weight: 900;
    color: var(--text-muted);
  }

  .pd-m-val {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--text-primary);
  }
</style>
