---
interface DiagramNode {
  step: string;
  node: string;
  protocol: string;
  role: string;
  details: string;
  haTag: string;
}

interface Props {
  title?: string;
  serviceName: string;
  nodes: DiagramNode[];
  color?: string;
}

const { title = "PRO ARCHITECTURE CATEGORY BOUNDARY", serviceName, nodes, color = "#00e5ff" } = Astro.props;
---

<div class="pro-grouping-container">
  <!-- CATEGORY BOUNDARY HEADER -->
  <div class="pg-header">
    <div class="pg-header-left">
      <span class="pg-icon">🛡️</span>
      <span class="pg-title">{title}</span>
    </div>
    <div class="pg-header-right">
      <span class="pg-tag" style={`color: ${color}; border-color: ${color};`}>INFRASTRUCTURE BOUNDARY</span>
      <span class="pg-badge">SAA-C03 ARCHITECTURE</span>
    </div>
  </div>

  <!-- VISUAL CATEGORY GROUPING GRID (NO ARROWS) -->
  <div class="pg-groupings-grid">
    {nodes.map((node, idx) => (
      <div class="pg-category-card" style={`border-top: 3px solid ${color};`}>
        
        <!-- CATEGORY BADGE HEADER -->
        <div class="pg-card-head">
          <span class="pg-stage-lbl" style={`color: ${color}; background: rgba(255,255,255,0.03);`}>{node.role}</span>
          <span class="pg-step-num">STAGE 0{idx + 1}</span>
        </div>

        <!-- NODE NAME -->
        <h3 class="pg-node-name">{node.node}</h3>

        <!-- PROTOCOL SPECS -->
        <div class="pg-spec-pill">
          <span class="pg-spec-lbl">PROTOCOL:</span>
          <span class="pg-spec-val">{node.protocol}</span>
        </div>

        <!-- TECHNICAL DETAILS -->
        <p class="pg-details">{node.details}</p>

        <!-- HA RESILIENCE METRIC -->
        <div class="pg-ha-metric">
          <span class="pg-ha-dot" style={`background: ${color};`}></span>
          <span>{node.haTag}</span>
        </div>

      </div>
    ))}
  </div>

  <!-- BOTTOM MATRIX SUMMARY -->
  <div class="pg-footer">
    <div class="pg-foot-col">
      <span class="pg-f-lbl">TARGET SERVICE</span>
      <span class="pg-f-val" style={`color: ${color};`}>{serviceName}</span>
    </div>
    <div class="pg-foot-col">
      <span class="pg-f-lbl">BOUNDARY TYPE</span>
      <span class="pg-f-val">VPC / Multi-AZ Isolation</span>
    </div>
    <div class="pg-foot-col">
      <span class="pg-f-lbl">SECURITY DOMAIN</span>
      <span class="pg-f-val">IAM Policy + KMS Enforced</span>
    </div>
    <div class="pg-foot-col">
      <span class="pg-f-lbl">EXAM RECALL</span>
      <span class="pg-f-val">Fault Tolerant Architecture</span>
    </div>
  </div>
</div>

<style>
  .pro-grouping-container {
    background: #06070a;
    border: 1px solid #1e2230;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  .pg-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    background: #0d0f17;
    border-bottom: 1px solid #1e2230;
    font-family: var(--font-mono);
  }

  .pg-header-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .pg-title {
    font-size: 0.85rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: 0.04em;
  }

  .pg-header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .pg-tag {
    font-size: 0.65rem;
    font-weight: 900;
    padding: 0.15rem 0.45rem;
    border: 1px solid;
  }

  .pg-badge {
    font-size: 0.6rem;
    color: var(--text-muted);
    font-weight: 800;
  }

  /* CATEGORY GROUPINGS GRID */
  .pg-groupings-grid {
    padding: 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .pg-category-card {
    background: #10131d;
    border: 1px solid #24293a;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .pg-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
  }

  .pg-stage-lbl {
    font-size: 0.6rem;
    font-weight: 900;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--border-subtle);
  }

  .pg-step-num {
    font-size: 0.65rem;
    font-weight: 900;
    color: var(--text-muted);
  }

  .pg-node-name {
    font-size: 1.15rem;
    font-weight: 900;
    color: #ffffff;
    margin: 0;
  }

  .pg-spec-pill {
    display: flex;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    background: #08090e;
    padding: 0.3rem 0.5rem;
    border: 1px solid #1c1f2c;
  }

  .pg-spec-lbl {
    color: var(--text-muted);
    font-weight: 900;
  }

  .pg-spec-val {
    color: var(--text-secondary);
    font-weight: 700;
  }

  .pg-details {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  .pg-ha-metric {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-primary);
    font-weight: 800;
    margin-top: 0.25rem;
  }

  .pg-ha-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  /* FOOTER */
  .pg-footer {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid #1e2230;
    background: #08090e;
  }

  @media (max-width: 768px) {
    .pg-footer {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .pg-foot-col {
    padding: 0.85rem 1rem;
    border-right: 1px solid #1c1f2c;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .pg-foot-col:last-child {
    border-right: none;
  }

  .pg-f-lbl {
    font-size: 0.6rem;
    font-family: var(--font-mono);
    font-weight: 900;
    color: var(--text-muted);
  }

  .pg-f-val {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--text-primary);
  }
</style>
