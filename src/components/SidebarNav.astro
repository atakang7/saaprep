---
import { getTaxonomyTree, getTaxonomyEntryHref } from '../lib/data';
import { sitePath, stripSiteBase } from '../lib/seo';

const taxonomy = getTaxonomyTree();
const concepts = taxonomy.level_2_and_3.concepts;
const currentPath = stripSiteBase(Astro.url.pathname);

const conceptThemes: Record<string, string> = {
  "c1": "var(--color-security)",
  "c2": "var(--color-network)",
  "c3": "var(--color-compute)",
  "c4": "var(--color-storage)",
  "c5": "var(--color-database)",
  "c6": "var(--color-decouple)"
};
---

<aside class="sidebar-wrapper" id="sidebar">
  <div class="sidebar-inner">
    <nav class="sidebar-nav">
      <div class="sb-tree-header">// DECISION DOMAINS</div>

      {concepts.map((concept: any) => {
        const themeColor = conceptThemes[concept.id] || "var(--color-network)";
        return (
          <details class="sb-concept-group" open>
            <summary class="sb-concept-summary" style={`border-left: 2px solid ${themeColor};`}>
              <span class="sb-concept-name">{concept.name}</span>
              <span class="sb-arrow">▾</span>
            </summary>

            <div class="sb-clusters-list">
              {concept.clusters.map((cluster: any) => {
                const topicUrl = `/topics/${cluster.id}`;
                const isTopicActive = currentPath === topicUrl;
                return (
                  <div class="sb-cluster-item">
                    <a href={sitePath(topicUrl)} class={`sb-cluster-link ${isTopicActive ? 'active' : ''}`}>
                      <span class="sb-square" style={`background: ${themeColor};`}></span>
                      <span>{cluster.name}</span>
                    </a>

                    <div class="sb-services-sublist">
                      {cluster.services.map((svcName: string) => {
                        const svcUrl = getTaxonomyEntryHref(svcName, cluster.id);
                        const isSvcActive = currentPath === svcUrl;
                        return (
                          <a href={sitePath(svcUrl)} class={`sb-svc-link ${isSvcActive ? 'active' : ''}`}>
                            {svcName}
                          </a>
                        );
                      })}
                    </div>
                  </div>
                );
              })}
            </div>
          </details>
        );
      })}
    </nav>
  </div>
</aside>

<style>
  .sidebar-wrapper {
    width: 260px;
    flex-shrink: 0;
    position: sticky;
    top: 49px;
    height: calc(100vh - 49px);
    border-right: 1px solid var(--border-subtle);
    background: #050608;
    overflow-y: auto;
  }

  @media (max-width: 900px) {
    .sidebar-wrapper {
      display: none;
    }
  }

  .sidebar-inner {
    padding: 1rem 0.75rem 3rem;
  }

  .sb-tree-header {
    font-size: 0.6rem;
    font-weight: 900;
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-bottom: 0.5rem;
    padding-left: 0.25rem;
  }

  .sb-concept-group {
    margin-bottom: 0.5rem;
  }

  .sb-concept-summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0.5rem;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.015);
    margin-bottom: 0.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .sb-concept-summary::-webkit-details-marker {
    display: none;
  }

  .sb-concept-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sb-arrow {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .sb-clusters-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-left: 0.5rem;
    margin-top: 0.25rem;
  }

  .sb-cluster-item {
    display: flex;
    flex-direction: column;
  }

  .sb-cluster-link {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .sb-cluster-link.active {
    color: var(--text-primary);
    font-weight: 900;
    background: rgba(255, 255, 255, 0.04);
  }

  .sb-square {
    width: 5px;
    height: 5px;
    flex-shrink: 0;
  }

  .sb-services-sublist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding-left: 0.85rem;
    margin-top: 0.2rem;
    margin-bottom: 0.4rem;
  }

  .sb-svc-link {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.1rem 0.35rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
  }

  .sb-svc-link.active {
    color: var(--color-network);
    border-color: var(--color-network);
    font-weight: 800;
  }
</style>
