---
import "../styles/global.css";
import { totalQuestions, totalTopics, clusterMeta, conceptStyles } from "../lib/data";

interface Props {
  title: string;
  description?: string;
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
const path = Astro.url.pathname;

const clusters = clusterMeta();
const byConcept = new Map<string, typeof clusters>();
for (const c of clusters) {
  const b = byConcept.get(c.conceptId) ?? [];
  b.push(c);
  byConcept.set(c.conceptId, b);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={description ?? `AWS SAA-C03 explained topic by topic with ${totalQuestions.toLocaleString()} real practice questions across ${totalTopics} topics.`}
    />
    <title>{title} · SAA Prep</title>
  </head>
  <body>
    {bare ? (
      <slot />
    ) : (
      <div class="app-shell">
        <aside class="sidebar" id="sidebar">
          <a class="sidebar-brand" href="/">
            <span class="sidebar-brand-mark">S</span>
            <span class="sidebar-brand-text">SAA Prep</span>
          </a>

          <nav class="sidebar-nav">
            {[...byConcept.entries()].map(([conceptId, group]) => {
              const style = conceptStyles[conceptId];
              return (
                <div class="sidebar-group" style={`--accent: ${style?.color ?? 'var(--teal)'};`}>
                  <a class="sidebar-concept" href={`/concepts/${conceptId}/`}>
                    {style?.label ?? conceptId}
                  </a>
                  {group.map((c) => (
                    <a
                      class="sidebar-topic"
                      href={`/topics/${c.id}/`}
                      aria-current={path.includes(`/topics/${c.id}`) ? "page" : undefined}
                    >
                      {c.title}
                      {c.count > 0 && <span class="sidebar-count">{c.count}</span>}
                    </a>
                  ))}
                </div>
              );
            })}
          </nav>
        </aside>

        <main class="main-area">
          <slot />
        </main>
      </div>
    )}

    <footer class="site-footer">
      <div class="page-container">
        <p>{totalQuestions.toLocaleString()} questions · {totalTopics} topics · Built for the SAA-C03</p>
      </div>
    </footer>
  </body>
</html>
