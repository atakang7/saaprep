---
import { BookOpen, Layers3, Target } from "lucide-astro";
import "../styles/global.css";
import { totalQuestions } from "../lib/data";

interface Props {
  title: string;
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: "/", label: "Search", icon: Target },
  { href: "/topics/", label: "Topics", icon: Layers3 },
];

const isCurrent = (href: string) =>
  href === "/" ? (path === "/" ? "page" : undefined) : path.startsWith(href) ? "page" : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="AWS SAA-C03 explained topic by topic, each one ending in real practice questions."
    />
    <title>{title} · SAA Prep</title>
  </head>
  <body>
    <div class="shell">
      <aside class="rail">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"><BookOpen size={17} /></span>
          <span>
            <b>SAA Prep</b>
            <span>{totalQuestions.toLocaleString()} questions</span>
          </span>
        </a>

        <nav class="rail-nav" aria-label="Main">
          {
            nav.map(({ href, label, icon: Icon }) => (
              <a href={href} aria-current={isCurrent(href)}>
                <Icon size={17} />
                <span>{label}</span>
              </a>
            ))
          }
        </nav>

      </aside>

      <main class="content">
        {bare ? <slot /> : <div class="page"><slot /></div>}
      </main>
    </div>
  </body>
</html>
