---
import '../styles/global.css';
import SearchModal from '../components/SearchModal.astro';
import SidebarNav from '../components/SidebarNav.astro';
import AccessibilityToolbar from '../components/AccessibilityToolbar.astro';
import {
  absoluteUrl,
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  DEFAULT_TITLE,
  SITE_NAME,
  canonicalPathname,
  excerpt,
  normalizeSiteUrl,
  sitePath
} from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  ogType?: 'website' | 'article';
  pageType?: string | string[];
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonicalPath = Astro.url.pathname,
  image = DEFAULT_OG_IMAGE,
  ogType = 'website',
  pageType = 'WebPage',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  structuredData = []
} = Astro.props;

const siteUrl = normalizeSiteUrl(Astro.site);
const canonicalUrl = absoluteUrl(canonicalPathname(canonicalPath), siteUrl);
const imageUrl = absoluteUrl(image, siteUrl);
const metaDescription = excerpt(description, 158);
const websiteId = absoluteUrl('/#website', siteUrl);
const structuredDataItems = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLdItems = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    name: SITE_NAME,
    url: absoluteUrl('/', siteUrl),
    description: DEFAULT_DESCRIPTION,
    inLanguage: 'en-US',
    publisher: {
      '@type': 'Organization',
      name: SITE_NAME,
      url: absoluteUrl('/', siteUrl)
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': pageType,
    '@id': `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: title,
    description: metaDescription,
    isPartOf: { '@id': websiteId },
    inLanguage: 'en-US',
    about: {
      '@type': 'Thing',
      name: 'AWS Certified Solutions Architect - Associate SAA-C03'
    }
  },
  ...structuredDataItems
];

const serializeJsonLd = (item: Record<string, unknown>) =>
  JSON.stringify(item).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#050608" />
    <meta name="application-name" content={SITE_NAME} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={sitePath('/sitemap-index.xml')} />
    <link rel="icon" href={sitePath('/favicon.ico')} sizes="any" />
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={sitePath('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={imageUrl} />

    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={serializeJsonLd(item)}></script>
    ))}
  </head>
  <body>
    <!-- EXTREME LEFT-TO-RIGHT FULL-WIDTH NAVBAR -->
    <header class="navbar">
      <div class="nav-container">
        <div class="brand-group">
          <a href={sitePath('/')} class="brand">SAA-C03</a>
          <span class="brand-badge">[TACTICAL-DRILL]</span>
          <a href="https://github.com/atakang7/saaprep" class="mobile-star-link" target="_blank" rel="noopener noreferrer" aria-label="Star SAA Prep on GitHub">STAR</a>
        </div>
        <nav class="nav-links">
          <button id="search-btn" class="nav-item search-trigger">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span>SEARCH</span>
            <kbd class="nav-kbd">⌘K</kbd>
          </button>
          <a href="https://github.com/atakang7/saaprep" class="nav-item github-star" target="_blank" rel="noopener noreferrer" aria-label="Star SAA Prep on GitHub">STAR ON GITHUB</a>
          
          <!-- ACCESSIBILITY CONTROLS TOOLBAR -->
          <AccessibilityToolbar />

          <a href={sitePath('/practice')} class="nav-item">PRACTICE</a>
          <a href={sitePath('/services')} class="nav-item">SERVICES</a>
          <a href={sitePath('/concepts')} class="nav-item">TAXONOMY</a>
        </nav>
      </div>
    </header>

    <!-- EXTREME FULL-WIDTH LAYOUT CONTAINER -->
    <div class="app-layout">
      <!-- SIDEBAR AT EXTREME LEFT -->
      <SidebarNav />

      <!-- MAIN CONTENT AREA -->
      <main class="main-content">
        <slot />
      </main>
    </div>

    <!-- Command Palette Modal -->
    <SearchModal />

    <script>
      const searchBtn = document.getElementById('search-btn');
      searchBtn?.addEventListener('click', () => {
        window.dispatchEvent(new Event('open-search-modal'));
      });
    </script>
  </body>
</html>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: #050608;
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav-container {
    width: 100%;
    max-width: 100%;
    padding: 0.65rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand {
    font-weight: 900;
    font-size: 1.1rem;
    letter-spacing: 0;
    font-family: var(--font-mono);
    color: var(--text-primary);
    text-decoration: none;
  }

  .brand-badge {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-weight: 700;
  }

  .mobile-star-link {
    display: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-item {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-secondary);
    font-weight: 800;
    letter-spacing: 0;
    text-decoration: none;
  }

  .github-star {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    color: #8ee7c2;
    border: 1px solid rgba(142, 231, 194, 0.45);
    padding: 0.42rem 0.6rem;
    background: rgba(16, 185, 129, 0.08);
  }

  .search-trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    padding: 0.35rem 0.75rem;
    cursor: pointer;
    color: var(--text-secondary);
  }

  .nav-kbd {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    padding: 0.1rem 0.3rem;
    font-size: 0.6rem;
    font-family: var(--font-mono);
  }

  /* FULL-WIDTH FLUSH LAYOUT CONTAINER */
  .app-layout {
    display: flex;
    width: 100%;
    max-width: 100%;
    min-height: calc(100vh - 49px);
  }

  .main-content {
    flex-grow: 1;
    min-width: 0;
    padding: 1.4rem 2rem 2rem;
    max-width: 1720px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  @media (max-width: 1400px) {
    .main-content {
      padding: 1.2rem 1.5rem 1.75rem;
    }
  }

  @media (max-width: 900px) {
    .main-content {
      padding: 1rem 1rem 1.5rem;
    }
    .nav-container {
      padding: 0.65rem 1rem;
    }
  }

  @media (max-width: 640px) {
    .nav-container {
      gap: 0.65rem;
      padding: 0.55rem 0.75rem;
      overflow: hidden;
      position: relative;
    }
    .brand-group {
      min-width: 0;
      gap: 0.45rem;
      flex-shrink: 1;
    }
    .brand {
      font-size: 0.95rem;
      letter-spacing: 0;
      white-space: nowrap;
    }
    .mobile-star-link {
      display: inline-flex;
      align-items: center;
      color: #8ee7c2;
      border: 1px solid rgba(142, 231, 194, 0.45);
      padding: 0.3rem 0.45rem;
      background: rgba(16, 185, 129, 0.08);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 900;
      text-decoration: none;
      white-space: nowrap;
    }
    .brand-badge,
    .nav-item,
    .nav-kbd {
      display: none;
    }
    .nav-links {
      min-width: 0;
      flex-shrink: 0;
      gap: 0.4rem;
    }
    :global(.a11y-toolbar) {
      display: none;
    }
    .github-star {
      display: none;
    }
    .search-trigger {
      display: none;
      gap: 0.35rem;
      justify-content: center;
      width: 2.25rem;
      padding: 0.35rem;
      font-size: 0.75rem;
      white-space: nowrap;
    }
    .search-trigger span {
      display: none;
    }
  }
</style>
