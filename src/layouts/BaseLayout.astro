---
import "../styles/global.css";
import { totalQuestions, totalTopics } from "../lib/data";

interface Props {
  title: string;
  description?: string;
  /** If true, no nav bar is rendered (landing page). */
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={description ?? `AWS SAA-C03 explained topic by topic with ${totalQuestions.toLocaleString()} real practice questions across ${totalTopics} topics.`}
    />
    <title>{title} · SAA Prep</title>
    <!-- No external requests — system fonts only for instant load -->
  </head>
  <body>
    {!bare && (
      <nav class="site-nav">
        <div class="nav-inner">
          <a class="nav-brand" href="/">
            <span class="nav-brand-mark">S</span>
            <span>SAA Prep</span>
          </a>
          <div class="nav-links">
            <a href="/" aria-current={path === "/" ? "page" : undefined}>Home</a>
            <a href="/topics/" aria-current={path.startsWith("/topics") ? "page" : undefined}>Topics</a>
          </div>
        </div>
      </nav>
    )}

    <slot />

    <footer class="site-footer">
      <div class="page-container">
        <p>{totalQuestions.toLocaleString()} questions · {totalTopics} topics · Built for the SAA-C03</p>
      </div>
    </footer>
  </body>
</html>
