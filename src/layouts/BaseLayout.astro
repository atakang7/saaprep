---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "SAA-C03" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="AWS SAA-C03 Practice Platform" />
  </head>
  <body>
    <header class="navbar">
      <div class="nav-container">
        <a href="/" class="brand">SAA-C03</a>
        <nav class="nav-links">
          <button id="search-btn" class="nav-item search-trigger">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            Search (Cmd+K)
          </button>
          <a href="/practice" class="nav-item">Practice</a>
          <a href="/services" class="nav-item">Services</a>
          <a href="/concepts" class="nav-item">Taxonomy</a>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <!-- Fuzzy Search Modal -->
    <div id="search-modal" class="search-modal hidden">
      <div class="search-backdrop"></div>
      <div class="search-dialog">
        <div class="search-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-secondary)" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" id="search-input" placeholder="Search services, topics, keywords..." autocomplete="off" />
          <button id="search-close" class="close-btn">ESC</button>
        </div>
        <div class="search-results" id="search-results">
          <div class="search-empty">Type to start searching...</div>
        </div>
      </div>
    </div>

    <script>
      let searchIndex: any[] = [];
      let isLoaded = false;
      const modal = document.getElementById('search-modal');
      const input = document.getElementById('search-input') as HTMLInputElement;
      const resultsContainer = document.getElementById('search-results');
      const searchBtn = document.getElementById('search-btn');
      const closeBtn = document.getElementById('search-close');
      const backdrop = document.querySelector('.search-backdrop');

      async function fetchSearchIndex() {
        if (isLoaded) return;
        try {
          const res = await fetch('/api/search.json');
          searchIndex = await res.json();
          isLoaded = true;
        } catch (e) {
          console.error('Failed to load search index', e);
        }
      }

      function openSearch() {
        modal?.classList.remove('hidden');
        input?.focus();
        fetchSearchIndex();
      }

      function closeSearch() {
        modal?.classList.add('hidden');
        if (input) input.value = '';
        if (resultsContainer) resultsContainer.innerHTML = '<div class="search-empty">Type to start searching...</div>';
      }

      function performSearch(query: string) {
        if (!query.trim()) {
          if (resultsContainer) resultsContainer.innerHTML = '<div class="search-empty">Type to start searching...</div>';
          return;
        }
        
        const q = query.toLowerCase();
        
        // Very basic fuzzy logic: score items based on matches
        const scored = searchIndex.map(item => {
          let score = 0;
          if (item.title.toLowerCase() === q) score += 100;
          if (item.title.toLowerCase().includes(q)) score += 50;
          if (item.tags && item.tags.toLowerCase().includes(q)) score += 20;
          if (item.description.toLowerCase().includes(q)) score += 10;
          if (item.content.toLowerCase().includes(q)) score += 5;
          return { ...item, score };
        }).filter(item => item.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 8); // Top 8 results

        if (scored.length === 0) {
          if (resultsContainer) resultsContainer.innerHTML = '<div class="search-empty">No results found for "' + query + '"</div>';
          return;
        }

        let html = '';
        scored.forEach(item => {
          html += `
            <a href="${item.url}" class="search-result-item">
              <div class="sr-meta">
                <span class="sr-type">${item.type}</span>
                <span class="sr-tags">${item.tags || ''}</span>
              </div>
              <div class="sr-title">${item.title}</div>
              <div class="sr-desc">${item.description}</div>
            </a>
          `;
        });
        if (resultsContainer) resultsContainer.innerHTML = html;
      }

      searchBtn?.addEventListener('click', openSearch);
      closeBtn?.addEventListener('click', closeSearch);
      backdrop?.addEventListener('click', closeSearch);

      // Keyboard shortcuts
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          openSearch();
        }
        if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
          closeSearch();
        }
      });

      let timeout: any;
      input?.addEventListener('input', (e) => {
        clearTimeout(timeout);
        timeout = setTimeout(() => {
          performSearch((e.target as HTMLInputElement).value);
        }, 150); // debounce
      });
    </script>
  </body>
</html>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #030305;
    border-bottom: 1px solid var(--border-subtle);
  }
  .nav-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand {
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }
  .nav-links {
    display: flex;
    gap: 1.25rem;
  }
  .nav-item {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 600;
  }
  .nav-item:hover {
    color: var(--text-primary);
  }
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .search-trigger:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--color-network);
    color: var(--text-primary);
  }
  .main-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  /* Search Modal Styles */
  .search-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 10vh;
  }
  .search-modal.hidden {
    display: none;
  }
  .search-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(3, 3, 5, 0.8);
    backdrop-filter: blur(4px);
  }
  .search-dialog {
    position: relative;
    width: 100%;
    max-width: 650px;
    background: var(--bg-card);
    border: 1px solid var(--border-glow);
    border-radius: 12px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .search-header {
    display: flex;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
    gap: 1rem;
  }
  #search-input {
    flex-grow: 1;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-size: 1.15rem;
    outline: none;
  }
  #search-input::placeholder {
    color: var(--text-muted);
  }
  .close-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
  }
  .search-results {
    max-height: 60vh;
    overflow-y: auto;
    padding: 1rem;
  }
  .search-empty {
    text-align: center;
    padding: 2rem;
    color: var(--text-muted);
    font-style: italic;
  }
  .search-result-item {
    display: block;
    padding: 1rem;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
    border: 1px solid transparent;
  }
  .search-result-item:hover, .search-result-item:focus {
    background: #1a1e2b;
    border-color: var(--border-subtle);
    outline: none;
  }
  .sr-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }
  .sr-type {
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--color-network);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .sr-tags {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .sr-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }
  .sr-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
