---
import '../styles/global.css';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title?: string;
}

const { title = "SAA-C03" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="AWS SAA-C03 Practice Platform" />
  </head>
  <body>
    <header class="navbar">
      <div class="nav-container">
        <a href="/" class="brand">SAA-C03</a>
        <nav class="nav-links">
          <button id="search-btn" class="nav-item search-trigger">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span>Search</span>
            <kbd class="nav-kbd">⌘K</kbd>
          </button>
          <a href="/practice" class="nav-item">Practice</a>
          <a href="/services" class="nav-item">Services</a>
          <a href="/concepts" class="nav-item">Taxonomy</a>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <!-- Raycast/Spotlight Command Palette -->
    <SearchModal />

    <script>
      const searchBtn = document.getElementById('search-btn');
      searchBtn?.addEventListener('click', () => {
        window.dispatchEvent(new Event('open-search-modal'));
      });
    </script>
  </body>
</html>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(3, 3, 5, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }
  .nav-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand {
    font-weight: 900;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    background: var(--gradient-unicorn);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .nav-item {
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-weight: 600;
    transition: color 0.2s;
  }
  .nav-item:hover {
    color: var(--text-primary);
  }
  .search-trigger {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .search-trigger:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--color-network);
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.2);
    color: var(--text-primary);
  }
  .nav-kbd {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-size: 0.65rem;
    font-family: var(--font-mono);
  }
  .main-content {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
</style>
