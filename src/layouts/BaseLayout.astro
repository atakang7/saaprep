---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "SAA-C03" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="AWS SAA-C03 Practice Platform" />
  </head>
  <body>
    <header class="navbar">
      <div class="nav-container">
        <a href="/" class="brand">SAA-C03</a>
        <nav class="nav-links">
          <a href="/" class="nav-item">Practice</a>
          <a href="/concepts" class="nav-item">Taxonomy</a>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>
  </body>
</html>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #030305;
    border-bottom: 1px solid var(--border-subtle);
  }
  .nav-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand {
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }
  .nav-links {
    display: flex;
    gap: 1.25rem;
  }
  .nav-item {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 600;
  }
  .nav-item:hover {
    color: var(--text-primary);
  }
  .main-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
</style>
